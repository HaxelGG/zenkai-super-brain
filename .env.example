# ZENKAI · plantilla de variables de entorno
# ⚠️ NUNCA commitear .env con valores reales — solo .env.example
# Copiar este archivo a .env (en gitignore) y rellenar con tus valores reales

# ====== ANTHROPIC CLAUDE API ======
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXX

# ====== DEEPSEEK · cerebro JARVIS (voz, Telegram, /api/jarvis/run) ======
# Obtener en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-XXXXXXXX
DEEPSEEK_MODEL=deepseek-chat
# deepseek (default si hay DEEPSEEK_API_KEY) · off · clasificar · anthropic
JARVIS_LLM_PROVIDER=deepseek

# Modelos a usar (referencia · no son secretos)
CLAUDE_MODEL_OPUS=claude-opus-4-7
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001

# ====== GEMINI ======
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXX

# ====== AIRTABLE ======
# Obtener token en: https://airtable.com/create/tokens (Personal Access Token)
# Recomendado: scopes data.records:read+write + schema.bases:read · access "All current and future bases"
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX

# Bases INTERNAS (Capa 1 · ZENKAI ops) · 7 totales · §5 CLAUDE.md
# 3 creadas en Fase 2.2 (VENTAS · LEGAL · FINANZAS) · 4 JIT cuando la operación las pida
AIRTABLE_BASE_VENTAS=appXXXXXXXXXXXXX
AIRTABLE_BASE_LEGAL=appXXXXXXXXXXXXX
AIRTABLE_BASE_FINANZAS=appXXXXXXXXXXXXX
# AIRTABLE_BASE_OPERACIONES=appXXXXXXXXXXXXX  # crear cuando haya primer cliente
# AIRTABLE_BASE_MARKETING=appXXXXXXXXXXXXX    # crear cuando ARES esté en producción
# AIRTABLE_BASE_SOPORTE=appXXXXXXXXXXXXX      # crear cuando ECHO esté en producción
# AIRTABLE_BASE_EQUIPO=appXXXXXXXXXXXXX       # crear cuando el equipo > 2 personas

# Bases SECTOR TEMPLATES (Capa 2 · schemas por vertical · clonar para cada cliente)
AIRTABLE_BASE_SALUD=appXXXXXXXXXXXXX
AIRTABLE_BASE_FOOD=appXXXXXXXXXXXXX
AIRTABLE_BASE_ECOMMERCE=appXXXXXXXXXXXXX
AIRTABLE_BASE_SERVICIOS=appXXXXXXXXXXXXX
AIRTABLE_BASE_EDUCACION=appXXXXXXXXXXXXX
AIRTABLE_BASE_INMOBILIARIA=appXXXXXXXXXXXXX
# AIRTABLE_BASE_MANUFACTURA=appXXXXXXXXXXXXX  # pendiente (no creada todavía)
# AIRTABLE_BASE_RETAIL=appXXXXXXXXXXXXX        # pendiente
# AIRTABLE_BASE_STARTUPS=appXXXXXXXXXXXXX      # pendiente
# AIRTABLE_BASE_GOBIERNO=appXXXXXXXXXXXXX      # pendiente
# AIRTABLE_BASE_ONG=appXXXXXXXXXXXXX           # pendiente

