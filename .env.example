# ====== ZENKAI INTERNO ======
ZENKAI_DOMAIN=zenkai.co
ZENKAI_CONTACT_EMAIL=contacto@zenkai.co
ZENKAI_WHATSAPP_NUMBER=+5731XXXXXXX

# Bearer token compartido para autenticar requests a /api/clasificar y /api/protocolo
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Configurar también en Vercel · Settings · Environment Variables
ZENKAI_API_KEY=generado-con-crypto-randomBytes-32-base64url

# ====== WINDMILL · AUTOMATIZACIÓN (alternativa/complemento n8n) ======
# Cloud: https://app.windmill.dev · workspace: zenkai
# MCP (Cursor): Account settings → Tokens → Generate MCP URL (scope mcp:all)
WINDMILL_MCP_URL=https://app.windmill.dev/api/mcp/w/zenkai/mcp?token=
# CLI sync (wmill sync pull): token API distinto al MCP · scope workspace
WINDMILL_API_TOKEN=
WINDMILL_BASE_URL=https://app.windmill.dev
WINDMILL_WORKSPACE=zenkai

# ====== N8N · AUTOMATIZACIÓN ======
# Cloud: https://zenkai-growth-systems.app.n8n.cloud
# Exports Sprint 1: jarvis/n8n/
N8N_BASE_URL=https://zenkai-growth-systems.app.n8n.cloud
N8N_WEBHOOK_URL=https://zenkai-growth-systems.app.n8n.cloud/webhook/<path>
N8N_JARVIS_CALLBACK_URL=https://zenkai-growth-systems.app.n8n.cloud/webhook/jarvis-callback
# Settings → n8n API → Create API Key (scopes: variable:list, variable:create, variable:update)
# npm run n8n:import -- --apply  ·  npm run n8n:vars -- --apply
N8N_API_KEY=
# Settings → Instance-level MCP → Access Token · Cursor MCP (regenerar si 401)
N8N_MCP_ACCESS_TOKEN=
# Variables también en n8n Cloud Settings → Variables:
# AIRTABLE_BASE_VENTAS · ZENKAI_FROM_EMAIL · ZENKAI_ALERT_EMAIL · SLACK_WEBHOOK_URL

# Email comercial (Resend + n8n M-02/M-04)
ZENKAI_FROM_EMAIL=ZENKAI <hola@zenkai.systems>
ZENKAI_ALERT_EMAIL=hola@zenkai.systems
SLACK_WEBHOOK_URL=

# JARVIS · voz ElevenLabs (POST /api/jarvis/speak)
# Voz default: JARVIS-ZENKAI · ver jarvis/voice/samples/jarvis-voice-id.json
ELEVENLABS_API_KEY=
# Preferido en Vercel zenkaibrain · fallback a ELEVENLABS_VOICE_ID
ELEVENLABS_JARVIS_VOICE_ID=FqHzPCWiAfnd8t6A5LN4
ELEVENLABS_VOICE_ID=FqHzPCWiAfnd8t6A5LN4
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
