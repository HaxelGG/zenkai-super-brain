# Variables de entorno del panel ZENKAI.
# Copia este archivo a .env (gitignored) y rellena los valores.

# Token de Airtable (Personal Access Token) con scope data.records:read
# sobre la base "ZENKAI — CRM Ventas". Sin esto, el panel muestra los
# placeholders "🔌 conecta Airtable" — el build NO falla.
# En producción se configura como env var del proyecto Vercel `zenkaibrain`.
AIRTABLE_TOKEN=
