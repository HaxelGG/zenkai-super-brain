---
import { resolveJarvisRoutes } from "../../lib/jarvis/config";
import JarvisNavList from "./JarvisNavList.astro";
import JarvisWordmark from "./JarvisWordmark.astro";

const routes = resolveJarvisRoutes(Astro.url.hostname);
const path = Astro.url.pathname;
---

<aside class="jarvis-sidebar hidden lg:flex flex-col shrink-0 border-r min-h-screen overflow-hidden">
  <div class="jv-brand-block shrink-0">
    <JarvisWordmark href={routes.home} size="lg" />
    <div class="jv-brand-meta">
      <span class="jv-brand-badge">
        <span class="jarvis-status-dot" aria-hidden="true"></span>
        Command Center
      </span>
      <span class="jv-brand-version">v3.1</span>
    </div>
  </div>

  <nav class="flex-1 min-h-0 overflow-y-auto px-2 py-2">
    <JarvisNavList path={path} />
  </nav>

  <div class="jv-sidebar-footer shrink-0">
    <div class="jv-sidebar-footer-label">ZENKAI Growth Systems</div>
    <div class="jv-sidebar-footer-sub">Pereira · Colombia</div>
  </div>
</aside>
