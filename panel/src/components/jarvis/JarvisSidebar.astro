---
import { JARVIS_BASE, JARVIS_NAV, JARVIS_ROUTES, PANEL_URL } from "../../lib/jarvis/config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === JARVIS_BASE ? path === JARVIS_BASE || path === `${JARVIS_BASE}/` : path.startsWith(href);

const icons: Record<string, string> = {
  home: "M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1V9.5z",
  agents: "M12 2a4 4 0 014 4v1h2a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h2V6a4 4 0 014-4z",
  pipeline: "M3 3v18h18M7 16l4-8 4 5 5-9",
  clients: "M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75",
  finance: "M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6",
  social: "M7 8h10M7 12h4m-4 4h7M5 4h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z",
  tasks: "M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11",
  systems: "M12 2l3 7h7l-5.5 4.5 2 7L12 17l-6.5 3.5 2-7L2 9h7l3-7z",
  goals: "M12 2l2.4 7.4H22l-6 4.6 2.3 7L12 17.8 5.7 21l2.3-7-6-4.6h7.6L12 2z",
  intel: "M12 2a10 10 0 100 20 10 10 0 000-20zm0 4v8l5 3",
};
---

<aside class="jarvis-sidebar hidden lg:flex flex-col w-60 shrink-0 border-r">
  <div class="p-5 border-b border-[var(--jv-border)]">
    <a href={JARVIS_ROUTES.home} class="flex items-center gap-3 no-underline group">
      <div class="arc-reactor arc-reactor-lg shrink-0" aria-hidden="true"></div>
      <div>
        <div class="jv-display text-sm font-bold text-[var(--jv-cyan)] group-hover:text-white transition-colors">JARVIS</div>
        <div class="jv-mono text-[9px] text-[var(--jv-text-dim)] mt-0.5">JUST A RATHER VERY INTELLIGENT SYSTEM</div>
      </div>
    </a>
  </div>

  <nav class="flex-1 p-3 space-y-0.5 overflow-y-auto">
    {JARVIS_NAV.map((item) => (
      <a
        href={item.href}
        class:list={[
          "jv-nav-item flex items-center gap-2.5 px-3 py-2 rounded-sm text-[13px] no-underline transition-all duration-300",
          isActive(item.href) ? "jv-nav-active font-medium" : "text-[var(--jv-text-muted)]",
        ]}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={icons[item.icon]} />
        </svg>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="p-3 border-t border-[var(--jv-border)]">
    <a
      href={PANEL_URL}
      class="jv-nav-item flex items-center gap-2 px-3 py-2 rounded-sm text-[13px] text-[var(--jv-text-muted)] no-underline transition-colors"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      Super Cerebro
    </a>
  </div>
</aside>
