---
import {
  JARVIS_DEPARTMENTS,
  navLabel,
  type JarvisDepartment,
} from "../../lib/jarvis/departments";
import {
  PANEL_URL,
  isJarvisNavActive,
  resolveJarvisRoutes,
  type JarvisRouteKey,
} from "../../lib/jarvis/config";

interface Props {
  path: string;
  itemPadding?: string;
}

const { path, itemPadding = "px-2.5 py-1.5" } = Astro.props;
const routes = resolveJarvisRoutes(Astro.url.hostname);

const icons: Record<string, string> = {
  home: "M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1V9.5z",
  agents: "M12 2a4 4 0 014 4v1h2a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V9a2 2 0 012-2h2V6a4 4 0 014-4z",
  pipeline: "M3 3v18h18M7 16l4-8 4 5 5-9",
  clients: "M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75",
  finance: "M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6",
  social: "M7 8h10M7 12h4m-4 4h7M5 4h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z",
  tasks: "M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11",
  systems: "M12 2l3 7h7l-5.5 4.5 2 7L12 17l-6.5 3.5 2-7L2 9h7l3-7z",
  goals: "M12 2l2.4 7.4H22l-6 4.6 2.3 7L12 17.8 5.7 21l2.3-7-6-4.6h7.6L12 2z",
  intel: "M12 2a10 10 0 100 20 10 10 0 000-20zm0 4v8l5 3",
  panel: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z",
};

function iconFor(key: JarvisRouteKey): string {
  if (key === "home") return icons.home;
  if (key === "pipeline" || key === "finanzas" || key === "sales") return icons.pipeline;
  if (key === "clientes" || key === "customer-service") return icons.clients;
  if (key === "social" || key === "marketing" || key === "creation") return icons.social;
  if (key === "tareas" || key === "jobs") return icons.tasks;
  if (key === "agentes" || key === "ai") return icons.agents;
  if (key === "sistemas") return icons.systems;
  if (key === "intel" || key === "research") return icons.intel;
  if (key === "goals") return icons.goals;
  return icons.systems;
}

function deptHubHref(dept: JarvisDepartment): string {
  return routes[dept.id as JarvisRouteKey];
}

function isDeptActive(dept: JarvisDepartment): boolean {
  const hub = deptHubHref(dept);
  if (isJarvisNavActive(path, hub)) return true;
  return dept.items.some((item) => isJarvisNavActive(path, routes[item.key]));
}
---

<div class="space-y-4">
  <a
    href={routes.home}
    class:list={[
      "jv-nav-item flex items-center gap-2 rounded-sm text-[var(--jv-text-sm)] no-underline transition-colors duration-200",
      itemPadding,
      isJarvisNavActive(path, routes.home) ? "jv-nav-active font-medium" : "text-[var(--jv-text-muted)]",
    ]}
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={icons.home} />
    </svg>
    Command Center
  </a>

  {JARVIS_DEPARTMENTS.map((dept) => (
    <div class="jv-dept-nav-group" style={`--jv-dept-accent: ${dept.accent}`}>
      <a
        href={deptHubHref(dept)}
        class:list={[
          "jv-dept-nav-head no-underline",
          isDeptActive(dept) && "jv-dept-nav-head-active",
        ]}
      >
        {dept.label}
      </a>
      <div class="space-y-0.5 mt-1">
        {dept.items.map((item) => {
          const href = routes[item.key];
          const label = navLabel(item.key, item.label);
          return (
            <a
              href={href}
              class:list={[
                "jv-nav-item flex items-center gap-2 rounded-sm text-[var(--jv-text-sm)] no-underline transition-colors duration-200",
                itemPadding,
                "pl-3",
                isJarvisNavActive(path, href) ? "jv-nav-active font-medium" : "text-[var(--jv-text-muted)]",
              ]}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={iconFor(item.key)} />
              </svg>
              {label}
            </a>
          );
        })}
      </div>
    </div>
  ))}

  <div class="jv-nav-divider" role="separator" aria-hidden="true"></div>

  <a
    href={PANEL_URL}
    class:list={[
      "jv-nav-item jv-nav-panel flex items-center gap-2 rounded-sm text-[var(--jv-text-sm)] no-underline transition-colors duration-200 text-[var(--jv-text-dim)]",
      itemPadding,
    ]}
    title="Panel interno ZENKAI"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={icons.panel} />
    </svg>
    Super Cerebro
  </a>
</div>
