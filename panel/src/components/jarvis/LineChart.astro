---
interface Props {
  title?: string;
  series: { label: string; actual?: number; projected?: number }[];
  height?: number;
}

const { title, series, height = 180 } = Astro.props;

const maxVal = Math.max(...series.flatMap((s) => [s.actual ?? 0, s.projected ?? 0]), 1);
const step = 36;
const chartW = series.length * step + 20;
const chartH = height - 36;
const baseline = chartH + 8;

function y(val: number): number {
  return baseline - (val / maxVal) * (chartH - 10);
}
---

<div class="jv-chart">
  {title && <h3 class="jv-label text-[10px] mb-3 opacity-80">{title}</h3>}
  <svg width="100%" viewBox={`0 0 ${chartW} ${height}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={title}>
    <line x1="10" y1={baseline} x2={chartW - 10} y2={baseline} stroke="rgba(0,212,255,0.15)" stroke-width="1" />
    {series.map((s, i) => {
      const x = 16 + i * step;
      const hasActual = s.actual !== undefined && s.actual > 0;
      return (
        <g>
          {s.projected !== undefined && s.projected > 0 && (
            <circle cx={x} cy={y(s.projected)} r="3" fill="none" stroke="#1E6FFF" stroke-width="1.5" opacity="0.4" />
          )}
          {hasActual && (
            <>
              {i > 0 && series[i - 1].actual !== undefined && series[i - 1].actual! > 0 && (
                <line x1={16 + (i - 1) * step} y1={y(series[i - 1].actual!)} x2={x} y2={y(s.actual!)} stroke="#00D4FF" stroke-width="2" stroke-linecap="round" opacity="0.9" />
              )}
              <circle cx={x} cy={y(s.actual!)} r="4" fill="#00D4FF" filter="url(#jv-glow)" />
            </>
          )}
          <text x={x} y={height - 6} text-anchor="middle" font-size="8" fill="#6B8CAE" font-family="JetBrains Mono, monospace">{s.label}</text>
        </g>
      );
    })}
    <defs>
      <filter id="jv-glow"><feGaussianBlur stdDeviation="1.5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    </defs>
  </svg>
  <div class="flex gap-4 mt-2 jv-mono text-[10px] text-[var(--jv-text-dim)]">
    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-[#00D4FF]" /> Actual</span>
    <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full border border-[#1E6FFF]" /> Proyección</span>
  </div>
</div>
