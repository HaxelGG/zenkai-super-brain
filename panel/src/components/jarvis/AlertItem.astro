---
import type { Alert } from "../../lib/jarvis/types";

interface Props {
  alert: Alert;
}

const { alert } = Astro.props;

const styles = {
  critical: "jv-alert-critical",
  important: "jv-alert-important",
  info: "jv-alert-info",
};
---

<div class:list={["pl-3 pr-4 py-2.5 border-l-2 rounded-r-sm text-[13px]", styles[alert.level]]}>
  <p class="text-[var(--jv-text)] leading-snug">{alert.message}</p>
  {alert.action && (
    <span class="mt-1 inline-block jv-mono text-[10px] text-[var(--jv-cyan)] cursor-pointer hover:underline">{alert.action} →</span>
  )}
</div>
