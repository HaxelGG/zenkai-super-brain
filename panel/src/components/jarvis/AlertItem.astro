---
import type { Alert } from "../../lib/jarvis/types";

interface Props {
  alert: Alert;
}

const { alert } = Astro.props;

const styles = {
  critical: "border-l-danger bg-red-50/50",
  important: "border-l-warning bg-amber-50/50",
  info: "border-l-accent bg-accent-soft/30",
};

const icons = {
  critical: "🔴",
  important: "🟡",
  info: "ℹ️",
};
---

<div class:list={["jarvis-alert pl-3 pr-4 py-2.5 border-l-[3px] rounded-r-card text-small", styles[alert.level]]}>
  <div class="flex items-start gap-2">
    <span aria-hidden="true">{icons[alert.level]}</span>
    <div class="flex-1 min-w-0">
      <p class="text-text leading-snug">{alert.message}</p>
      {alert.action && (
        <button type="button" class="mt-1 text-micro text-accent font-medium hover:underline">
          {alert.action} →
        </button>
      )}
    </div>
  </div>
</div>
