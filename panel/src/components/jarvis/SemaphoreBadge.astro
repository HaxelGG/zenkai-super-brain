---
import type { Semaphore } from "../../lib/jarvis/types";

interface Props {
  status: Semaphore;
  label?: string;
  size?: "sm" | "md";
}

const { status, label, size = "md" } = Astro.props;

const config = {
  green: { color: "var(--jv-success)", text: "Operativo" },
  yellow: { color: "var(--jv-warning)", text: "Atención" },
  red: { color: "var(--jv-danger)", text: "Crítico" },
}[status];
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-sm border font-medium jv-mono",
    size === "sm" ? "px-2 py-0.5 text-[10px]" : "px-3 py-1 text-[11px]",
  ]}
  style={`border-color: ${config.color}; color: ${config.color}; background: color-mix(in srgb, ${config.color} 10%, transparent)`}
>
  <span class="w-1.5 h-1.5 rounded-full animate-pulse" style={`background: ${config.color}; box-shadow: 0 0 6px ${config.color}`} />
  {label ?? config.text}
</span>
