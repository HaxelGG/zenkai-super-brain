---
import type { KpiMetric } from "../../lib/jarvis/types";

interface Props {
  metric: KpiMetric;
  index?: number;
  socialData?: string;
}

const { metric, index = 0, socialData } = Astro.props;

const liveKeys: Record<string, string> = {
  "revenue-ytd": "revenue-ytd",
  pipeline: "pipeline-weighted",
  "leads-week": "leads-count",
  clients: "clients-count",
  "conversion-rate": "conversion-rate",
  "deals-total": "deals-total",
  "run-rate": "run-rate",
  capacity: "capacity-pct",
  roas: "roas",
  "engagement-ig": "ig-engagement",
};
const liveKey = liveKeys[metric.id];

const deltaColors = {
  up: "text-[var(--jv-success)]",
  down: "text-[var(--jv-danger)]",
  flat: "text-[var(--jv-text-dim)]",
};

function sparklinePath(values: number[], w: number, h: number): string {
  if (values.length < 2) return "";
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const step = w / (values.length - 1);
  return values
    .map((v, i) => {
      const x = i * step;
      const y = h - ((v - min) / range) * (h - 4) - 2;
      return `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}
---

<div class="jv-metric p-3 sm:p-3.5 relative overflow-hidden" data-jv-animate={String((index % 8) + 1)}>
  <div class="jv-label mb-1.5">{metric.label}</div>
  <div class="flex items-end justify-between gap-2 min-h-[1.75rem]">
    {metric.value === "—" ? (
      <span class="jv-metric-empty" data-jv-live={liveKey} data-jv-social={socialData}>Sin dato</span>
    ) : (
      <div
        class="jv-metric-value"
        data-count-up={metric.value}
        data-jv-live={liveKey}
        data-jv-social={socialData}
      >
        {metric.value}
      </div>
    )}
    {metric.sparkline && metric.sparkline.length > 1 && metric.value !== "—" && (
      <svg width="52" height="22" viewBox="0 0 52 22" class="shrink-0 opacity-50" aria-hidden="true">
        <path d={sparklinePath(metric.sparkline, 52, 22)} fill="none" stroke="#00D4FF" stroke-width="1.25" stroke-linecap="round" />
      </svg>
    )}
  </div>
  <div class="mt-1.5 flex items-center justify-between gap-2">
    {metric.caption && <span class="jv-mono text-[var(--jv-text-2xs)] text-[var(--jv-text-dim)] leading-tight">{metric.caption}</span>}
    {metric.delta && (
      <span class:list={["jv-mono text-[10px] font-medium", deltaColors[metric.delta.direction]]}>
        {metric.delta.direction === "up" ? "▲" : metric.delta.direction === "down" ? "▼" : "→"}
        {metric.delta.value}{metric.delta.label.includes("pp") ? "pp" : "%"}
      </span>
    )}
  </div>
</div>
