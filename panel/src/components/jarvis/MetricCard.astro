---
import type { KpiMetric } from "../../lib/jarvis/types";

interface Props {
  metric: KpiMetric;
  index?: number;
}

const { metric, index = 0 } = Astro.props;

const deltaColors = {
  up: "text-[var(--jv-success)]",
  down: "text-[var(--jv-danger)]",
  flat: "text-[var(--jv-text-dim)]",
};

function sparklinePath(values: number[], w: number, h: number): string {
  if (values.length < 2) return "";
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const step = w / (values.length - 1);
  return values
    .map((v, i) => {
      const x = i * step;
      const y = h - ((v - min) / range) * (h - 4) - 2;
      return `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}
---

<div class="jv-metric p-4 sm:p-5 relative overflow-hidden" data-jv-animate={String((index % 8) + 1)}>
  <div class="jv-label mb-2">{metric.label}</div>
  <div class="flex items-end justify-between gap-2">
    <div class="jv-metric-value" data-count-up={metric.value}>{metric.value}</div>
    {metric.sparkline && metric.sparkline.length > 1 && (
      <svg width="64" height="28" viewBox="0 0 64 28" class="shrink-0 opacity-70" aria-hidden="true">
        <path d={sparklinePath(metric.sparkline, 64, 28)} fill="none" stroke="#00D4FF" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    )}
  </div>
  <div class="mt-2 flex items-center justify-between gap-2">
    {metric.caption && <span class="jv-mono text-[10px] text-[var(--jv-text-dim)]">{metric.caption}</span>}
    {metric.delta && (
      <span class:list={["jv-mono text-[10px] font-medium", deltaColors[metric.delta.direction]]}>
        {metric.delta.direction === "up" ? "▲" : metric.delta.direction === "down" ? "▼" : "→"}
        {metric.delta.value}{metric.delta.label.includes("pp") ? "pp" : "%"}
      </span>
    )}
  </div>
</div>
