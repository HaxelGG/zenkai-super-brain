---
import type { Task, TaskStatus } from "../../lib/jarvis/types";
import TaskCard from "./TaskCard.astro";

interface Props {
  status: TaskStatus;
  tasks: Task[];
  label: string;
}

const { status, tasks, label } = Astro.props;
const filtered = tasks.filter((t) => t.status === status);
---

<div class="jarvis-kanban-col flex flex-col min-h-[200px]">
  <div class="flex items-center justify-between mb-3 px-1">
    <h3 class="text-small font-semibold text-text">{label}</h3>
    <span class="text-micro text-text-faint bg-bg-muted px-2 py-0.5 rounded-full">{filtered.length}</span>
  </div>
  <div class="space-y-2 flex-1">
    {filtered.length === 0 ? (
      <div class="text-micro text-text-faint text-center py-6 border border-dashed border-border rounded-card">
        Sin tareas
      </div>
    ) : (
      filtered.map((task) => <TaskCard task={task} compact />)
    )}
  </div>
</div>
