---
interface Props {
  class?: string;
  animate?: number;
  padding?: "sm" | "md" | "lg";
}

const { class: className, animate, padding = "md" } = Astro.props;

const pad = { sm: "p-3", md: "p-4", lg: "p-5" }[padding];
---

<div
  class:list={["hud-panel", pad, className]}
  {...(animate !== undefined ? { "data-jv-animate": String(animate) } : {})}
>
  <div class="hud-panel-inner">
    <slot />
  </div>
</div>
