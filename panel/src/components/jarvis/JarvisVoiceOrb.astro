---
/** Orb compacto en header — feedback visual idle / escucha / procesando / habla */
---

<div class="jv-voice-widget" id="jv-voice" data-state="idle">
  <button type="button" class="jv-voice-trigger" id="jv-voice-btn" aria-pressed="false" aria-label="Activar JARVIS por voz" title="Clic: activar voz · Doble clic: hablar · Mantener: panel">
    <span class="jv-voice-orb" aria-hidden="true">
      <span class="jv-voice-ring jv-voice-ring-1"></span>
      <span class="jv-voice-ring jv-voice-ring-2"></span>
      <span class="jv-voice-core"></span>
    </span>
    <span class="jv-voice-bars" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </span>
  </button>
  <button type="button" class="jv-voice-settings-btn" id="jv-voice-settings" aria-label="Abrir panel de voz JARVIS" title="Panel de voz">⋯</button>
  <span class="jv-voice-status jv-mono" id="jv-voice-status">En línea</span>
</div>
