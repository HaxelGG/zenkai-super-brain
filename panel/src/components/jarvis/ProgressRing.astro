---
interface Props {
  current: number;
  target: number;
  label?: string;
  format?: "usd" | "percent" | "count";
}

const { current, target, label = "Meta 2026", format = "usd" } = Astro.props;

const pct = Math.min(100, Math.round((current / target) * 100));
const circumference = 2 * Math.PI * 42;
const offset = circumference - (pct / 100) * circumference;

function formatValue(n: number): string {
  if (format === "usd") return `$${(n / 1000).toFixed(1)}K`;
  if (format === "percent") return `${n}%`;
  return String(n);
}
---

<div class="flex items-center gap-5" data-jv-animate="2">
  <div class="relative w-[110px] h-[110px] shrink-0">
    <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90">
      <circle cx="50" cy="50" r="42" fill="none" class="jv-ring-track" stroke-width="6" />
      <circle
        cx="50" cy="50" r="42" fill="none" class="jv-ring-fill"
        stroke-width="6" stroke-linecap="round"
        stroke-dasharray={circumference} stroke-dashoffset={offset}
        style="transition: stroke-dashoffset 1.2s cubic-bezier(0.4,0,0.2,1)"
      />
      <defs>
        <linearGradient id="jv-ring-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#1E6FFF" />
          <stop offset="100%" stop-color="#00D4FF" />
        </linearGradient>
      </defs>
    </svg>
    <div class="absolute inset-0 flex flex-col items-center justify-center">
      <span class="jv-display text-xl font-bold text-[var(--jv-cyan)]" data-count-up={String(pct)}>{pct}%</span>
    </div>
  </div>
  <div>
    <div class="jv-label">{label}</div>
    <div class="jv-display text-2xl font-bold mt-1 text-[var(--jv-text)]" data-count-up={formatValue(current)}>{formatValue(current)}</div>
    <div class="jv-mono text-[11px] text-[var(--jv-text-muted)] mt-1">de {format === "usd" ? "$100K USD" : formatValue(target)}</div>
  </div>
</div>
