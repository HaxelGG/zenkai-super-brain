---
import type { SocialChannel } from "../../lib/jarvis/types";

interface Props {
  channel: SocialChannel;
}

const { channel } = Astro.props;

const platformIcons: Record<string, { bg: string; label: string }> = {
  instagram: { bg: "from-pink-500/80 to-purple-600/80", label: "IG" },
  linkedin: { bg: "from-blue-600/80 to-blue-700/80", label: "IN" },
  tiktok: { bg: "from-gray-700/80 to-gray-900/80", label: "TT" },
  meta_ads: { bg: "from-blue-500/80 to-cyan-500/80", label: "AD" },
};

const icon = platformIcons[channel.platform];

function sparklinePath(values: number[], w: number, h: number): string {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const step = w / (values.length - 1);
  return values.map((v, i) => {
    const x = i * step;
    const y = h - ((v - min) / range) * (h - 4) - 2;
    return `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(" ");
}

function formatReach(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}K`;
  return String(n);
}
---

<div class="p-2.5 border border-[var(--jv-border)] rounded-sm hover:border-[var(--jv-border-bright)] transition-all duration-200">
  <div class="flex items-center justify-between mb-1.5">
    <div class="flex items-center gap-2">
      <div class:list={["w-6 h-6 rounded-sm bg-gradient-to-br flex items-center justify-center text-white jv-display text-[8px] font-bold", icon.bg]}>
        {icon.label}
      </div>
      <span class="text-[var(--jv-text-sm)] font-medium">{channel.label}</span>
    </div>
    {channel.delta && (
      <span class="jv-mono text-[var(--jv-text-2xs)] text-[var(--jv-success)]">
        ▲ {channel.delta.value}{channel.platform === "meta_ads" ? "x" : "%"}
      </span>
    )}
  </div>
  <div class="grid grid-cols-2 gap-2 mb-1.5">
    <div>
      <div class="jv-label opacity-60">{channel.metricLabel}</div>
      <div
        class="jv-mono text-[var(--jv-text-sm)] font-semibold text-[var(--jv-cyan)]"
        data-jv-social={channel.platform === "instagram" ? "ig-reach" : channel.platform === "meta_ads" ? "roas" : undefined}
      >
        {channel.platform === "meta_ads" ? `${channel.engagement}x` : formatReach(channel.reach)}
      </div>
    </div>
    <div>
      <div class="jv-label opacity-60">{channel.secondaryLabel}</div>
      <div
        class="jv-mono text-[var(--jv-text-sm)] font-semibold"
        data-jv-social={channel.platform === "instagram" ? "ig-engagement" : channel.platform === "meta_ads" ? "spend" : undefined}
      >
        {channel.secondaryValue}
      </div>
    </div>
  </div>
  <svg width="100%" height="22" viewBox="0 0 120 22" preserveAspectRatio="none" aria-hidden="true">
    <path d={sparklinePath(channel.trend, 120, 22)} fill="none" stroke="#00D4FF" stroke-width="1.25" stroke-linecap="round" opacity="0.6" />
  </svg>
</div>
