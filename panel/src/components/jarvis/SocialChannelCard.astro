---
import type { SocialChannel } from "../../lib/jarvis/types";

interface Props {
  channel: SocialChannel;
}

const { channel } = Astro.props;

const platformIcons: Record<string, { bg: string; label: string }> = {
  instagram: { bg: "from-pink-500 to-purple-600", label: "IG" },
  linkedin: { bg: "from-blue-600 to-blue-700", label: "IN" },
  tiktok: { bg: "from-gray-900 to-gray-800", label: "TT" },
  meta_ads: { bg: "from-blue-500 to-indigo-600", label: "AD" },
};

const icon = platformIcons[channel.platform];

function sparklinePath(values: number[], w: number, h: number): string {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const step = w / (values.length - 1);
  return values
    .map((v, i) => {
      const x = i * step;
      const y = h - ((v - min) / range) * (h - 4) - 2;
      return `${i === 0 ? "M" : "L"}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}

function formatReach(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}K`;
  return String(n);
}
---

<div class="jarvis-social-card card-base p-4 hover:shadow-sm transition-shadow">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <div class:list={["w-8 h-8 rounded-lg bg-gradient-to-br flex items-center justify-center text-white text-micro font-bold", icon.bg]}>
        {icon.label}
      </div>
      <span class="text-small font-semibold">{channel.label}</span>
    </div>
    <span class="text-micro text-success font-medium">
      ↑ {channel.delta.value}{channel.platform === "meta_ads" ? "x" : "%"}
    </span>
  </div>
  <div class="grid grid-cols-2 gap-3 mb-3">
    <div>
      <div class="label-micro">{channel.metricLabel}</div>
      <div class="text-h3 font-mono mt-0.5">
        {channel.platform === "meta_ads" ? `${channel.engagement}x` : formatReach(channel.reach)}
      </div>
    </div>
    <div>
      <div class="label-micro">{channel.secondaryLabel}</div>
      <div class="text-h3 font-mono mt-0.5">{channel.secondaryValue}</div>
    </div>
  </div>
  {channel.platform !== "meta_ads" && (
    <div class="text-micro text-text-faint mb-2">Engagement {channel.engagement}%</div>
  )}
  <svg width="100%" height="32" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true">
    <path
      d={sparklinePath(channel.trend, 120, 32)}
      fill="none"
      stroke="#1E6FFF"
      stroke-width="1.5"
      stroke-linecap="round"
      opacity="0.7"
    />
  </svg>
</div>
