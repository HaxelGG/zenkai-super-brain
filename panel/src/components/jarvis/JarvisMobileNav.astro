---
import { JARVIS_DEPARTMENTS } from "../../lib/jarvis/departments";
import { isJarvisNavActive, resolveJarvisRoutes, type JarvisRouteKey } from "../../lib/jarvis/config";

const routes = resolveJarvisRoutes(Astro.url.hostname);
const path = Astro.url.pathname;

const pills: { label: string; href: string }[] = [
  { label: "Home", href: routes.home },
  ...JARVIS_DEPARTMENTS.map((d) => ({
    label: d.label,
    href: routes[d.id as JarvisRouteKey],
  })),
];
---

<nav class="lg:hidden flex gap-1.5 overflow-x-auto pb-4 mb-2 -mx-1 px-1 scrollbar-hide">
  {pills.map((pill) => (
    <a
      href={pill.href}
      class:list={[
        "shrink-0 px-3 py-1.5 rounded-sm text-small no-underline transition-all duration-300",
        isJarvisNavActive(path, pill.href) ? "jv-pill-active" : "jv-pill",
      ]}
    >
      {pill.label}
    </a>
  ))}
</nav>
