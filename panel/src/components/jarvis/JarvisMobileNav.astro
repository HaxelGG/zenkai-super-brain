---
import { JARVIS_BASE, JARVIS_NAV } from "../../lib/jarvis/config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === JARVIS_BASE ? path === JARVIS_BASE || path === `${JARVIS_BASE}/` : path.startsWith(href);
---

<nav class="lg:hidden flex gap-1.5 overflow-x-auto pb-4 mb-2 -mx-1 px-1 scrollbar-hide">
  {JARVIS_NAV.map((item) => (
    <a
      href={item.href}
      class:list={[
        "shrink-0 px-3 py-1.5 rounded-sm text-small no-underline transition-all duration-300",
        isActive(item.href) ? "jv-pill-active" : "jv-pill",
      ]}
    >
      {item.label}
    </a>
  ))}
</nav>
