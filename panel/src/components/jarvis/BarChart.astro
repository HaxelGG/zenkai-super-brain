---
interface Props {
  title?: string;
  data: { label: string; value: number }[];
  height?: number;
  color?: string;
}

const { title, data, height = 160, color = "#4F46E5" } = Astro.props;

const maxVal = Math.max(...data.map((d) => d.value), 1);
const barW = Math.max(20, Math.floor(280 / data.length) - 8);
const chartW = data.length * (barW + 8);
const chartH = height - 30;
---

<div class="jarvis-chart">
  {title && <h3 class="text-small font-semibold mb-3">{title}</h3>}
  <svg width="100%" viewBox={`0 0 ${chartW} ${height}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={title}>
    {data.map((d, i) => {
      const barH = (d.value / maxVal) * chartH;
      const x = i * (barW + 8) + 4;
      const y = chartH - barH + 10;
      return (
        <g>
          <rect
            x={x}
            y={y}
            width={barW}
            height={barH}
            rx="4"
            fill={color}
            opacity={0.85}
          />
          <text
            x={x + barW / 2}
            y={height - 4}
            text-anchor="middle"
            class="fill-text-faint"
            font-size="10"
            font-family="Inter Variable, sans-serif"
          >
            {d.label}
          </text>
        </g>
      );
    })}
  </svg>
</div>
