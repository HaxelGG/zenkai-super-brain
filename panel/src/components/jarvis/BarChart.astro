---
interface Props {
  title?: string;
  data: { label: string; value: number }[];
  height?: number;
  color?: string;
}

const { title, data, height = 160, color = "#00D4FF" } = Astro.props;

const maxVal = Math.max(...data.map((d) => d.value), 1);
const barW = Math.max(20, Math.floor(280 / data.length) - 8);
const chartW = data.length * (barW + 8);
const chartH = height - 30;
---

<div class="jv-chart">
  {title && <h3 class="jv-label text-[10px] mb-3 opacity-80">{title}</h3>}
  <svg width="100%" viewBox={`0 0 ${chartW} ${height}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={title}>
    {data.map((d, i) => {
      const barH = (d.value / maxVal) * chartH;
      const x = i * (barW + 8) + 4;
      const y = chartH - barH + 10;
      return (
        <g>
          <rect x={x} y={y} width={barW} height={barH} rx="2" fill={color} opacity="0.75">
            <animate attributeName="height" from="0" to={barH} dur="0.8s" fill="freeze" begin={`${i * 0.05}s`} />
            <animate attributeName="y" from={chartH + 10} to={y} dur="0.8s" fill="freeze" begin={`${i * 0.05}s`} />
          </rect>
          <text x={x + barW / 2} y={height - 4} text-anchor="middle" font-size="8" fill="#6B8CAE" font-family="JetBrains Mono, monospace">{d.label}</text>
        </g>
      );
    })}
  </svg>
</div>
