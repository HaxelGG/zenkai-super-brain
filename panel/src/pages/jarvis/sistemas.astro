---
import JarvisLayout from "../../layouts/JarvisLayout.astro";
import JarvisMobileNav from "../../components/jarvis/JarvisMobileNav.astro";
import HudPanel from "../../components/jarvis/HudPanel.astro";
import MetricCard from "../../components/jarvis/MetricCard.astro";
import DonutChart from "../../components/jarvis/DonutChart.astro";
import { getJarvisData } from "../../lib/jarvis";

const data = await getJarvisData();
const online = data.systemConnections.filter((s) => s.status === "online").length;
const degraded = data.systemConnections.filter((s) => s.status === "degraded").length;
const pending = data.systemConnections.filter((s) => s.status === "pending").length;

const statusIcon = {
  online: { class: "jv-system-ok", label: "ONLINE" },
  degraded: { class: "jv-system-warn", label: "DEGRADED" },
  offline: { class: "jv-system-error", label: "OFFLINE" },
  pending: { class: "text-[var(--jv-text-dim)]", label: "PENDING" },
};

const kpis = [
  { id: "s1", label: "Sistemas online", value: `${online}/${data.systemConnections.length}`, caption: "conexiones activas" },
  { id: "s2", label: "Airtable CRM", value: data.meta?.dataSource === "live" ? "LIVE" : "MOCK", caption: data.meta?.liveRecords ? `${data.meta.liveRecords.leads}L · ${data.meta.liveRecords.clients}C` : "AIRTABLE_TOKEN" },
  { id: "s3", label: "Meta Social", value: data.meta?.socialConnected ? "CONFIG" : "—", caption: "META_ACCESS_TOKEN + IG ID" },
  { id: "s4", label: "n8n Cloud", value: "PENDING", caption: "zenkai-growth-systems.app.n8n.cloud" },
];
---

<JarvisLayout title="Sistemas" dataSource={data.meta?.dataSource ?? "mock"} liveRecords={data.meta?.liveRecords}>
  <JarvisMobileNav />

  <header class="mb-6" data-jv-animate="1">
    <div class="jv-label mb-2">FORGE · NEXUS · Infraestructura</div>
    <h1 class="jv-heading-page">Sistemas & Conexiones</h1>
    <p class="mt-2 jv-mono text-[12px] text-[var(--jv-text-muted)]">
      {online} online · {degraded} degraded · {pending} pending · roadmap 7 fases
    </p>
  </header>

  <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    {kpis.map((k, i) => <MetricCard metric={k} index={i} />)}
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-5">
    <HudPanel animate={2}>
      <h2 class="jv-heading-section mb-5">Estado de conexiones</h2>
      <div class="space-y-4">
        {data.systemConnections.map((sys, i) => {
          const st = statusIcon[sys.status];
          return (
            <div data-jv-animate={String(i + 3)}>
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2">
                  <span class:list={["jv-display text-[10px] font-bold", st.class]}>{st.label}</span>
                  <span class="text-sm font-medium">{sys.name}</span>
                </div>
                <span class="jv-mono text-[10px] text-[var(--jv-text-dim)]">Fase {sys.phase}</span>
              </div>
              <div class="jv-system-bar">
                <div
                  class="jv-system-bar-fill"
                  style={`width:${sys.uptime}%;background:${sys.status === "online" ? "var(--jv-success)" : sys.status === "degraded" ? "var(--jv-warning)" : sys.status === "pending" ? "var(--jv-text-dim)" : "var(--jv-danger)"}`}
                />
              </div>
              <div class="flex justify-between jv-mono text-[10px] text-[var(--jv-text-dim)] mt-1">
                <span>Uptime {sys.uptime}%</span>
                {sys.latencyMs && <span>{sys.latencyMs}ms latency</span>}
              </div>
            </div>
          );
        })}
      </div>
    </HudPanel>

    <HudPanel animate={3}>
      <DonutChart
        title="Uso de modelos IA · mes"
        segments={data.aiUsage.modelSplit.map((m) => ({
          label: m.model,
          amount: m.pct,
          color: m.color,
        }))}
      />
      <div class="mt-6 grid grid-cols-2 gap-4 pt-4 border-t border-[var(--jv-border)]">
        <div>
          <div class="jv-metric-value" data-count-up={String((data.aiUsage.tokensMonth / 1000000).toFixed(1))}>{(data.aiUsage.tokensMonth / 1000000).toFixed(1)}M</div>
          <div class="jv-mono text-[10px] text-[var(--jv-text-dim)]">tokens mes</div>
        </div>
        <div>
          <div class="jv-metric-value" data-count-up={`$${data.aiUsage.costMonthUsd}`}>${data.aiUsage.costMonthUsd}</div>
          <div class="jv-mono text-[10px] text-[var(--jv-text-dim)]">costo mes</div>
        </div>
      </div>
    </HudPanel>
  </div>

  <HudPanel animate={4}>
    <h2 class="jv-heading-section mb-4">Roadmap conexiones · 7 fases</h2>
    <div class="grid grid-cols-7 gap-2">
      {[1, 2, 3, 4, 5, 6, 7].map((phase) => {
        const conn = data.systemConnections.find((c) => c.phase === phase);
        const done = conn?.status === "online";
        const partial = conn?.status === "degraded";
        return (
          <div class:list={[
            "p-3 text-center border rounded-sm transition-all",
            done && "border-[var(--jv-success)] bg-[rgba(0,255,170,0.05)]",
            partial && "border-[var(--jv-warning)] bg-[rgba(255,184,0,0.05)]",
            !done && !partial && "border-[var(--jv-border)] opacity-50",
          ]}>
            <div class="jv-display text-[10px] text-[var(--jv-cyan)]">F{phase}</div>
            <div class="text-[10px] text-[var(--jv-text-dim)] mt-1 truncate">{conn?.name.split(" ")[0] ?? "—"}</div>
          </div>
        );
      })}
    </div>
  </HudPanel>
</JarvisLayout>
