---
import JarvisLayout from "../../layouts/JarvisLayout.astro";
import MetricCard from "../../components/jarvis/MetricCard.astro";
import SocialChannelCard from "../../components/jarvis/SocialChannelCard.astro";
import BarChart from "../../components/jarvis/BarChart.astro";
import { getJarvisData } from "../../lib/jarvis";

const data = await getJarvisData();

const platformLabels = {
  instagram: "IG",
  linkedin: "IN",
  tiktok: "TT",
};

const socialKpis = [
  { id: "reach-total", label: "Alcance total 7d", value: "22.4K", caption: "3 canales orgánicos", delta: { value: 11, label: "vs sem. ant.", direction: "up" as const } },
  { id: "eng-avg", label: "Engagement promedio", value: "4.4%", caption: "orgánico ponderado", delta: { value: 0.4, label: "pp", direction: "up" as const } },
  { id: "roas", label: "ROAS Meta Ads", value: "3.2x", caption: "últimos 30 días", delta: { value: 0.4, label: "vs mes ant.", direction: "up" as const } },
  { id: "cac", label: "CAC estimado", value: "$98", caption: "Meta + orgánico", delta: { value: 8, label: "vs mes ant.", direction: "down" as const } },
];

const calendarStatusStyle = {
  scheduled: "bg-accent-soft text-accent",
  draft: "bg-bg-muted text-text-muted",
  published: "bg-emerald-50 text-success",
};
---

<JarvisLayout title="Social Media">
  <header class="mb-8">
    <div class="label-micro mb-2">JARVIS · Marketing</div>
    <h1 class="text-h1">Social & Engagement</h1>
    <p class="mt-2 text-body text-text-muted max-w-2xl">
      Métricas orgánicas, paid media y calendario de contenido · cadencia semanal ARES + MUSE.
    </p>
  </header>

  <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-8">
    {socialKpis.map((kpi) => (
      <MetricCard metric={kpi} />
    ))}
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">
    {data.socialChannels.map((ch) => (
      <SocialChannelCard channel={ch} />
    ))}
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="card-base p-6">
      <h2 class="text-h3 mb-4">Top performers</h2>
      <ul class="space-y-4">
        {data.topPosts.map((post, i) => (
          <li class="flex gap-4 p-3 rounded-card bg-bg-muted/50">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent to-[#1E6FFF] flex items-center justify-center text-white text-micro font-bold shrink-0">
              #{i + 1}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-medium text-body leading-snug">{post.hook}</p>
              <div class="mt-2 flex flex-wrap gap-3 text-micro text-text-muted">
                <span>{post.platform.toUpperCase()}</span>
                <span>{post.reach.toLocaleString("es-CO")} alcance</span>
                <span>{post.engagement}% engagement</span>
                {post.saves && <span>{post.saves} saves</span>}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="card-base p-6">
      <h2 class="text-h3 mb-4">Calendario · próximos 7 días</h2>
      <ul class="space-y-3">
        {data.contentCalendar.map((item) => (
          <li class="flex items-center gap-3 text-small">
            <time class="font-mono text-micro text-text-faint w-16 shrink-0">
              {new Date(item.date + "T12:00:00").toLocaleDateString("es-CO", { day: "numeric", month: "short" })}
            </time>
            <span class="w-8 text-center text-micro font-bold text-text-muted">{platformLabels[item.platform]}</span>
            <span class="flex-1 truncate">{item.title}</span>
            <span class:list={["text-micro px-2 py-0.5 rounded-full shrink-0", calendarStatusStyle[item.status]]}>
              {item.status}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="card-base p-6">
    <BarChart
      title="Alcance por canal · tendencia 7 días (último valor)"
      data={data.socialChannels
        .filter((c) => c.platform !== "meta_ads")
        .map((c) => ({
          label: c.label.slice(0, 2).toUpperCase(),
          value: c.reach,
        }))}
      color="#1E6FFF"
    />
  </div>
</JarvisLayout>
