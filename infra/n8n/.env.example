# ZENKAI · n8n self-hosted (dev local)
# Copiar a infra/n8n/.env — NUNCA commitear .env real
# Generar claves: node infra/n8n/scripts/generate-keys.mjs

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n

# --- n8n core ---
N8N_VERSION=latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=CHANGE_ME_BASE64
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota
N8N_SECURE_COOKIE=false

# Acceso UI n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=zenkai
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME

# --- Integraciones ZENKAI (variables dentro de workflows) ---
JARVIS_API_URL=https://YOUR_VERCEL_URL
AIRTABLE_BASE_VENTAS=appXXXXXXXX
ZENKAI_FROM_EMAIL=ZENKAI <hola@zenkai.systems>
ZENKAI_ALERT_EMAIL=hola@zenkai.systems
SLACK_WEBHOOK_URL=
N8N_JARVIS_CALLBACK_URL=https://zenkai-growth-systems.app.n8n.cloud/webhook/jarvis-callback
N8N_MCP_ACCESS_TOKEN=
