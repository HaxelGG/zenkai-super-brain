{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && cd panel && npm install",
  "buildCommand": "cd panel && npm run build",
  "outputDirectory": "panel/dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/agency/cron/tick",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/jarvis",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/jarvis/",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/jarvis/:path*",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/jarvis/:path*", "destination": "/api/jarvis" },
    { "source": "/api/agency/:path*", "destination": "/api/agency" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/"
    },
    {
      "source": "/intel",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/intel/"
    },
    {
      "source": "/agentes",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/agentes/"
    },
    {
      "source": "/pipeline",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/pipeline/"
    },
    {
      "source": "/clientes",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/clientes/"
    },
    {
      "source": "/finanzas",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/finanzas/"
    },
    {
      "source": "/social",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/social/"
    },
    {
      "source": "/tareas",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/tareas/"
    },
    {
      "source": "/jobs",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/jobs/"
    },
    {
      "source": "/sistemas",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/sistemas/"
    },
    {
      "source": "/goals",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/goals/"
    },
    {
      "source": "/dept/:slug*",
      "has": [{ "type": "host", "value": "jarvis.zenkai.systems" }],
      "destination": "/jarvis/dept/:slug*"
    }
  ],
  "headers": [
    {
      "source": "/jarvis-voice.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/jarvis-live.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/jarvis-jobs.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
