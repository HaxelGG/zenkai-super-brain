
"smart_sources:web/src/content/sectores/salud.md": {"path":"web/src/content/sectores/salud.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1dtf2vt","at":1778988016295},"class_name":"SmartSource","last_import":{"mtime":1778981029496,"size":637,"at":1778988016295,"hash":"1dtf2vt"},"blocks":{"#---frontmatter---":[1,11]},"outlinks":[],"metadata":{"slug":"salud","nombre":"Clínicas & Salud","icon":"lucide:heart-pulse","prioridad":4,"dolor_principal":"No-shows, agenda caótica, soporte 24/7 imposible.","agentes_prioritarios":["ATLAS","ECHO","LEX","NEXUS"],"modulo_disponible":true,"copy_corto":"Las clínicas pierden hasta 30% de ingresos por no-shows. Los pacientes esperan respuesta inmediata por WhatsApp y nadie atiende a las 11pm. La IA gestiona la agenda con recordatorios inteligentes, responde dudas frecuentes 24/7, y deriva al humano solo cuando realmente hace falta. Cumplimos HIPAA-equivalente para datos sensibles.","copy_largo":"TODO: redactar en Fase 2"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:web/src/content/sectores/salud.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1de9sdb","at":1778988016295},"key":"web/src/content/sectores/salud.md#---frontmatter---","lines":[1,11],"size":633,"outlinks":[],"class_name":"SmartBlock"},
