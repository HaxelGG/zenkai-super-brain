        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.RESEND_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"{{ $vars.ZENKAI_FROM_EMAIL || 'ZENKAI <hola@zenkai.systems>' }}\",\n  \"to\": \"{{ $vars.ZENKAI_ALERT_EMAIL || 'hola@zenkai.systems' }}\",\n  \"subject\": \"🔥 Lead caliente · score {{ $json.score }}\",\n  \"html\": \"<p><strong>Lead caliente</strong> (score {{ $json.score }}/10)</p><p>Record: {{ $json.recordId }}</p><p>Revisar Airtable VENTAS / leads.</p>\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
