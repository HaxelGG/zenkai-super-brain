      "id": "c1b2c3d4-e5f6-7890-abcd-ef1234560202",
      "name": "Es lead caliente",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst score = b.score ?? '?';\nconst recordId = b.record_id || b.recordId || 'unknown';\nconst brief = b.brief || '';\nconst text = `🔥 *Lead caliente* (score ${score}/10)\\nRecord: ${recordId}\\n${brief}`.slice(0, 3000);\nreturn [{ json: { slackText: text, recordId, score } }];"
      },
      "id": "c1b2c3d4-e5f6-7890-abcd-ef1234560203",
      "name": "Format Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "slack-url",
              "leftValue": "={{ $vars.SLACK_WEBHOOK_URL || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1b2c3d4-e5f6-7890-abcd-ef1234560208",
      "name": "Slack configurado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 180]
