{
  "name": "ZENKAI-M-05-content-pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agency-content",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-content",
      "name": "Webhook agency.marketing.content",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "agency-content"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst event = body.event || 'agency.marketing.content';\nconst payload = body.payload || body;\nreturn [{ json: { event, payload, receivedAt: new Date().toISOString() } }];"
      },
      "id": "normalize",
      "name": "Normalize envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.N8N_JARVIS_CALLBACK_URL || 'https://zenkai-growth-systems.app.n8n.cloud/webhook/jarvis-callback' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'agency.content.queued', payload: $json.payload, source: 'n8n-m05', ts: $json.receivedAt }) }}",
        "options": {}
      },
      "id": "ack-callback",
      "name": "Ack JARVIS callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, workflow: 'M-05', event: $json.event } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook agency.marketing.content": {
      "main": [[{ "node": "Normalize envelope", "type": "main", "index": 0 }]]
    },
    "Normalize envelope": {
      "main": [
        [
          { "node": "Ack JARVIS callback", "type": "main", "index": 0 },
          { "node": "Respond", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true },
  "tags": [{ "name": "jarvis" }, { "name": "marketing" }, { "name": "sprint2" }]
}
