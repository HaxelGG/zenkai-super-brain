{
  "name": "ZENKAI-OPS-01-daily-recap",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 8 }] } },
      "id": "cron-daily",
      "name": "Cron 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.JARVIS_API_URL || 'https://panel.zenkai.systems' }}/api/agency/cron/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $vars.CRON_SECRET }}" }]
        },
        "options": {}
      },
      "id": "http-tick",
      "name": "Agency scheduler tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    }
  ],
  "connections": {
    "Cron 8h": { "main": [[{ "node": "Agency scheduler tick", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "jarvis" }, { "name": "ops" }, { "name": "sprint2" }]
}
