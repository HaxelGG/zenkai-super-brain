    {
      "parameters": {
        "jsCode": "const demos = $('Demos SLA vencido').all().map(i => ({ ...i.json, _table: 'demos' }));\nconst leads = $('Leads SLA vencido').all().map(i => ({ ...i.json, _table: 'Leads' }));\nconst all = [...demos, ...leads];\nif (!all.length) return [{ json: { empty: true } }];\nreturn all.map(r => ({ json: r }));"
      },
      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560304",
      "name": "Merge Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
