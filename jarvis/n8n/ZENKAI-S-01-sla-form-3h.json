      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560301",
      "name": "Cron Cada Hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.airtable.com/v0/' + $vars.AIRTABLE_BASE_VENTAS + '/demos?filterByFormula=' + encodeURIComponent('AND({respondido_at}=BLANK(), OR({sla_alert_sent}=FALSE(), {sla_alert_sent}=BLANK()), IS_BEFORE({created_at}, DATEADD(NOW(), -3, \\'hours\\')))') }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $vars.AIRTABLE_TOKEN }}" }]
        },
        "options": {}
      },
      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560302",
      "name": "Demos SLA vencido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.airtable.com/v0/' + $vars.AIRTABLE_BASE_VENTAS + '/Leads?filterByFormula=' + encodeURIComponent('AND({respondido_at}=BLANK(), OR({sla_alert_sent}=FALSE(), {sla_alert_sent}=BLANK()), IS_BEFORE({Fecha Entrada}, DATEADD(NOW(), -3, \\'hours\\')))') }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $vars.AIRTABLE_TOKEN }}" }]
        },
        "options": {}
      },
      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560303",
      "name": "Leads SLA vencido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 420]
    },
    {
      "parameters": {
        "jsCode": "const demos = ($('Demos SLA vencido').first().json.records || []).map(r => ({ ...r, _table: 'demos' }));\nconst leads = ($('Leads SLA vencido').first().json.records || []).map(r => ({ ...r, _table: 'Leads' }));\nconst all = [...demos, ...leads];\nif (!all.length) return [{ json: { empty: true } }];\nreturn all.map(r => ({ json: r }));"
      },
      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560304",
      "name": "Merge Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-records",
              "leftValue": "={{ $json.empty }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560305",
      "name": "Hay pendientes",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "slack-url",
              "leftValue": "={{ $vars.SLACK_WEBHOOK_URL || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560309",
      "name": "Slack configurado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1060, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: `⚠️ SLA formulario >3h\\nTabla: ${$json._table}\\nRecord: ${$json.id}\\nRevisar y marcar respondido_at en Airtable.` } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "d1b2c3d4-e5f6-7890-abcd-ef1234560306",
