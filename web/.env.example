# zenkai-web · landing publica zenkai.systems
# Copiar a .env (gitignored) y rellenar valores reales para dev local.
# En produccion los valores los toma Vercel desde Project Settings -> Environment Variables.

# === Secrets (NO commitear .env con valores) ===
AIRTABLE_TOKEN=
AIRTABLE_BASE_VENTAS=
ZENKAI_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=

# === Voz "Jarvis" · ElevenLabs (text-to-speech para /api/voz) ===
# API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Opcional · voz a usar (default: "Rachel" multilingüe). IDs en https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
# Opcional · modelo TTS (default: eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=

# === Automatización · n8n (dispatch de workflows vía /api/n8n-dispatch) ===
# URL del Webhook node de tu workflow n8n (Production o Test).
# Ej: https://<tu-instancia-n8n>/webhook/zenkai
N8N_WEBHOOK_URL=
# Opcional · si tu Webhook node usa "Header Auth", el valor del header x-n8n-api-key
N8N_API_KEY=

# === Configuracion ===
ZENKAI_NOTIFY_EMAIL=hola@zenkai.systems
ZENKAI_FROM_EMAIL=hola@zenkai.systems

# === Vars publicas (PUBLIC_* van al cliente) ===
PUBLIC_WA_NUMBER=573226272302
PUBLIC_API_BASE=https://zenkaibrain-git-main-mrhaxel26-sketchs-projects.vercel.app
PUBLIC_CALCOM_LINK=https://cal.com/zenkai-growth-systems/strategy-call
