---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import NavBar from '../components/landing/NavBar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage, noindex } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <SeoHead {title} {description} {canonical} {ogImage} {noindex} />
  </head>
  <body class="bg-zk-bg text-zk-text font-sans antialiased noise">
    <NavBar />
    <main><slot /></main>
    <Footer />
    <WhatsAppFloat />

    <script>
      // Reveal-on-scroll observer · usa .reveal y .reveal.visible (estilos en global.css)
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -60px 0px' },
      );

      const init = () => {
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    </script>
  </body>
</html>
