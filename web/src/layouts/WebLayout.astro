---
// Tres familias, no cuatro. Geist (cuerpo) + Geist Mono (eyebrows y datos) +
// Orbitron 800 sólo para el wordmark. Salen Inter, JetBrains Mono y Orbitron 700:
// eran peso de descarga que no pintaba nada distinto en pantalla.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/orbitron/800.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import NavBar from '../components/landing/NavBar.astro';
import Footer from '../components/landing/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage, noindex } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <SeoHead {title} {description} {canonical} {ogImage} {noindex} />
  </head>
  <body class="bg-zk-bg text-zk-text font-sans antialiased noise">
    <NavBar />
    <main><slot /></main>
    <Footer />
    <WhatsAppFloat />

    <script>
      // Reveal · marca todos los .reveal como visibles al cargar (sin observer).
      // Garantiza que screenshots, SEO crawlers y prefers-reduced-motion siempre
      // muestren el contenido. La animación fade-up sigue ocurriendo (la transición
      // CSS se aplica al cambio de class) pero todas las secciones revelan al inicio.
      const init = () => {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('visible'));

        // Mouse tracking para todas las .card-3d · alimenta el radial gradient ::before via --mouse-x/y
        document.querySelectorAll<HTMLElement>('.card-3d').forEach((card) => {
          card.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = card.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            card.style.setProperty('--mouse-x', `${x}%`);
            card.style.setProperty('--mouse-y', `${y}%`);
          });
        });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    </script>
  </body>
</html>
