---
import type { CollectionEntry } from 'astro:content';
interface Props {
  tier: CollectionEntry<'tiers'>;
}
const { tier } = Astro.props;
const {
  nombre,
  precio_USD,
  precio_USD_recurrente,
  descripcion,
  destacado,
  features,
  cta_label,
  cta_action,
  tiempo_implementacion,
} = tier.data;
const topFeatures = features.slice(0, 3);
---
<article class:list={["tier-card", { destacado }]}>
  {destacado && <span class="badge">Destacado</span>}
  <h3>{nombre}</h3>
  <p class="precio">
    <span class="setup">${precio_USD.toLocaleString('en-US')} setup</span>
    {precio_USD_recurrente && (
      <span class="mensual">+ ${precio_USD_recurrente.toLocaleString('en-US')}/mes</span>
    )}
  </p>
  <p class="descripcion">{descripcion}</p>
  <ul class="features">
    {topFeatures.map((f) => <li>{f}</li>)}
  </ul>
  <p class="tiempo">Implementación: {tiempo_implementacion}</p>
  {/* TODO Fase 3: cta_action="form" → /contacto · "calcom" → URL Cal.com · "whatsapp" → wa.me link */}
  <a class="cta" href="#" data-cta-action={cta_action}>{cta_label}</a>
</article>

<style>
  .tier-card {
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    background-color: var(--color-bg-elevated);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .tier-card.destacado {
    border-color: var(--color-accent-default);
    box-shadow: var(--shadow-glow-accent);
  }
  .badge {
    align-self: flex-start;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent-default);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }
  .precio {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }
  .precio .mensual {
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-regular);
  }
  .descripcion {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }
  .features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .features li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .features li::before {
    content: "✓ ";
    color: var(--color-accent-default);
  }
  .tiempo {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .cta {
    margin-top: var(--space-2);
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-accent-default);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-base);
    text-align: center;
    font-weight: var(--font-weight-medium);
    transition: background-color var(--duration-base) var(--ease-default);
  }
  .cta:hover {
    background-color: var(--color-accent-hover);
  }
</style>
