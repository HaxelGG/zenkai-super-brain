---
/**
 * ChatWidget — asistente IA flotante "Alex" (rediseño premium).
 *
 * Botón circular abajo-derecha con pulso de atención y badge de conversación.
 * Panel con animación de entrada/salida, cabecera con minimizar/cerrar,
 * streaming en vivo, burbujas diferenciadas, markdown enriquecido (negritas,
 * viñetas y enlaces), preguntas rápidas CONTEXTUALES según el sector del
 * visitante y el tema de la conversación, y cierre por WhatsApp.
 * Teaser de invitación a los 9 segundos.
 */
---

<button id="cw-trigger" class="cw-trigger" aria-label="Abrir chat de ayuda" title="¿Necesitas ayuda?">
  <span class="cw-trigger__ping"></span>
  <span class="cw-trigger__dot"></span>
  <svg class="cw-trigger__open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8 8.4 8.4 0 0 1-3.6-.8L4 20l1.2-5.4A8 8 0 1 1 21 12z"/><path d="M12 8.5v4M10 10.5h4"/></svg>
  <svg class="cw-trigger__close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
</button>

<div id="cw-teaser" class="cw-teaser" hidden>
  <p>👋 ¿Sabes cuánto te cuesta <strong>no automatizar</strong> tu negocio?</p>
  <span>Pregúntame, es gratis →</span>
</div>

<div id="cw-panel" class="cw-panel" aria-hidden="true" role="dialog" aria-label="Chat con Alex, asesor de ZENKAI">
  <div class="cw-header">
    <div class="cw-header__ring">
      <div class="cw-header__avatar">ZK</div>
      <span class="cw-header__dot"></span>
    </div>
    <div class="cw-header__info">
      <div class="cw-header__title">Alex · Asesor ZENKAI</div>
      <div class="cw-header__sub" id="cw-status">En línea · IA real · responde al instante</div>
    </div>
    <div class="cw-header__acciones">
      <button id="cw-min" class="cw-icon-btn" aria-label="Minimizar chat" title="Minimizar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg>
      </button>
      <button id="cw-close" class="cw-icon-btn" aria-label="Cerrar chat" title="Cerrar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
  <div id="cw-messages" class="cw-messages"></div>
  <div id="cw-chips" class="cw-chips" hidden></div>
  <div id="cw-wa" class="cw-wa" hidden>
    <a href="https://wa.me/34622874482" target="_blank" rel="noopener noreferrer" id="cw-wa-link">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.7 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.4.7-.9 1-.7 1.4.9 1.6 2 2.6 3.5 3.4.3.2.5.1.7-.1l.9-1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.4.1.1.1.6-.1 1.1z"/></svg>
      Hablar con un asesor por WhatsApp
    </a>
  </div>
  <div class="cw-input-area">
    <input id="cw-input" type="text" class="cw-input" placeholder="Escribe tu mensaje…" maxlength="500" autocomplete="off" />
    <button id="cw-send" class="cw-send" aria-label="Enviar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"/></svg>
    </button>
  </div>
</div>

<script>
  const trigger = document.getElementById('cw-trigger')!;
  const panel = document.getElementById('cw-panel')!;
  const messagesEl = document.getElementById('cw-messages')!;
  const input = document.getElementById('cw-input') as HTMLInputElement;
  const sendBtn = document.getElementById('cw-send')!;
  const chipsEl = document.getElementById('cw-chips')!;
  const waEl = document.getElementById('cw-wa')!;
  const waLink = document.getElementById('cw-wa-link') as HTMLAnchorElement;
  const statusEl = document.getElementById('cw-status')!;
  const teaser = document.getElementById('cw-teaser')!;
  const closeBtn = document.getElementById('cw-close')!;
  const minBtn = document.getElementById('cw-min')!;

  let open = false;
  let loading = false;
  let usado = false;
  let verExtras = false;
  let sectorActivo: string | null = null;
  const history: { role: 'user' | 'assistant'; content: string }[] = [];

  const WELCOME = '¡Hola! Soy **Alex**, el asesor de ZENKAI 👋\n\nCuéntame: ¿qué negocio tienes y qué te está costando más hoy: **vender más**, **atender a tus clientes** o **operar tu día a día**?';

  const WA_NUM = '34622874482';
  const waTexto = (msg: string, origen: string) =>
    `https://wa.me/${WA_NUM}?text=${encodeURIComponent(msg + '\n\n(origen: ' + origen + ')')}`;

  const escapeHtml = (t: string) =>
    t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  function renderMarkdown(t: string): string {
    const esc = escapeHtml(t);
    return esc
      .split('\n')
      .map((linea) => {
        if (!linea.trim()) return '<span class="cw-blank"></span>';
        const esBullet = /^[-•*]\s+/.test(linea.trim());
        const cuerpo = esBullet ? linea.trim().replace(/^[-•*]\s+/, '') : linea;
        const conLinks = cuerpo.replace(
          /(https?:\/\/[^\s<]+)/g,
          '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>'
        );
        const conBold = conLinks.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        if (esBullet) {
          return `<span class="cw-line"><span class="cw-bullet"></span>${conBold}</span>`;
        }
        return `<span class="cw-line">${conBold}</span>`;
      })
      .join('');
  }

  const hora = () =>
    new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

  function addMessage(role: 'user' | 'assistant', text: string) {
    const div = document.createElement('div');
    div.className = `cw-msg cw-msg--${role}`;
    if (role === 'assistant') {
      div.innerHTML = `<span class="cw-avatar">ZK</span><div class="cw-bubble">${renderMarkdown(text)}</div><span class="cw-time">${hora()}</span>`;
    } else {
      div.innerHTML = `<div class="cw-bubble">${renderMarkdown(text)}</div><span class="cw-time">${hora()}</span>`;
    }
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function addTyping() {
    const div = document.createElement('div');
    div.className = 'cw-msg cw-msg--assistant cw-typing';
    div.innerHTML = '<span class="cw-avatar">ZK</span><div class="cw-bubble"><span></span><span></span><span></span></div>';
    div.id = 'cw-typing';
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function removeTyping() {
    document.getElementById('cw-typing')?.remove();
  }

  async function leerStream(resp: Response, onChunk: (t: string) => void): Promise<string> {
    const reader = resp.body!.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    let completo = '';
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n');
      buffer = lines.pop() ?? '';
      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed.startsWith('data:')) continue;
        const payload = trimmed.slice(5).trim();
        if (payload === '[DONE]') continue;
        try {
          const obj = JSON.parse(payload);
          if (typeof obj.d === 'string') {
            completo += obj.d;
            onChunk(obj.d);
          } else if (obj.error) {
            throw new Error(String(obj.error));
          }
        } catch (err) {
          if (err instanceof SyntaxError) continue;
          throw err;
        }
      }
    }
    return completo;
  }

  interface Chip {
    texto: string;
    emoji?: string;
    href?: string;
  }

  const SECTORES: { id: string; label: string; kw: string[] }[] = [
    { id: 'clinica', label: 'Clínica dental', kw: ['dent', 'clínica', 'clinica', 'salud', 'paciente', 'consulta', 'cita', 'odont', 'médic', 'medic', 'doctor'] },
    { id: 'restaurante', label: 'Restaurante', kw: ['restaur', 'hostal', 'hotel', 'bar', 'cafeter', 'chef', 'mesa', 'reserva', 'pedido', 'hosteler', 'cocina'] },
    { id: 'ecommerce', label: 'Ecommerce', kw: ['ecommerce', 'e-commerce', 'tienda', 'shopify', 'woocommerce', 'woo', 'online', 'carrito', 'envío', 'envio', 'stock', 'vendo', 'dropshipping'] },
    { id: 'inmobiliaria', label: 'Inmobiliaria', kw: ['inmobiliar', 'propiedad', 'piso', 'alquiler', 'vender casa', 'departamento', 'visita', 'arrendamiento'] },
    { id: 'servicios', label: 'Servicios profesionales', kw: ['agencia', 'consultor', 'abogad', 'estudio', 'cotización', 'cotizacion', 'factur', 'asesor', 'profesional', 'arquitecto'] },
    { id: 'talleres', label: 'Taller / servicios técnicos', kw: ['taller', 'mecánic', 'mecanic', 'técnico', 'tecnico', 'reparación', 'reparacion', 'mantenimiento'] },
  ];

  function detectarSector(): string | null {
    const texto = history
      .filter((m) => m.role === 'user')
      .map((m) => m.content)
      .join(' ')
      .toLowerCase();
    let mejor: string | null = null;
    let mejorN = 0;
    for (const s of SECTORES) {
      const n = s.kw.filter((k) => texto.includes(k)).length;
      if (n > mejorN) {
        mejorN = n;
        mejor = s.label;
      }
    }
    return mejorN > 0 ? mejor : null;
  }

  const iniciales: Chip[] = [
    { texto: 'Tengo una clínica dental', emoji: '🦷' },
    { texto: 'Tengo un restaurante', emoji: '🍽️' },
    { texto: 'Vendo online', emoji: '🛒' },
    { texto: 'Soy inmobiliaria', emoji: '🏢' },
  ];

  const extras: Chip[] = [
    { texto: '¿Cuánto cuesta y qué incluye?', emoji: '💰' },
    { texto: '¿En cuánto tiempo lo implementan?', emoji: '⚡' },
    { texto: '¿Cómo funciona la garantía de 14 días?', emoji: '🛡️' },
    { texto: '¿Se integra con lo que ya uso?', emoji: '🔌' },
  ];

  const porSector: Record<string, Chip[]> = {
    'Clínica dental': [
      { texto: 'Perdemos citas por ausencias, ¿cómo lo resuelven?', emoji: '📅' },
      { texto: '¿Qué incluye y cuánto cuesta?', emoji: '💰' },
    ],
    Restaurante: [
      { texto: 'Las reservas llegan por teléfono, ¿lo pueden gestionar?', emoji: '📞' },
      { texto: '¿Qué incluye y cuánto cuesta?', emoji: '💰' },
    ],
    Ecommerce: [
      { texto: 'Se me llenan los carritos abandonados, ¿cómo los recupero?', emoji: '🛒' },
      { texto: '¿Se integra con Shopify?', emoji: '🔌' },
    ],
    Inmobiliaria: [
      { texto: 'Pierdo leads por responder tarde, ¿cómo lo arreglan?', emoji: '⚡' },
      { texto: '¿Hacen seguimiento automático a clientes fríos?', emoji: '🔄' },
    ],
    'Servicios profesionales': [
      { texto: 'Tardo días en mandar cotizaciones, ¿se automatiza?', emoji: '📄' },
      { texto: '¿La facturación se automatiza sola?', emoji: '🧾' },
    ],
    'Taller / servicios técnicos': [
      { texto: 'Los presupuestos tardan mucho, ¿se automatizan?', emoji: '🔧' },
      { texto: '¿Qué incluye y cuánto cuesta?', emoji: '💰' },
    ],
  };

  function contextuales(ultimo: string): Chip[] {
    const t = ultimo.toLowerCase();
    const lista: Chip[] = [];

    if (sectorActivo && porSector[sectorActivo]) {
      lista.push(...porSector[sectorActivo]);
    }

    if (/precio|cuesta|costo|coste|€|usd|\$|starter|growth|plan/.test(t)) {
      lista.push(
        { texto: '¿Qué incluye cada plan?', emoji: '📦' },
        { texto: '¿Hay descuento por pago anual?', emoji: '🎁' }
      );
    } else if (/implement|tiempo|días|dias|semana|montar|configur/.test(t)) {
      lista.push(
        { texto: '¿Quién configura todo?', emoji: '🛠️' },
        { texto: '¿Necesito saber de tecnología?', emoji: '🧠' }
      );
    } else if (/garant|devoluci|riesgo|prueba/.test(t)) {
      lista.push(
        { texto: '¿Hay permanencia o puedo cancelar?', emoji: '🔓' }
      );
    } else if (/informe|diagnóstico|diagnostico|reporte/.test(t)) {
      lista.push(
        { texto: '¿Me lo mandan por WhatsApp?', emoji: '📱' }
      );
    } else if (/whatsapp|hablar|asesor|equipo|humano/.test(t)) {
      lista.push(
        { texto: 'Quiero mi informe gratis', emoji: '📄', href: '#oferta' }
      );
    }

    lista.push(
      { texto: 'Quiero mi informe gratis', emoji: '📄', href: '#oferta' },
      { texto: 'Ver precios', emoji: '💰', href: '/precios/' },
      { texto: 'Hablar por WhatsApp', emoji: '📱', href: waTexto('Hola ZENKAI. Vengo del chat de la web y quiero hablar con alguien del equipo.', 'widget-chat-chip') }
    );

    const vistos = new Set<string>();
    return lista
      .filter((c) => (vistos.has(c.texto) ? false : (vistos.add(c.texto), true)))
      .slice(0, 4);
  }

  function chipsActuales(): Chip[] {
    if (verExtras) return extras;
    const ultimo = [...history].reverse().find((m) => m.role === 'assistant' && m.content.trim());
    if (ultimo) return contextuales(ultimo.content);
    return iniciales;
  }

  function renderChips() {
    chipsEl.innerHTML = '';
    const chips = chipsActuales();
    for (const chip of chips) {
      const etiqueta = `${chip.emoji ? chip.emoji + ' ' : ''}${chip.texto}`;
      if (chip.href) {
        const a = document.createElement('a');
        a.className = 'cw-chip cw-chip--link';
        a.href = chip.href;
        a.textContent = etiqueta;
        if (chip.href.startsWith('http')) a.target = '_blank';
        a.rel = 'noopener noreferrer';
        if (chip.href.startsWith('#')) {
          a.addEventListener('click', () => cerrar());
        }
        chipsEl.appendChild(a);
      } else {
        const btn = document.createElement('button');
        btn.className = 'cw-chip';
        btn.type = 'button';
        btn.textContent = etiqueta;
        btn.addEventListener('click', () => {
          input.value = chip.texto;
          send();
        });
        chipsEl.appendChild(btn);
      }
    }
    const toggle = document.createElement('button');
    toggle.className = 'cw-chips__toggle';
    toggle.type = 'button';
    toggle.textContent = verExtras ? '◀ Volver a sugerencias' : '❓ Otras preguntas';
    toggle.addEventListener('click', () => {
      verExtras = !verExtras;
      renderChips();
    });
    chipsEl.appendChild(toggle);
    const ultimoMsg = history[history.length - 1];
    chipsEl.hidden = loading || !ultimoMsg || ultimoMsg.role !== 'assistant';
  }

  function actualizarEstado() {
    statusEl.textContent = loading
      ? 'Escribiendo…'
      : sectorActivo
        ? `En línea · te ayudo con ${sectorActivo}`
        : 'En línea · IA real · responde al instante';
  }

  async function send() {
    const text = input.value.trim();
    if (!text || loading) return;
    input.value = '';
    loading = true;
    usado = true;
    sendBtn.setAttribute('disabled', '');
    actualizarEstado();
    addMessage('user', text);
    history.push({ role: 'user', content: text });
    addTyping();

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ stream: true, sector: sectorActivo ?? '', messages: history.slice(-12) }),
      });
      if (!res.ok || !res.body) {
        const data = await res.json().catch(() => null);
        throw new Error(data?.error || 'Error');
      }
      removeTyping();
      const div = document.createElement('div');
      div.className = 'cw-msg cw-msg--assistant';
      div.innerHTML = `<span class="cw-avatar">ZK</span><div class="cw-bubble"></div><span class="cw-time">${hora()}</span>`;
      messagesEl.appendChild(div);
      const bubble = div.querySelector('.cw-bubble')!;
      let texto = '';
      const pinta = () => {
        bubble.innerHTML = renderMarkdown(texto);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      };
      await leerStream(res, (chunk) => {
        texto += chunk;
        pinta();
      });
      if (!texto.trim()) throw new Error('vacío');
      history.push({ role: 'assistant', content: texto });
    } catch (err) {
      console.error('Widget error', err);
      removeTyping();
      addMessage('assistant', 'Perdona, estoy teniendo un momento técnico 🙈. Escríbenos por WhatsApp y te atiende el equipo en menos de 4 horas: **+34 622 874 482**.');
    }
    loading = false;
    sectorActivo = detectarSector();
    sendBtn.removeAttribute('disabled');
    actualizarEstado();
    renderChips();
    actualizarWa();
  }

  function actualizarWa() {
    const ultimo = history.length > 0 ? history[history.length - 1].content.slice(0, 100) : '';
    const texto = `Hola ZENKAI. Vengo del chat de la web y quiero hablar con alguien del equipo. Último mensaje: "${ultimo}"`;
    waLink.href = waTexto(texto, 'widget-chat');
    waEl.hidden = history.filter((m) => m.role === 'user').length === 0;
  }

  const abrir = () => {
    open = true;
    usado = true;
    trigger.classList.add('cw-trigger--used');
    panel.setAttribute('aria-hidden', 'false');
    trigger.classList.add('cw-trigger--open');
    teaser.hidden = true;
    sectorActivo = detectarSector();
    if (history.length === 0) {
      addMessage('assistant', WELCOME);
      history.push({ role: 'assistant', content: WELCOME });
    }
    actualizarEstado();
    renderChips();
    actualizarWa();
    input.focus();
  };

  const cerrar = () => {
    if (!open) return;
    open = false;
    trigger.classList.remove('cw-trigger--open');
    panel.classList.add('cw-panel--closing');
    window.setTimeout(() => {
      panel.classList.remove('cw-panel--closing');
      panel.setAttribute('aria-hidden', 'true');
    }, 180);
  };

  trigger.addEventListener('click', () => {
    if (open) cerrar();
    else abrir();
  });

  closeBtn.addEventListener('click', cerrar);
  minBtn.addEventListener('click', cerrar);

  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') send(); });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) cerrar();
  });

  setTimeout(() => {
    if (!usado && !open && !sessionStorage.getItem('zk_widget_teaser')) {
      teaser.hidden = false;
      try { sessionStorage.setItem('zk_widget_teaser', '1'); } catch { /* storage bloqueado */ }
    }
  }, 9000);

  teaser.addEventListener('click', () => {
    teaser.hidden = true;
    abrir();
  });
</script>

<style is:global>
  .cw-trigger {
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 100;
    width: 56px; height: 56px; border-radius: 50%;
    border: 1px solid rgba(74,158,255,0.5);
    background: linear-gradient(135deg, #4a9eff, #8b5cf6);
    color: white; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 32px rgba(74,158,255,0.35);
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), box-shadow 0.3s;
  }
  .cw-trigger__ping {
    position: absolute; inset: 0; border-radius: 50%;
    background: rgba(74,158,255,0.5); z-index: -1;
    animation: cwPing 2.6s cubic-bezier(0,0,0.2,1) infinite;
  }
  .cw-trigger--used .cw-trigger__ping { display: none; }
  @keyframes cwPing {
    0% { transform: scale(1); opacity: 0.8; }
    80%, 100% { transform: scale(1.9); opacity: 0; }
  }
  .cw-trigger__dot {
    position: absolute; top: 0; right: 0;
    width: 11px; height: 11px; border-radius: 50%;
    background: #22c55e; border: 2px solid #0a0a0f;
    display: none;
  }
  .cw-trigger:not(.cw-trigger--open).cw-trigger--used .cw-trigger__dot { display: block; }
  .cw-trigger:hover { transform: scale(1.08); box-shadow: 0 12px 40px rgba(74,158,255,0.5); }
  .cw-trigger__close { display: none; }
  .cw-trigger--open .cw-trigger__open { display: none; }
  .cw-trigger--open .cw-trigger__close { display: block; }

  .cw-teaser {
    position: fixed; bottom: 6.2rem; right: 1.5rem; z-index: 99;
    max-width: 264px; padding: 0.85rem 1.05rem;
    border-radius: 1rem 1rem 1rem 0.25rem;
    border: 1px solid var(--zk-border-hi);
    background: rgba(18,18,26,0.92);
    backdrop-filter: blur(14px);
    box-shadow: 0 16px 50px rgba(0,0,0,0.5);
    cursor: pointer;
    animation: cwTeaserIn 0.4s cubic-bezier(0.16,1,0.3,1);
    transition: border-color 0.2s;
  }
  .cw-teaser:hover { border-color: rgba(74,158,255,0.5); }
  @keyframes cwTeaserIn {
    from { opacity: 0; transform: translateY(12px) scale(0.95); }
    to { opacity: 1; transform: none; }
  }
  .cw-teaser p {
    margin: 0; font-size: 0.8125rem; line-height: 1.45; color: var(--zk-text);
