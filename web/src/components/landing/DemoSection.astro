---
// web/src/components/landing/DemoSection.astro
// v3.3 Sprint 2.5 + Sprint 3 · Demo cableado al endpoint real /api/lead-demo
// Tres estados: input → loading (mín 8s) → propuesta real renderizada del JSON
// Turnstile widget render condicional · solo si PUBLIC_TURNSTILE_SITE_KEY está definida
import { MIN_TEXTO, MAX_TEXTO } from '../../lib/limits';
import { MODULOS } from '../../lib/modulos';
import { TIERS } from '../../data/pricing';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const waNumber = import.meta.env.PUBLIC_WA_NUMBER ?? '34622874482';

// El cliente necesita dos cosas del servidor para poder pintar la propuesta sin
// que el modelo invente nada: cómo se llama cada módulo (para enlazarlo) y cuánto
// cuesta cada plan (para que el precio salga de la tabla oficial y no del LLM).
const nombresModulos = Object.fromEntries(MODULOS.map((m) => [m.slug, m.nombre]));
const preciosPorTier = Object.fromEntries(TIERS.map((t) => [t.nombre, t.mensual]));
---

<section id="hero-demo" class="relative py-24 lg:py-32 border-t border-zk-border/50 overflow-hidden">

  <div class="relative max-w-4xl mx-auto px-5 lg:px-8 z-10">

    <div class="text-center mb-12">
      <div class="section-badge">
        <span class="section-badge-line warm"></span>
        <span class="section-badge-text warm">Pruébalo ahora</span>
        <span class="section-badge-line warm"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-5 leading-[1.05]">
        Tu propuesta personalizada<br>
        <span class="gradient-warm">en 30 segundos.</span>
      </h2>
      <p class="text-lg text-zk-text2 max-w-2xl mx-auto">
        Sin agendar nada. Sin email para verla. Sin compromiso.
      </p>
    </div>

    <div id="demo-container" class="relative">

      {/* ESTADO 1 · INPUT */}
      <div id="demo-input" class="demo-box">
        <div class="flex items-center justify-between px-4 pt-3 pb-2 text-xs font-mono text-zk-muted">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></div>
            </div>
            <span class="ml-2">propuesta.zenkai → describe tu negocio</span>
          </div>
          <span style="color: #10D9A0;">● en vivo</span>
        </div>

        <textarea
          id="demo-textarea"
          rows="5"
          maxlength={MAX_TEXTO}
          data-min={MIN_TEXTO}
          data-max={MAX_TEXTO}
          placeholder="Tengo una clínica dental con 3 doctores. Queremos que las citas se agenden por WhatsApp y que dejen de caerse las que nadie confirma…"
          class="w-full bg-transparent text-zk-text placeholder:text-zk-muted text-base px-5 py-3 resize-none focus:outline-none font-sans leading-relaxed"
        ></textarea>

        {turnstileSiteKey && (
          <div class="px-4 pb-2 flex justify-start">
            <div
              id="turnstile-widget"
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="dark"
              data-size="flexible"
            ></div>
          </div>
        )}

        <div class="flex items-center justify-between gap-3 px-4 pb-3 pt-1">
          <div class="text-xs font-mono text-zk-muted flex items-center gap-2">
            <span id="char-count" class="counter-num">0</span>
            <span>/ {MIN_TEXTO} mínimos</span>
            <span class="hidden sm:inline text-zk-muted">·</span>
            <span class="hidden sm:inline text-zk-muted">ESP · EN · PT</span>
          </div>
          <button
            id="generate-btn"
            disabled
            class="btn-primary text-white font-semibold text-sm px-6 py-3 rounded-xl disabled:opacity-30 disabled:cursor-not-allowed flex items-center gap-2 group"
          >
            <span>Generar propuesta</span>
            <span class="hidden sm:inline text-white/70 text-xs font-mono">→ 30s</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
        </div>
      </div>

      {/* ESTADO 2 · LOADING (mín 8s · UX) */}
      <div id="demo-loading" class="hidden demo-box p-8">
        <div class="flex items-center gap-3 mb-7">
          <div class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full rounded-full bg-zk-accent opacity-75 animate-ping"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-zk-accent"></span>
          </div>
          <div>
            {/* Sin nombre de modelo: el proveedor es configurable (LLM_PROVIDER),
                así que una etiqueta fija sería falsa la mitad de las veces. */}
            <div class="text-sm font-medium text-zk-text">Analizando tu caso</div>
            <div class="text-xs font-mono text-zk-muted">Tiempo estimado: 15-30 segundos</div>
          </div>
        </div>

        <div class="space-y-4 font-mono text-sm">
          <div class="step-line flex items-start gap-3">
            <div class="step-check"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <div class="flex-1">
              <div class="text-zk-text">Analizando tu negocio</div>
              <div class="mt-0.5 text-xs text-zk-muted">Sector, tamaño, complejidad, tier recomendado</div>
            </div>
          </div>
          <div class="step-line delay-1 flex items-start gap-3">
            <div class="step-check"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <div class="flex-1">
              <div class="text-zk-text">Diseñando arquitectura técnica</div>
              <div class="mt-0.5 text-xs text-zk-muted">Agentes IA · integraciones · stack</div>
            </div>
          </div>
          <div class="step-line delay-2 flex items-start gap-3">
            <div class="step-check"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <div class="flex-1">
              <div class="text-zk-text">Calculando inversión y timeline</div>
              <div class="mt-0.5 text-xs text-zk-muted">Precio mínimo según fórmula matemática</div>
            </div>
          </div>
          <div class="step-line delay-3 flex items-start gap-3">
            <div class="step-check"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
            <div class="flex-1">
              <div class="text-zk-text">Generando recomendación + proyección 90 días</div>
              <div class="mt-0.5 text-xs text-zk-muted">Resultado esperado para tu caso</div>
            </div>
          </div>
        </div>

        <div class="mt-8 h-1 bg-zk-surface3 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-gradient-to-r from-zk-accent via-zk-accent3 to-zk-accent transition-all duration-[8000ms] ease-linear" style="width: 0%"></div>
        </div>
      </div>

      {/* ESTADO 3 · PROPUESTA (renderizada dinámicamente del JSON) */}
      <div id="demo-proposal" class="hidden"></div>

      {/* Datos del servidor para el render de la propuesta. Van como JSON en el
          DOM y no en el bundle para que sigan un único origen: el catálogo y la
          tabla de precios reales. */}
      <script id="demo-modulos" type="application/json" is:inline set:html={JSON.stringify(nombresModulos)}></script>
      <script id="demo-precios" type="application/json" is:inline set:html={JSON.stringify(preciosPorTier)}></script>

      {/* ESTADO 4 · ERROR · con fallback a WhatsApp llevando el brief ya escrito */}
      <div id="demo-error" class="hidden demo-box p-6 border-l-4 border-red-500" data-wa-number={waNumber}>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <div class="flex-1">
            <div class="font-medium text-zk-text mb-1">Hubo un problema</div>
            <div id="demo-error-msg" class="text-sm text-zk-text2 mb-4"></div>

            {/* Fallback primario · no perdemos el lead sólo porque el endpoint falló */}
            <a
              id="demo-error-wa"
              href={`https://wa.me/${waNumber}`}
              target="_blank"
              rel="noopener"
              class="wa-cta hidden"
            >
              <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.898 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.464 3.488"/></svg>
              <span>Mandanos el brief por WhatsApp</span>
            </a>
            <p id="demo-error-wa-note" class="hidden text-xs text-zk-muted mt-2">
              Te abrimos el chat con lo que escribiste ya cargado. Contestamos nosotros, no un bot.
            </p>

            <div class="flex gap-2 mt-4">
              <button id="demo-retry" class="text-xs font-mono text-zk-growth hover:underline">Probar de nuevo</button>
            </div>
          </div>
        </div>
      </div>

    </div>

    {turnstileSiteKey && (
      <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
        is:inline
      ></script>
    )}

    <div class="mt-7 flex flex-wrap justify-center gap-x-7 gap-y-2.5 text-xs text-zk-muted">
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" style="color: #10D9A0;">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        Sin email para ver la propuesta
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" style="color: #10D9A0;">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        Sin tarjeta · sin compromiso
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" style="color: #10D9A0;">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        Tu información no se vende
      </span>
    </div>
  </div>
</section>

<style>
  .section-badge { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .section-badge-line { width: 32px; height: 1px; background: #4A9EFF; }
  .section-badge-line.warm { background: #FF9540; }
  .section-badge-text {
    font-family: 'Geist Mono', 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11px; color: #4A9EFF;
    letter-spacing: 0.2em; text-transform: uppercase;
  }
  .section-badge-text.warm { color: #FF9540; }

  .gradient-warm {
    background: linear-gradient(135deg, #FFD89A 0%, #FF8830 50%, #FFB060 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .demo-box {
    background: linear-gradient(135deg, rgba(13,13,23,0.95), rgba(20,20,35,0.85));
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid #2A2A3A;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6);
    transition: all .3s;
  }
  .demo-box.glow {
    border-color: rgba(74,158,255,0.6);
    box-shadow: 0 0 0 2px rgba(74,158,255,0.4), 0 0 60px rgba(74,158,255,0.3), 0 25px 50px -12px rgba(0,0,0,0.7);
  }

  .btn-primary {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, #1E6FFF 0%, #4A9EFF 50%, #1E6FFF 100%);
    background-size: 200% 200%;
    animation: demoGradShift 8s ease infinite;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 4px 16px rgba(30,111,255,0.4), 0 0 0 1px rgba(30,111,255,0.6);
    transition: all .3s cubic-bezier(.16,1,.3,1);
  }
  .btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.35), 0 16px 40px rgba(30,111,255,0.5), 0 0 60px rgba(30,111,255,0.4);
  }
  @keyframes demoGradShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .step-check {
    margin-top: 2px;
    width: 20px; height: 20px;
    border-radius: 9999px;
    background: rgba(74, 158, 255, 0.2);
    border: 1px solid #4A9EFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #4A9EFF;
  }
  .step-line { opacity: 0; animation: stepFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .step-line.delay-1 { animation-delay: 0.9s; }
  .step-line.delay-2 { animation-delay: 2.4s; }
  .step-line.delay-3 { animation-delay: 4.2s; }
  @keyframes stepFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .counter-num {
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum';
  }

  /* Verde WhatsApp · reservado exclusivamente para CTAs de WhatsApp.
     Si el ojo aprende que verde = "hablar con un humano", el CTA gana contraste
     sin necesidad de crecer. No usar este color para nada más. */
  .wa-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 20px;
    background: #25D366;
    color: #05270F;
    font-weight: 600;
    font-size: 15px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .wa-cta:hover { background: #1FBA59; transform: translateY(-1px); }
  .wa-cta:focus-visible {
    outline: 2px solid #25D366;
    outline-offset: 3px;
  }
  .wa-cta.hidden { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .wa-cta { transition: background 0.2s; }
    .wa-cta:hover { transform: none; }
  }

  .proposal-card {
    background: linear-gradient(135deg, rgba(13,13,23,0.95), rgba(20,20,35,0.85));
    border: 1px solid rgba(74, 158, 255, 0.3);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6), 0 0 60px rgba(74,158,255,0.15);
  }
  .proposal-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    background: rgba(74,158,255,0.1);
    border: 1px solid rgba(74,158,255,0.3);
    border-radius: 9999px;
    font-family: 'Geist Mono', 'JetBrains Mono Variable', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4A9EFF;
  }
  .proposal-block {
    background: rgba(13, 13, 23, 0.5);
    border: 1px solid #1F1F2C;
    border-radius: 12px;
    padding: 16px;
  }
  .proposal-label {
    font-family: 'Geist Mono', 'JetBrains Mono Variable', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #5A5A70;
    margin-bottom: 6px;
  }
  .proposal-mods { display: grid; gap: 8px; }
  @media (min-width: 640px) { .proposal-mods { grid-template-columns: repeat(2, 1fr); } }
  .proposal-mod {
    display: block;
    padding: 11px 13px;
    border: 1px solid #1F1F2C;
    border-radius: 10px;
    background: rgba(8, 8, 12, 0.55);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .proposal-mod:hover { border-color: rgba(74, 158, 255, 0.5); background: rgba(74, 158, 255, 0.06); }
  .proposal-mod strong { display: block; font-size: 13.5px; color: #4A9EFF; font-weight: 700; }
  .proposal-mod span {
    display: block; margin-top: 2px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: #8A8A9E;
  }
  .proposal-mod.es-principal { border-color: rgba(74, 158, 255, 0.45); background: rgba(74, 158, 255, 0.08); }

  .proposal-pill {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(74, 158, 255, 0.1);
    border: 1px solid rgba(74, 158, 255, 0.3);
    border-radius: 6px;
    font-family: 'Geist Mono', 'JetBrains Mono Variable', monospace;
    font-size: 11px;
    color: #7DA5FF;
  }
</style>

<script>
  /* eslint-disable no-console */
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;

  // Ejemplos sin ciudad ni plataforma local: este sitio se sirve por defecto a
  // Europa, y un placeholder que habla de Medellín o de Rappi le dice al
  // visitante español que la web no está escrita para él.
  const placeholders = [
    'Tengo una clínica dental con 3 doctores. Queremos que las citas se agenden por WhatsApp y que dejen de caerse las que nadie confirma…',
    'Vendo ropa por Instagram y tengo la tienda en Shopify. Quiero recuperar los carritos abandonados y saber qué anuncio trae compradores de verdad…',
    'Tengo un restaurante de 6 mesas. La mayoría de pedidos entran por una app que se lleva comisión y quiero recuperar el pedido directo…',
    'Soy abogado independiente. Paso más tiempo redactando propuestas que llevando casos…',
  ];

  const textarea = $<HTMLTextAreaElement>('demo-textarea');
  const charCount = $('char-count');
  const generateBtn = $<HTMLButtonElement>('generate-btn');
  const demoInput = $('demo-input');
  const demoLoading = $('demo-loading');
  const demoProposal = $('demo-proposal');
  const demoError = $('demo-error');
  const demoErrorMsg = $('demo-error-msg');
  const progressBar = $('progress-bar');
  const retryBtn = $('demo-retry');

  if (textarea && charCount && generateBtn && demoInput && demoLoading && demoProposal && demoError && demoErrorMsg && progressBar && retryBtn) {

    // Umbrales servidos desde lib/limits.ts vía data-attrs · el cliente nunca
    // define su propio mínimo, así el gate del botón no puede divergir del 400
    // que devolvería el endpoint.
    const MIN = Number(textarea.dataset.min) || 25;
    const MAX = Number(textarea.dataset.max) || 600;

    // Placeholder rotativo
    let phIndex = 0;
    setInterval(() => {
      if (textarea.value === '') {
        phIndex = (phIndex + 1) % placeholders.length;
        textarea.placeholder = placeholders[phIndex];
      }
    }, 4500);

    // Char counter + glow
    textarea.addEventListener('input', (e: Event) => {
      const target = e.target as HTMLTextAreaElement | null;
      if (!target) return;
      const len = target.value.length;
      charCount.textContent = String(len);
      if (len >= MIN) {
        generateBtn.disabled = false;
        demoInput.classList.add('glow');
      } else {
        generateBtn.disabled = true;
        demoInput.classList.remove('glow');
      }
    });

    interface Propuesta {
      headline: string;
      dolor_identificado: string;
      solucion: string;
      stack: string[];
      timeline_dias: number;
      proyeccion_90d: string;
    }
    interface ApiResponse {
      sector_detectado: string;
      tier_recomendado: string;
      modulos_recomendados: string[];
      propuesta: Propuesta;
      rateLimit?: { remaining: number; limit: number; bypassed: boolean };
    }

    const escape = (s: string): string =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    // Catálogo para poder enlazar cada módulo recomendado a su página real.
    // Antes se listaban nombres internos de agentes, que no llevaban a ninguna
    // parte y no significaban nada para quien leía la propuesta.
    const NOMBRES: Record<string, string> = JSON.parse(
      document.getElementById('demo-modulos')?.textContent || '{}',
    );

    // El precio NO lo inventa el modelo: sale de la tabla oficial, en la
    // moneda que el visitante tenga elegida. Así la propuesta nunca puede
    // contradecir a la página de precios.
    const PRECIOS: Record<string, Record<string, number>> = JSON.parse(
      document.getElementById('demo-precios')?.textContent || '{}',
    );

    const renderPropuesta = (data: ApiResponse): string => {
      const p = data.propuesta;
      const modulos = (data.modulos_recomendados || [])
        .map((slug, i) => `<a href="/modulos/${encodeURIComponent(slug)}/" class="proposal-mod${i === 0 ? ' es-principal' : ''}">
            <strong>${escape(NOMBRES[slug] || slug)}</strong>
            ${i === 0 ? '<span>resuelve el problema central</span>' : ''}
          </a>`)
        .join('');
      const stack = p.stack.map((s) => `<span class="proposal-pill">${escape(s)}</span>`).join(' ');

      // Moneda activa · la misma que el visitante eligió en la cabecera.
      let moneda = 'EUR';
      try {
        const g = localStorage.getItem('zk-currency');
        if (g && PRECIOS[data.tier_recomendado]?.[g] !== undefined) moneda = g;
      } catch { /* sin localStorage se usa el default */ }
      const importe = PRECIOS[data.tier_recomendado]?.[moneda];
      const precioTxt = importe === undefined
        ? ''
        : new Intl.NumberFormat(moneda === 'EUR' ? 'es-ES' : moneda === 'COP' ? 'es-CO' : 'en-US', {
            style: 'currency', currency: moneda, maximumFractionDigits: 0,
          }).format(importe);
      return `
        <div class="proposal-card space-y-5">
          <div class="flex flex-wrap gap-2 items-center">
            <span class="proposal-meta">Sector · ${escape(data.sector_detectado)}</span>
            <span class="proposal-meta">Tier · ${escape(data.tier_recomendado)}</span>
          </div>
          <h3 class="text-2xl font-bold text-zk-text">${escape(p.headline)}</h3>
          <div class="proposal-block">
            <div class="proposal-label">Dolor identificado</div>
            <p class="text-zk-text2 text-sm">${escape(p.dolor_identificado)}</p>
          </div>
          <div class="proposal-block">
            <div class="proposal-label">Solución</div>
            <p class="text-zk-text2 text-sm">${escape(p.solucion)}</p>
          </div>
          <div class="proposal-block">
            <div class="proposal-label">Módulos que resuelven tu caso</div>
            <div class="proposal-mods">${modulos}</div>
          </div>
          <div class="grid sm:grid-cols-3 gap-3">
            <div class="proposal-block">
              <div class="proposal-label">Stack</div>
              <div class="flex flex-wrap gap-1.5">${stack}</div>
            </div>
            <div class="proposal-block">
              <div class="proposal-label">Puesta en marcha</div>
              <div class="text-zk-text font-semibold">${p.timeline_dias} días</div>
            </div>
            <div class="proposal-block">
              <div class="proposal-label">Plan recomendado</div>
              <div class="text-zk-text font-semibold">${escape(data.tier_recomendado)}</div>
              ${precioTxt ? `<div class="text-xs text-zk-text2 mt-1">desde ${precioTxt}/mes · <a href="/precios/" class="text-zk-growth hover:underline">ver planes</a></div>` : ''}
            </div>
          </div>
          <div class="proposal-block" style="background: linear-gradient(135deg, rgba(30,111,255,0.15), rgba(74,158,255,0.05)); border-color: rgba(74,158,255,0.4);">
            <div class="proposal-label" style="color: #4A9EFF;">Proyección a 90 días</div>
            <p class="text-zk-text">${escape(p.proyeccion_90d)}</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <a href="https://cal.com/zenkai-growth-systems/strategy-call" target="_blank" rel="noopener" class="btn-primary text-white font-semibold px-6 py-3 rounded-xl text-center text-sm">
              Comentarla con nosotros · 30 min
            </a>
            <button id="proposal-reset" class="text-sm font-mono text-zk-growth hover:underline">Probar otro negocio</button>
          </div>
        </div>
      `;
    };

    const reset = () => {
      demoProposal.innerHTML = '';
      demoProposal.classList.add('hidden');
      demoLoading.classList.add('hidden');
      demoError.classList.add('hidden');
      demoInput.classList.remove('hidden');
      textarea.value = '';
      charCount.textContent = '0';
      generateBtn.disabled = true;
      demoInput.classList.remove('glow');
      progressBar.style.width = '0%';
    };

    /**
     * Construye el link de WhatsApp con el brief del usuario ya escrito dentro.
     * Cada CTA lleva su propio ?text= identificando origen y contexto: es la única
     * forma de atribuir de dónde vino la conversación sin poner cookies.
     */
    const buildWaHref = (context: string, texto: string): string => {
      const number = demoError.dataset.waNumber || '34622874482';
      // 600 chars del textarea + preámbulo entra de sobra en el límite de wa.me.
      const msg = texto
        ? `Hola ZENKAI. Intenté generar mi propuesta en la web y no me cargó.\n\nEsto es lo que escribí:\n"${texto}"\n\n(origen: demo-web · ${context})`
        : `Hola ZENKAI. Intenté generar mi propuesta en la web y no me cargó.\n\n(origen: demo-web · ${context})`;
      return `https://wa.me/${number}?text=${encodeURIComponent(msg)}`;
    };

    /**
     * showError con fallback opcional a WhatsApp.
     *
     * Cuando el fallo es NUESTRO (5xx, red caída), el usuario ya invirtió el esfuerzo
     * de escribir el brief. Perderlo por un endpoint roto es perder un lead cualificado,
     * así que le ofrecemos el mismo brief ya cargado en un chat con un humano.
     * Cuando el fallo es del usuario (texto corto, captcha) no ofrecemos el fallback:
     * ahí lo correcto es que corrija y reintente.
     */
    const showError = (msg: string, waContext?: string, texto = '') => {
      demoLoading.classList.add('hidden');
      demoProposal.classList.add('hidden');
      demoError.classList.remove('hidden');
      demoErrorMsg.textContent = msg;

      const waCta = $<HTMLAnchorElement>('demo-error-wa');
      const waNote = $('demo-error-wa-note');
      if (!waCta || !waNote) return;
      if (waContext) {
        waCta.href = buildWaHref(waContext, texto);
        waCta.classList.remove('hidden');
        waNote.classList.remove('hidden');
      } else {
        waCta.classList.add('hidden');
        waNote.classList.add('hidden');
      }
    };

    retryBtn.addEventListener('click', () => {
      demoError.classList.add('hidden');
      demoInput.classList.remove('hidden');
    });

    // Detecta si el widget Turnstile está renderizado en el DOM.
    // Si lo está, exigimos token; si no, el backend hace fallback graceful (no-op).
    const turnstileWidget = $('turnstile-widget');
    const turnstileEnabled = !!turnstileWidget;

    interface TurnstileAPI {
      reset: (el?: HTMLElement | string) => void;
      getResponse: (el?: HTMLElement | string) => string | undefined;
    }
    const getTurnstile = (): TurnstileAPI | undefined =>
      (window as unknown as { turnstile?: TurnstileAPI }).turnstile;

    const readTurnstileToken = (): string | undefined => {
      if (!turnstileEnabled) return undefined;
      const api = getTurnstile();
      if (api && turnstileWidget) return api.getResponse(turnstileWidget);
      const tokenInput = document.querySelector<HTMLInputElement>(
        'input[name="cf-turnstile-response"]',
      );
      return tokenInput?.value || undefined;
    };

    const resetTurnstile = () => {
      if (!turnstileEnabled) return;
      const api = getTurnstile();
      if (api && turnstileWidget) api.reset(turnstileWidget);
    };

    generateBtn.addEventListener('click', async () => {
      const texto = textarea.value.trim();
      if (texto.length < MIN) return;

      const turnstileToken = readTurnstileToken();
      if (turnstileEnabled && !turnstileToken) {
        showError('Por favor resolvé el captcha antes de continuar. Si no aparece, recargá la página.');
        demoInput.classList.remove('hidden');
        return;
      }

      demoInput.classList.add('hidden');
      demoLoading.classList.remove('hidden');
      requestAnimationFrame(() => { progressBar.style.width = '100%'; });

      // Mantener mín 8s de loading aunque el endpoint sea más rápido (UX)
      const minLoading = new Promise((r) => setTimeout(r, 8000));
      const fetchPromise = fetch('/api/lead-demo', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          texto,
          ...(turnstileToken ? { turnstileToken } : {}),
        }),
      }).then(async (r) => ({ status: r.status, body: await r.json() }));

      try {
        const [{ status, body }] = await Promise.all([fetchPromise, minLoading]);
        if (status === 200) {
          demoProposal.innerHTML = renderPropuesta(body as ApiResponse);
          demoLoading.classList.add('hidden');
          demoProposal.classList.remove('hidden');
          const resetBtn = $('proposal-reset');
          if (resetBtn) resetBtn.addEventListener('click', reset);
        } else if (status === 429) {
          // Límite alcanzado: no es un fallo nuestro, pero el usuario sigue siendo un
          // lead válido y no tiene sentido hacerlo esperar una hora.
          showError('Llegaste al límite de 5 propuestas por hora.', 'rate-limit', texto);
        } else if (status === 403) {
          showError('Validación de seguridad falló. Recarga la página y prueba de nuevo.');
        } else if (status === 400) {
          showError(`El texto debe tener entre ${MIN} y ${MAX} caracteres.`);
        } else {
          showError('No pudimos generar tu propuesta ahora mismo. El problema es nuestro, no tuyo.', 'error-5xx', texto);
          console.error('[demo] unexpected status', status, body);
        }
      } catch (err) {
        // Incluye el caso histórico del 500 con cuerpo vacío (r.json() tiraba acá).
        showError('No pudimos conectar con el servidor.', 'network', texto);
        console.error('[demo] fetch failed', err);
      } finally {
        // Token Turnstile es single-use · resetear para próximo submit
        resetTurnstile();
      }
    });
  }
</script>
