---
// 4 ventajas técnicas en grid 2x2 · estático
interface Ventaja {
  title: string;
  iconSvg: string;
  bodyHtml: string;
}
const ventajas: Ventaja[] = [
  {
    title: 'Propuesta en 30 segundos',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
    bodyHtml: 'La competencia tarda <strong class="text-zk-text">48 horas a 2 semanas</strong> en mandarte cotización. Nosotros la generamos en lo que tardas en hacerte un café. Porque tenemos el sistema, no porque tomemos atajos.',
  },
  {
    title: 'Precios públicos y honestos',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
    bodyHtml: 'Nuestra fórmula es matemática: <span class="font-mono text-zk-text">costo trimestral × 2 = precio mínimo</span>. Publicamos precios porque no tenemos miedo a la competencia. Tenemos miedo a perderte por opacidad.',
  },
  {
    title: 'Stack abierto · no caja negra',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
    bodyHtml: 'Te decimos exactamente qué tecnología usamos. Si querés implementar con otra agencia <strong class="text-zk-text">la propuesta sigue siendo tuya</strong>. Sin secretos. Sin rehén tecnológico.',
  },
  {
    title: 'Garantía 30 días en plan Lite',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>',
    bodyHtml: 'Si después de 30 días no estás conforme con el plan Lite, te devolvemos el setup y cancelamos sin penalidad. Es un compromiso real, no marketing.',
  },
];
---
<section class="py-24 lg:py-32 border-t border-zk-border/50 relative">
  <div class="max-w-6xl mx-auto px-5 lg:px-8">

    <div class="text-center mb-14 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="text-xs font-mono text-zk-accent uppercase tracking-[0.2em]">Lo que nos hace distintos</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-5 leading-[1.05]">
        Cuatro ventajas técnicas<br>
        <span class="text-zk-text2">que ninguna agencia tradicional ofrece.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6 reveal">
      {ventajas.map((v) => (
        <div class="card-3d bg-gradient-to-br from-zk-surface to-zk-surface2 border border-zk-border2 rounded-2xl p-7 transition">
          <div class="w-12 h-12 rounded-xl bg-zk-accent/10 border border-zk-accent/30 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-zk-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" set:html={v.iconSvg}></svg>
          </div>
          <h3 class="text-xl font-bold mb-3">{v.title}</h3>
          <p class="text-zk-text2 leading-relaxed text-sm" set:html={v.bodyHtml}></p>
        </div>
      ))}
    </div>
  </div>
</section>
