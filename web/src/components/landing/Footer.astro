---
import Brand from './Brand.astro';
import WhatsAppCTA from '../WhatsAppCTA.astro';
import { PILARES, getModulosCore } from '../../lib/catalogo';

const pilares = PILARES;
const destacados = await getModulosCore();
---
<footer class="border-t border-zk-border bg-zk-bg2 relative overflow-hidden">

  <div class="relative max-w-7xl mx-auto px-5 lg:px-8 py-16">

    <div class="grid md:grid-cols-3 lg:grid-cols-6 gap-10 mb-12">

      <div class="lg:col-span-2">
        <a href="/" class="brand-link inline-flex items-center min-h-11 mb-5">
          <Brand variant="large" showTagline={true} />
        </a>
        <p class="text-sm text-zk-text2 leading-relaxed mb-6 max-w-sm">
          Construimos sistemas de IA que generan ventas, reducen costos y automatizan operaciones. Tu propuesta gratis en 30 segundos.
        </p>
        <div class="space-y-2 text-sm">
          {/* min-h-11 = 44px. Era el único enlace del pie que no llegaba al
              objetivo táctil: medía 20px de alto porque sólo lo definía la
              altura de línea del texto. */}
          <a href="mailto:hola@zenkai.systems" class="flex items-center gap-2 min-h-11 text-zk-text2 hover:text-zk-text transition group">
            <svg class="w-4 h-4 group-hover:text-zk-growth transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="font-mono">hola@zenkai.systems</span>
          </a>
        </div>
        {/* El enlace de WhatsApp sale del componente único, también aquí: así
            el clic desde el pie se atribuye igual que cualquier otro. */}
        <div class="mt-5">
          <WhatsAppCTA
            location="footer"
            message="Hola ZENKAI. Vengo del pie de la web y quiero contaros mi caso."
            label="+34 622 874 482"
            variant="inline"
          />
        </div>
      </div>

      {/* Los pilares salen de la colección: si se retira un módulo, el pie se
          entera solo. Antes había una lista escrita a mano que ya apuntaba a
          dos secciones inexistentes (#sectores, #diagrama-neural).
          Y todas las anclas son absolutas (/#id): una relativa no lleva a
          ningún sitio desde /modulos/sales-ai. */}
      <div>
        <div class="text-xs font-mono text-zk-muted uppercase tracking-wider mb-4">Soluciones</div>
        <ul class="space-y-2 text-sm">
          {pilares.map((p) => (
            <li><a href={`/soluciones/${p.id}/`} class="text-zk-text2 hover:text-zk-text transition">{p.nombre}</a></li>
          ))}
          <li><a href="/sectores/" class="text-zk-text2 hover:text-zk-text transition">Por sector</a></li>
          <li><a href="/#diagnostico" class="text-zk-text2 hover:text-zk-text transition">No sé cuál necesito</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-mono text-zk-muted uppercase tracking-wider mb-4">Módulos</div>
        <ul class="space-y-2 text-sm">
          {destacados.map((m) => (
            <li><a href={`/modulos/${m.id}/`} class="text-zk-text2 hover:text-zk-text transition">{m.data.nombre}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <div class="text-xs font-mono text-zk-muted uppercase tracking-wider mb-4">Productos</div>
        <ul class="space-y-2 text-sm">
          <li><a href="https://comercial.zenkai.systems" class="text-zk-text2 hover:text-zk-text transition" target="_blank" rel="noopener">Motor Comercial</a></li>
          <li><a href="https://atiendeai.com" class="text-zk-text2 hover:text-zk-text transition" target="_blank" rel="noopener">AtiendeAI</a></li>
          <li><a href="https://aurafact.com" class="text-zk-text2 hover:text-zk-text transition" target="_blank" rel="noopener">AuraFact</a></li>
          <li><a href="/#ecosistema" class="text-zk-text2 hover:text-zk-text transition">Social Automation</a></li>
          <li><a href="/#ecosistema" class="text-zk-text2 hover:text-zk-text transition">AI Agency Core</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-mono text-zk-muted uppercase tracking-wider mb-4">Empresa</div>
        <ul class="space-y-2 text-sm">
          <li><a href="/como-trabajamos/" class="text-zk-text2 hover:text-zk-text transition">Como trabajamos</a></li>
          <li><a href="/casos/" class="text-zk-text2 hover:text-zk-text transition">Resultados</a></li>
          <li><a href="/precios/" class="text-zk-text2 hover:text-zk-text transition">Precios</a></li>
          <li><a href="/#transparencia" class="text-zk-text2 hover:text-zk-text transition">RGPD y AI Act</a></li>
          <li><a href="/#faq" class="text-zk-text2 hover:text-zk-text transition">Preguntas frecuentes</a></li>
          <li><a href="/privacy" class="text-zk-text2 hover:text-zk-text transition">Politica de privacidad</a></li>
        </ul>
      </div>

    </div>

      <div class="border-t border-zk-border pt-6 flex flex-col sm:flex-row justify-between gap-4 text-sm text-zk-muted">
        <div>&copy; 2026 ZENKAI Growth Systems</div>
        <div class="font-mono text-xs">AI Infrastructure</div>
    </div>
  </div>
</footer>

<style>
  .brand-link {
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .brand-link:hover { opacity: 0.85; }
</style>
