---
/**
 * ZENKAI Core Hero — AI Business Infrastructure.
 *
 * Sin precio. Sin "agencia". Sin "500€".
 * Posicionamiento: AI Infrastructure + Enterprise.
 *
 * Visual: ZENKAI CORE como sistema nervioso empresarial.
 * Canvas interactivo con nodos, conexiones, pulso de actividad.
 */
import WhatsAppCTA from '../WhatsAppCTA.astro';
---

<section class="zh-root">
  <div class="zh-grid" aria-hidden="true"></div>
  <div class="zh-atmos" aria-hidden="true"></div>
  <canvas class="zh-canvas" id="zh-canvas" aria-hidden="true"></canvas>

  <div class="zh-content">
    <div class="zh-eyebrow reveal">AI Business Infrastructure</div>
    <h1 class="zh-h1 reveal">
      Your business,<br />
      <span class="zh-grad">powered by AI.</span>
    </h1>
    <p class="zh-sub reveal">
      ZENKAI connects sales, customer service and operations into one intelligent system
      that works across the tools you already use.
    </p>
    <div class="zh-ctas reveal">
      <a href="#diagnostico" class="zh-primary">
        Build my AI system
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#ecosistema" class="zh-secondary-link">Explore the platform</a>
    </div>
    <div class="zh-tags reveal">
      <span>AI Agents</span>
      <span>Automation</span>
      <span>Memory</span>
      <span>Integrations</span>
      <span>Analytics</span>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('zh-canvas') as HTMLCanvasElement;
  if (!canvas) throw new Error('CoreHero: canvas missing');
  const ctx = canvas.getContext('2d')!;
  const mqReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (mqReduced.matches) { canvas.style.opacity = '0.12'; }

  const isMobile = window.innerWidth < 768;
  let w = 0, h = 0, cx = 0, cy = 0;
  let mouseX = -1000, mouseY = -1000, targetMX = -1000, targetMY = -1000;
  let time = 0, animId = 0, hoveredNode = -1;

  const nodes = [
    { id: 'sales', x: 0.18, y: 0.22 }, { id: 'marketing', x: 0.32, y: 0.12 },
    { id: 'commerce', x: 0.50, y: 0.06 }, { id: 'creative', x: 0.68, y: 0.12 },
    { id: 'customer', x: 0.82, y: 0.22 }, { id: 'knowledge', x: 0.88, y: 0.42 },
    { id: 'operations', x: 0.82, y: 0.62 }, { id: 'intelligence', x: 0.68, y: 0.78 },
    { id: 'finance', x: 0.50, y: 0.86 }, { id: 'hr', x: 0.32, y: 0.78 },
    { id: 'security', x: 0.18, y: 0.62 }, { id: 'enterprise', x: 0.12, y: 0.42 },
  ].map(n => ({ ...n, rx: 0, ry: 0, r: 0, pulse: Math.random() * Math.PI * 2, ps: 0.02 + Math.random() * 0.03 }));

  const labels: Record<string, string> = {
    sales: 'Sales AI', marketing: 'Marketing AI', commerce: 'Commerce AI',
    creative: 'Creative AI', customer: 'Customer AI', knowledge: 'Knowledge AI',
    operations: 'Operations AI', intelligence: 'Intelligence AI', finance: 'Finance AI',
    hr: 'HR AI', security: 'Security AI', enterprise: 'Enterprise AI',
  };

  const descs: Record<string, string> = {
    sales: 'Prospect, qualify, close', marketing: 'Autonomous campaigns',
    commerce: 'Store & payments', customer: '24/7 support',
    operations: 'Smart workflows', intelligence: 'Analytics & insights',
  };

  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    w = rect.width; h = rect.height;
    canvas.width = w * devicePixelRatio;
    canvas.height = h * devicePixelRatio;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    cx = w * 0.5; cy = h * 0.44;
    nodes.forEach(n => { n.rx = n.x * w; n.ry = n.y * h; n.r = isMobile ? 4 : 5.5; });
  }

  function draw(t: number) {
    if (mqReduced.matches) { animId = requestAnimationFrame(draw); return; }
    time = t * 0.001; animId = requestAnimationFrame(draw);
    mouseX += (targetMX - mouseX) * 0.06;
    mouseY += (targetMY - mouseY) * 0.06;
    ctx.clearRect(0, 0, w, h);

    // Conexiones
    hoveredNode = -1; let md = Infinity;
    nodes.forEach((n, i) => { const d = Math.hypot(mouseX - n.rx, mouseY - n.ry); if (d < n.r * 5 && d < md) { md = d; hoveredNode = i; } });
    nodes.forEach((n, i) => {
      const hov = i === hoveredNode;
      const a = hov ? 1 : (hoveredNode >= 0 ? 0.12 : 0.22);
      ctx.beginPath(); ctx.moveTo(cx, cy);
      const mx = (cx + n.rx) / 2 + Math.sin(time * 0.5 + i) * 5;
      const my = (cy + n.ry) / 2 + Math.cos(time * 0.4 + i) * 5;
      ctx.quadraticCurveTo(mx, my, n.rx, n.ry);
      ctx.strokeStyle = `rgba(99,138,255,${a * 0.14})`;
      ctx.lineWidth = hov ? 1.5 : 0.6;
      ctx.stroke();
      n.pulse += n.ps;
      const pt = n.pulse % 1, px = cx + (n.rx - cx) * pt, py = cy + (n.ry - cy) * pt;
      ctx.beginPath(); ctx.arc(px, py, hov ? 2.5 : 1.4, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(99,138,255,${hov ? 0.65 : 0.2})`;
      ctx.fill();
    });

    // Nodos perifericos
    nodes.forEach((n, i) => {
      const hov = i === hoveredNode;
      const nr = hov ? n.r * 1.7 : n.r;
      ctx.beginPath(); ctx.arc(n.rx, n.ry, nr, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(99,138,255,${hov ? 0.16 : 0.06})`; ctx.fill();
      ctx.strokeStyle = `rgba(99,138,255,${hov ? 0.45 : 0.14})`;
      ctx.lineWidth = hov ? 1.4 : 0.7; ctx.stroke();
      if (hov) {
        ctx.font = '11px "Geist Variable", system-ui, sans-serif';
        ctx.fillStyle = 'rgba(245,245,250,0.9)'; ctx.fillText(labels[n.id] || n.id, n.rx + 9, n.ry - 5);
        ctx.font = '10px "Geist Variable", system-ui, sans-serif';
        ctx.fillStyle = 'rgba(180,180,200,0.65)'; ctx.fillText(descs[n.id] || '', n.rx + 9, n.ry + 9);
      }
    });

    // ZENKAI CORE
    const cr = isMobile ? 12 : 16, br = 1 + Math.sin(time * 0.7) * 0.07;
    const crr = cr * br;
    ctx.beginPath(); ctx.arc(cx, cy, crr, 0, Math.PI * 2);
    const g = ctx.createRadialGradient(cx, cy, crr * 0.3, cx, cy, crr * 3);
    g.addColorStop(0, 'rgba(99,138,255,0.18)'); g.addColorStop(1, 'rgba(99,138,255,0)');
    ctx.fillStyle = g; ctx.fill();
    ctx.beginPath(); ctx.arc(cx, cy, crr, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(99,138,255,0.14)'; ctx.fill();
    ctx.strokeStyle = 'rgba(99,138,255,0.4)'; ctx.lineWidth = 1.8; ctx.stroke();
  }

  resize(); window.addEventListener('resize', resize);
  canvas.addEventListener('mousemove', (e: MouseEvent) => { const r = canvas.getBoundingClientRect(); targetMX = e.clientX - r.left; targetMY = e.clientY - r.top; }, { passive: true });
  animId = requestAnimationFrame(draw);
  document.addEventListener('astro:before-swap', () => { cancelAnimationFrame(animId); window.removeEventListener('resize', resize); });
</script>

<style>
  .zh-root {
    position: relative; min-height: 100vh; min-height: 100dvh;
    display: flex; align-items: center; overflow: hidden; background: #06060A;
  }
  .zh-grid {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image: linear-gradient(rgba(99,138,255,0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(99,138,255,0.022) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 44%, black 25%, transparent 65%);
  }
  .zh-atmos {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse 50% 40% at 50% 38%, rgba(99,138,255,0.10) 0%, transparent 60%),
                radial-gradient(ellipse 30% 25% at 75% 35%, rgba(139,92,246,0.05) 0%, transparent 50%);
  }
  .zh-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
  .zh-content { position: relative; z-index: 3; max-width: 48rem; margin-inline: auto; padding: 2rem 1.5rem; text-align: center; }
  .zh-eyebrow {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(99, 138, 255, 0.7); margin-bottom: 1rem;
  }
  .zh-h1 {
    font-family: var(--font-display); font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700; letter-spacing: -0.035em; line-height: 1.06;
    color: var(--zk-heading, #f5f5fa); margin-bottom: 1rem; text-wrap: balance;
  }
  .zh-grad {
    background: linear-gradient(135deg, #638AFF 0%, #8B5CF6 50%, #A78BFA 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .zh-sub {
    font-size: 1.0625rem; line-height: 1.6; color: var(--zk-text2, #a1a1aa);
    max-width: 36rem; margin-inline: auto; margin-bottom: 1.75rem;
  }
  .zh-ctas { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1.5rem; }
  .zh-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.75rem 1.5rem; border-radius: 0.5rem;
    background: linear-gradient(135deg, #638AFF, #4A6FEF); color: #fff;
    font-size: 0.9375rem; font-weight: 600; text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(99,138,255,0.25);
  }
  .zh-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(99,138,255,0.35); }
  .zh-secondary-link { font-size: 0.875rem; color: var(--zk-muted, #a1a1aa); text-decoration: none; transition: color 0.2s; }
  .zh-secondary-link:hover { color: #fff; }
  .zh-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
  .zh-tags span {
    font-family: var(--font-mono); font-size: 0.6875rem; color: rgba(99,138,255,0.5);
    padding: 0.25rem 0.65rem; border: 1px solid rgba(99,138,255,0.12); border-radius: 0.25rem;
  }
  @media (max-width: 768px) {
    .zh-content { padding: 4rem 1.25rem; }
    .zh-h1 { font-size: clamp(2rem, 8vw, 2.75rem); }
    .zh-ctas { flex-direction: column; }
  }
</style>
