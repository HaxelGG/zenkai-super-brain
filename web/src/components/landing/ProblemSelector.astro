---
/**
 * ProblemSelector — "¿Qué está frenando tu crecimiento?"
 *
 * 4 opciones interactivas. Al hacer clic se expanden mostrando:
 * - Consecuencias del problema
 * - Módulos que lo resuelven
 * - CTA directo
 *
 * Sin JS: se muestran todas las opciones en modo resumen.
 */
import WhatsAppCTA from '../WhatsAppCTA.astro';

const problemas = [
  {
    id: 'perdiendo',
    titulo: 'Estamos perdiendo clientes',
    icono: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
    consecuencias: 'Consultas sin respuesta, leads que se enfrían, competidores que responden más rápido.',
    modulos: ['Sales AI', 'Marketing AI', 'Commerce AI'],
    cta: 'Automatizar ventas',
  },
  {
    id: 'atendiendo',
    titulo: 'No damos abasto atendiendo',
    icono: 'M7.9 20A9 9 0 1 0 4 16.1L2 22Z',
    consecuencias: 'Clientes esperando horas por una respuesta, WhatsApp saturado, equipo desbordado.',
    modulos: ['Customer AI', 'Knowledge AI', 'Operations AI'],
    cta: 'Automatizar atención',
  },
  {
    id: 'operando',
    titulo: 'La operación se come el margen',
    icono: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    consecuencias: 'Tareas manuales que consumen horas, procesos duplicados, ineficiencia que escala.',
    modulos: ['Operations AI', 'Finance AI', 'HR AI'],
    cta: 'Automatizar operaciones',
  },
  {
    id: 'midiendo',
    titulo: 'No sabemos qué está funcionando',
    icono: 'M12 5a3 3 0 1 0-5.997.125A4 4 0 0 0 3.477 10.896 4 4 0 0 0 4.033 17.484A3 3 0 1 0 12 18Z M12 5a3 3 0 1 1 5.997.125A4 4 0 0 1 20.523 10.896a4 4 0 0 1-.556 6.588A3 3 0 1 1 12 18Z M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4',
    consecuencias: 'Decisiones a ciegas, sin datos, sin dashboards, sin capacidad de predecir.',
    modulos: ['Intelligence AI', 'Knowledge AI', 'Enterprise AI'],
    cta: 'Activar inteligencia',
  },
];
---

<section class="band" id="diagnostico" aria-labelledby="prob-titulo">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Diagnóstico</p>
      <h2 id="prob-titulo" class="h2">
        ¿Qué está frenando<br />
        <span class="text-gradient">el crecimiento?</span>
      </h2>
    </div>

    <div class="prob-grid reveal-stagger" id="prob-grid">
      {problemas.map((p) => (
        <button class="prob-card" data-prob={p.id} aria-expanded="false">
          <div class="prob-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={p.icono}/></svg>
          </div>
          <h3 class="prob-card__title">{p.titulo}</h3>
          <div class="prob-card__expand">
            <p class="prob-card__cons">{p.consecuencias}</p>
            <div class="prob-card__modulos">
              {p.modulos.map((m) => (
                <span class="prob-pill">{m}</span>
              ))}
            </div>
            <div class="prob-card__cta-wrap">
              <WhatsAppCTA location={`problema-${p.id}`} message={`Hola ZENKAI. ${p.titulo.toLowerCase()}.`} label={p.cta} variant="inline" />
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.prob-card').forEach(card => {
    card.addEventListener('click', () => {
      const wasOpen = card.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLButtonElement>('.prob-card').forEach(c => {
        c.setAttribute('aria-expanded', 'false');
      });
      if (!wasOpen) {
        card.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
  .band { padding-block: clamp(4rem, 8vw, 7rem); border-top: 1px solid rgba(255,255,255,0.04); }
  .wrap { max-width: 48rem; margin-inline: auto; padding-inline: 1.5rem; }

  .eyebrow {
    font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(99, 138, 255, 0.7); margin-bottom: 0.75rem; text-align: center;
  }
  .h2 {
    font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700; letter-spacing: -0.02em; line-height: 1.15;
    color: var(--zk-heading, #f5f5fa); text-align: center; margin-bottom: 2.5rem;
  }
  .text-gradient {
    background: linear-gradient(135deg, #638AFF 0%, #8B5CF6 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  .prob-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .prob-card {
    text-align: left;
    padding: 1.5rem;
    border-radius: 0.875rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.015);
    cursor: pointer;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
    font: inherit;
    color: inherit;
    width: 100%;
  }
  .prob-card:hover {
    border-color: rgba(99, 138, 255, 0.25);
    background: rgba(99, 138, 255, 0.03);
    transform: translateY(-1px);
  }
  .prob-card[aria-expanded="true"] {
    border-color: rgba(99, 138, 255, 0.35);
    background: rgba(99, 138, 255, 0.04);
  }

  .prob-card__icon {
    width: 2.5rem; height: 2.5rem; border-radius: 0.5rem;
    background: rgba(99, 138, 255, 0.08); color: #638AFF;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1rem;
    transition: background 0.3s;
  }
  .prob-card:hover .prob-card__icon { background: rgba(99, 138, 255, 0.14); }

  .prob-card__title {
    font-family: var(--font-display); font-size: 1.0625rem;
    font-weight: 600; color: var(--zk-heading, #f5f5fa);
    margin-bottom: 0.75rem;
  }

  .prob-card__expand {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .prob-card[aria-expanded="true"] .prob-card__expand { grid-template-rows: 1fr; }
  .prob-card__expand > * { overflow: hidden; }

  .prob-card__cons {
    font-size: 0.8125rem; line-height: 1.55; color: var(--zk-text2, #a1a1aa);
    margin: 0 0 0.75rem;
  }
  .prob-card__modulos {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .prob-pill {
    font-family: var(--font-mono); font-size: 0.6875rem;
    padding: 0.25rem 0.6rem; border-radius: 0.3rem;
    background: rgba(99, 138, 255, 0.08); color: #638AFF;
  }

  @media (max-width: 480px) {
    .prob-grid { grid-template-columns: 1fr; }
  }
</style>
