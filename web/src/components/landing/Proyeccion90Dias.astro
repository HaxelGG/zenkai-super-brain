---
// Proyección 90 días · 4 cards (día 7/30/60/90) en grid 2x2
interface Hito {
  dia: string;
  title: string;
  iconSvg: string;
  bodyHtml: string;
}
const hitos: Hito[] = [
  {
    dia: 'Día 7',
    title: 'Tu WhatsApp deja de ser un caos.',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>',
    bodyHtml: 'Cada cliente que escribe recibe respuesta en segundos. Mientras duermes, mientras estás en reunión, mientras es fin de semana. Tu agente IA conoce tu negocio, califica leads y agenda citas <strong class="text-zk-text">sin que tengas que tocar el teléfono</strong>.',
  },
  {
    dia: 'Día 30',
    title: 'Tu facturación empieza a crecer.',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>',
    bodyHtml: 'Cada lead recibe seguimiento. Cada cliente inactivo recibe un mensaje en el momento exacto. Cada carrito abandonado vuelve a tu radar. <strong class="text-zk-text">No se te escapa ninguna venta</strong> por falta de tiempo o memoria humana.',
  },
  {
    dia: 'Día 60',
    title: 'Tus costos operativos bajan.',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/>',
    bodyHtml: 'Lo que antes ocupaba a dos personas, ahora lo maneja un sistema. Reportes automatizados, seguimientos sin esfuerzo, calificación de clientes sin tu intervención. <strong class="text-zk-text">Tu equipo se enfoca en cerrar</strong>, no en perseguir.',
  },
  {
    dia: 'Día 90',
    title: 'Operas como una empresa 10x más grande.',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
    bodyHtml: 'Sin contratar más gente. Sin trabajar más horas. Tu negocio responde 24/7, opera multi-idioma, genera reportes automáticos y se sostiene solo. <strong class="text-zk-text">Esto es lo que se sentía siempre estar un paso adelante de la competencia.</strong>',
  },
];
---
<section id="proyeccion" class="relative py-24 lg:py-32 border-t border-zk-border/50 overflow-hidden">
  <div class="orb orb-1"></div>
  <div class="orb orb-3"></div>

  <div class="relative max-w-5xl mx-auto px-5 lg:px-8 z-10">

    <div class="text-center mb-16 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="text-xs font-mono text-zk-accent uppercase tracking-[0.2em]">Lo que viene</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6 leading-[1.05]">
        Imagina tu negocio<br>
        <span class="gradient-text">90 días desde hoy.</span>
      </h2>
      <p class="text-lg text-zk-text2 max-w-2xl mx-auto leading-relaxed">
        Esto no es marketing. Son los resultados que medimos en pilotos reales con IA empresarial — y los que vas a empezar a ver desde la <strong class="text-zk-text">semana 2</strong>.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 reveal mb-16">
      {hitos.map((h) => (
        <div class="card-3d bg-gradient-to-br from-zk-surface to-zk-surface2 border border-zk-border2 rounded-2xl p-7">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-12 h-12 rounded-2xl bg-zk-accent/10 border border-zk-accent/30 flex items-center justify-center">
              <svg class="w-6 h-6 text-zk-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={h.iconSvg}></svg>
            </div>
            <div class="text-xs font-mono text-zk-success uppercase tracking-wider">{h.dia}</div>
          </div>
          <h3 class="text-xl font-bold mb-3">{h.title}</h3>
          <p class="text-zk-text2 leading-relaxed text-sm" set:html={h.bodyHtml}></p>
        </div>
      ))}
    </div>

    <div class="text-center reveal">
      <a href="#hero-demo" class="btn-primary inline-flex items-center gap-2 text-white font-semibold px-7 py-3.5 rounded-xl">
        <span>Ver mi propuesta personalizada</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <p class="text-sm text-zk-muted mt-3">30 segundos · sin email · sin compromiso</p>
    </div>
  </div>
</section>
