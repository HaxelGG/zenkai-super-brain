---
/**
 * LeadCapture — Captura de leads con psicología del consumidor.
 *
 * Estrategia:
 * 1. Escasez: "Solo 5 ofertas disponibles esta semana"
 * 2. Curiosidad: "Oferta sorpresa" — no revela el descuento hasta que dejan el email
 * 3. Reciprocidad: "Te damos algo GRATIS antes de que compres"
 * 4. Urgencia: contador regresivo de tiempo limitado
 * 5. Baja fricción: solo nombre + email (ni teléfono, ni empresa)
 *
 * El formulario envía a /api/lead que guarda en n8n/Airtable
 * y dispara una secuencia de emails automática.
 */
---

<section class="band" id="oferta" aria-labelledby="lead-titulo">
  <div class="wrap">
    <div class="reveal">
      <div class="lead-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
        <span>Analisis personalizado gratuito</span>
      </div>

      <h2 id="lead-titulo" class="h2">
        Recibe tu<br />
        <span class="text-gradient">Informe de Oportunidades de IA.</span>
      </h2>
      <p class="lede">
        Descubre donde la IA podria ahorrar tiempo, reducir costes y generar ingresos en tu empresa.
        Gratis. Sin compromiso.
      </p>
    </div>

    <div class="lead-card reveal">
      <div class="lead-card__header">
        <div class="lead-card__gift">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="11" rx="1"/><path d="M12 8V22"/><path d="M8 8c0-2.2 1.8-4 4-4s4 1.8 4 4"/><path d="M3 12h18"/></svg>
        </div>
        <div>
        <h3 class="lead-card__title">Informe de Oportunidades de IA</h3>
        <p class="lead-card__subtitle">Analisis personalizado para tu empresa · Confidencial</p>
        </div>
      </div>

      <form id="lead-form" class="lead-form">
        <div class="lead-form__fields">
          <input
            type="text"
            name="nombre"
            id="lead-nombre"
            class="lead-input"
            placeholder="Tu nombre"
            required
            autocomplete="given-name"
          />
          <input
            type="email"
            name="email"
            id="lead-email"
            class="lead-input"
            placeholder="tu@email.com"
            required
            autocomplete="email"
          />
        </div>

        <button type="submit" class="lead-submit" id="lead-submit">
          <span>Generar mi informe</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>

        <div id="lead-success" class="lead-success" hidden>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
          <h4>Informe en camino</h4>
          <p>Tu Informe de Oportunidades de IA se esta generando. Revisa tu bandeja de entrada en unos minutos.</p>
        </div>
      </form>

      <div class="lead-trust">
        <span>Sin spam. Sin llamadas. Te das de baja cuando quieras.</span>
        <span class="lead-counter" id="lead-counter">Gratis · Confidencial · Sin compromiso</span>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const submitBtn = document.getElementById('lead-submit') as HTMLButtonElement;
  const success = document.getElementById('lead-success')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nombre = (document.getElementById('lead-nombre') as HTMLInputElement).value.trim();
    const email = (document.getElementById('lead-email') as HTMLInputElement).value.trim();
    if (!nombre || !email) return;

    submitBtn.setAttribute('disabled', '');
    submitBtn.innerHTML = '<span>Enviando...</span>';

    try {
      await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, email, fuente: 'ai-opportunity-report', pagina: location.pathname }),
      });
      // Track conversion
      try { window.va?.('event', { name: 'lead_captured', data: { source: 'oferta-sorpresa' } }); } catch {}
      form.querySelector('.lead-form__fields')!.setAttribute('hidden', '');
      submitBtn.setAttribute('hidden', '');
      success.removeAttribute('hidden');
    } catch {
      submitBtn.removeAttribute('disabled');
      submitBtn.innerHTML = '<span>Quiero la oferta sorpresa</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
      alert('Error al enviar. Prueba de nuevo o escríbenos por WhatsApp.');
    }
  });
</script>

<style>
  .band { padding-block: clamp(4rem, 8vw, 7rem); }
  .wrap { max-width: 48rem; margin-inline: auto; padding-inline: 1.5rem; }

  .lead-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.8125rem; font-weight: 600;
    color: #f59e0b;
    background: rgba(245,158,11,0.08);
    border: 1px solid rgba(245,158,11,0.2);
    padding: 0.4rem 0.9rem; border-radius: 2rem;
    margin-bottom: 1.25rem;
  }
  .h2 {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.15;
    color: var(--zk-heading, #f5f5fa); text-align: center; margin-bottom: 1rem;
  }
  .text-gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .lede {
    font-size: 1rem; line-height: 1.6; color: var(--zk-muted, #a1a1aa);
    text-align: center; max-width: 48rem; margin-inline: auto; margin-bottom: 2rem;
  }
  .lede strong { color: var(--zk-heading, #f5f5fa); font-weight: 600; }

  .lead-card {
    border: 1px solid rgba(245,158,11,0.2);
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(245,158,11,0.04) 0%, rgba(99,102,241,0.03) 100%);
    overflow: hidden;
  }
  .lead-card__header {
    display: flex; align-items: flex-start; gap: 1rem;
    padding: 1.5rem 1.5rem 1.25rem;
    border-bottom: 1px solid var(--zk-border, #1f1f2c);
  }
  .lead-card__gift {
    width: 48px; height: 48px; border-radius: 0.75rem;
    background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(245,158,11,0.05));
    color: #f59e0b; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .lead-card__title {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: 1.25rem; font-weight: 700; color: var(--zk-heading, #f5f5fa);
    margin-bottom: 0.2rem;
  }
  .lead-card__subtitle {
    font-size: 0.8125rem; color: var(--zk-muted, #a1a1aa); margin: 0;
  }

  .lead-form { padding: 1.5rem; }
  .lead-form__fields {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 480px) {
    .lead-form__fields { grid-template-columns: 1fr; }
  }
  .lead-input {
    padding: 0.75rem 1rem; border-radius: 0.5rem;
    border: 1px solid var(--zk-border, #1f1f2c);
    background: rgba(255,255,255,0.03); color: var(--zk-text, #e4e4e7);
    font-size: 0.9375rem; outline: none; width: 100%; box-sizing: border-box;
    transition: border-color 0.2s;
  }
  .lead-input:focus { border-color: var(--zk-accent, #6366f1); }
  .lead-input::placeholder { color: var(--zk-muted, #52525b); }

  .lead-submit {
    width: 100%; padding: 0.9rem 1.5rem; border-radius: 0.75rem; border: none;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #0f172a; font-size: 1rem; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    gap: 0.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(245,158,11,0.3);
  }
  .lead-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(245,158,11,0.4);
  }
  .lead-submit:active { transform: scale(0.98); }
  .lead-submit[disabled] { opacity: 0.6; cursor: not-allowed; }

  .lead-success {
    text-align: center; padding: 1rem 0;
    animation: leadFadeIn 0.5s ease;
  }
  @keyframes leadFadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: none; } }
  .lead-success h4 {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: 1.125rem; font-weight: 700;
    color: var(--zk-heading, #f5f5fa); margin: 0.75rem 0 0.5rem;
  }
  .lead-success p {
    font-size: 0.875rem; color: var(--zk-muted, #a1a1aa); margin: 0;
  }

  .lead-trust {
    display: flex; flex-direction: column; align-items: center; gap: 0.25rem;
    padding: 1rem 1.5rem 1.25rem;
    border-top: 1px solid var(--zk-border, #1f1f2c);
    font-size: 0.75rem; color: var(--zk-muted, #52525b);
  }
  .lead-counter {
    color: #f59e0b; font-weight: 500; font-size: 0.8125rem;
  }
</style>
