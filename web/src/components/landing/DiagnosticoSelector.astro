---
/**
 * Selector de diagnóstico · la capa 1 de la arquitectura del catálogo.
 *
 * Sustituye a la cuadrícula de productos. El visitante no llega buscando
 * "Knowledge AI": llega con un problema y no sabe cómo se llama la solución.
 * Aquí elige un síntoma en su idioma y recibe 2-3 módulos y un WhatsApp con
 * ese contexto ya escrito.
 *
 * Implementado como tabs accesibles (roving tabindex, flechas, Home/End) sin
 * framework: son ~40 líneas de JS y no justifica una isla hidratada.
 */
import { DIAGNOSTICOS, getModulosDeDiagnostico } from '../../lib/catalogo';
import WhatsAppCTA from '../WhatsAppCTA.astro';

const paneles = await Promise.all(
  DIAGNOSTICOS.map(async (dx) => ({ dx, modulos: await getModulosDeDiagnostico(dx) })),
);
---
<section id="diagnostico" class="dx">
  <div class="dx__wrap">
    <header class="dx__head">
      <p class="eyebrow">Empieza por aquí</p>
      <h2>¿Qué te está costando más dinero ahora mismo?</h2>
      <p class="dx__lede">
        Elige lo que más se parezca a tu situación. Te decimos por dónde se empieza
        — y si no encaja nada, nos lo cuentas y ya está.
      </p>
    </header>

    <div class="dx__tabs" role="tablist" aria-label="Diagnóstico">
      {paneles.map(({ dx }, i) => (
        <button
          type="button"
          role="tab"
          id={`dx-tab-${dx.id}`}
          aria-controls={`dx-panel-${dx.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class:list={['dx__tab', i === 0 && 'is-active']}
        >{dx.etiqueta}</button>
      ))}
    </div>

    {paneles.map(({ dx, modulos }, i) => (
      <div
        role="tabpanel"
        id={`dx-panel-${dx.id}`}
        aria-labelledby={`dx-tab-${dx.id}`}
        hidden={i !== 0}
        class="dx__panel"
      >
        <p class="dx__lectura">{dx.lectura}</p>

        <ul class="dx__modulos">
          {modulos.map((m) => (
            <li>
              <a href={`/modulos/${m.id}/`} class="dx__card" data-dominio={m.data.dominio}>
                <h3>{m.data.nombre}</h3>
                <p>{m.data.titular}</p>
                <span class="dx__mas">Ver módulo →</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="dx__cta">
          <WhatsAppCTA
            location="home-diagnostico"
            context={dx.id}
            message={dx.whatsapp}
            label="Contarlo por WhatsApp"
            size="lg"
          />
          <p class="dx__nota">Contesta una persona. Sin formulario y sin llamada comercial.</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .dx { padding-block: 5rem; border-top: 1px solid var(--zk-border); }
  .dx__wrap { max-width: 64rem; margin: 0 auto; padding-inline: 1.25rem; }
  @media (min-width: 1024px) { .dx__wrap { padding-inline: 2rem; } }

  .dx__head { max-width: 44rem; margin-bottom: 2.5rem; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 0.6875rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--zk-growth); margin: 0 0 1rem;
  }
  .dx__head h2 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.1; letter-spacing: -0.02em; font-weight: 700;
    margin: 0 0 1rem; text-wrap: balance;
  }
  .dx__lede { color: var(--zk-text-2); margin: 0; max-width: 52ch; }

  .dx__tabs { display: grid; gap: 0.625rem; margin-bottom: 1.75rem; }
  @media (min-width: 720px) { .dx__tabs { grid-template-columns: repeat(2, 1fr); } }

  .dx__tab {
    display: flex; align-items: center;
    min-height: 56px; padding: 0.875rem 1.125rem;
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-md);
    background: var(--zk-surface);
    color: var(--zk-text-2);
    font: inherit; font-size: 0.9375rem; font-weight: 500;
    text-align: left; cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .dx__tab:hover { color: var(--zk-text); border-color: var(--zk-border-hi); }
  .dx__tab.is-active {
    color: var(--zk-text);
    border-color: var(--zk-growth);
    background: color-mix(in srgb, var(--zk-growth) 10%, var(--zk-surface));
  }
  .dx__tab:focus-visible { outline: 2px solid var(--zk-growth); outline-offset: 2px; }

  .dx__panel {
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 55%),
      var(--zk-bg-2);
    padding: 1.75rem;
  }
  @media (min-width: 720px) { .dx__panel { padding: 2.25rem; } }

  .dx__lectura {
    font-size: 1.0625rem; line-height: 1.6;
    color: var(--zk-text); margin: 0 0 1.75rem; max-width: 62ch;
    text-wrap: pretty;
  }

  .dx__modulos { list-style: none; margin: 0 0 1.75rem; padding: 0; display: grid; gap: 0.75rem; }
  @media (min-width: 640px) { .dx__modulos { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); } }

  .dx__card {
    display: flex; flex-direction: column; height: 100%;
    padding: 1.125rem;
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-md);
    background: var(--zk-surface);
    text-decoration: none; color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .dx__card:hover {
    border-color: color-mix(in srgb, var(--zk-accent) 50%, transparent);
    transform: translateY(-2px);
  }
  .dx__card:focus-visible { outline: 2px solid var(--zk-accent); outline-offset: 3px; }
  .dx__card h3 { font-size: 0.9375rem; font-weight: 700; margin: 0 0 0.375rem; color: var(--zk-accent); }
  .dx__card p { font-size: 0.8125rem; line-height: 1.5; color: var(--zk-text-2); margin: 0 0 0.875rem; flex: 1; }
  .dx__mas { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; color: var(--zk-muted); }

  .dx__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.875rem 1.25rem; }
  .dx__nota { font-size: 0.8125rem; color: var(--zk-muted); margin: 0; }

  @media (prefers-reduced-motion: reduce) { .dx__card:hover { transform: none; } }
</style>

<script>
  const tablist = document.querySelector<HTMLElement>('.dx__tabs');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const activar = (tab: HTMLButtonElement, mover = true) => {
      tabs.forEach((t) => {
        const activo = t === tab;
        t.setAttribute('aria-selected', String(activo));
        t.tabIndex = activo ? 0 : -1;
        t.classList.toggle('is-active', activo);
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !activo;
      });
      if (mover) tab.focus();
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activar(tab, false));
    });

    tablist.addEventListener('keydown', (e: KeyboardEvent) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i === -1) return;
      const destino =
        e.key === 'ArrowRight' || e.key === 'ArrowDown' ? (i + 1) % tabs.length
        : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? (i - 1 + tabs.length) % tabs.length
        : e.key === 'Home' ? 0
        : e.key === 'End' ? tabs.length - 1
        : -1;
      if (destino === -1) return;
      e.preventDefault();
      activar(tabs[destino]);
    });
  }
</script>
