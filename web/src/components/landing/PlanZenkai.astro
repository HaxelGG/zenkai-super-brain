---
/**
 * Plan Zenkai.
 * Un solo plan. Un solo precio. Todo incluido. Sin letra pequeña.
 */
import WhatsAppCTA from '../WhatsAppCTA.astro';

const todo = [
  'Web profesional o Tienda Online (la que necesites)',
  'CRM con pipeline de ventas y seguimiento de clientes',
  'Agente de Ventas IA que prospecta y califica leads',
  'Atención al Cliente 24/7 por WhatsApp, web y redes',
  'Agente de Facturación que emite y cobra facturas',
  'Agenda inteligente que organiza citas y recordatorios',
  'Diagnóstico de Marketing Digital con plan de acción',
  'Diagnóstico Empresarial completo con recomendaciones IA',
];
---

<section class="band" id="plan" aria-labelledby="plan-titulo">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Un solo plan</p>
      <h2 id="plan-titulo" class="h2">
        Todo lo que tu empresa necesita.<br />
        <span class="text-gradient">Un precio. Sin sorpresas.</span>
      </h2>
      <p class="lede">
        No vendemos módulos sueltos ni te cobramos por cada cosa. Esto es un sistema completo.
        Lo montamos, lo mantenemos y lo mejoramos. Tú te concentras en tu negocio.
      </p>
    </div>

    <div class="plan-card reveal">
      <div class="plan-card__header">
        <div>
          <h3 class="plan-card__nombre">Plan Zenkai</h3>
          <p class="plan-card__subtitulo">Sistema Digital Completo</p>
        </div>
        <div class="plan-card__precio">
          <span class="plan-card__setup">500€</span>
          <span class="plan-card__setup-label">pago único de implementación</span>
        </div>
      </div>

      <div class="plan-card__body">
        <ul class="plan-card__lista">
          {todo.map((item) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="plan-card__footer">
        <div class="plan-card__mensual">
          <span class="plan-card__mensual-precio">95€<span class="plan-card__mensual-periodo">/mes</span></span>
          <span class="plan-card__mensual-label">mantenimiento, mejoras y soporte</span>
        </div>
        <div class="plan-card__cta">
          <WhatsAppCTA
            location="plan"
            message="Hola ZENKAI. Quiero el Plan Zenkai para mi empresa. Contadme más."
            label="Quiero el Plan Zenkai"
            variant="block"
            size="lg"
          />
        </div>
        <p class="plan-card__garantia">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          Garantía de devolución: si en 14 días no ves resultados, te devolvemos los 500€.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: 5rem;
  }

  .wrap {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--zk-accent, #6366f1);
    margin-bottom: 0.75rem;
    text-align: center;
  }

  .h2 {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--zk-heading, #f5f5fa);
    text-align: center;
    margin-bottom: 1rem;
  }

  .text-gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .lede {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--zk-muted, #a1a1aa);
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .plan-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(99, 138, 255, 0.04) 0%, rgba(139, 92, 246, 0.02) 100%);
    overflow: hidden;
  }

  .plan-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.75rem 1.75rem 1.25rem;
    border-bottom: 1px solid var(--zk-border, #1f1f2c);
  }

  .plan-card__nombre {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--zk-heading, #f5f5fa);
    margin-bottom: 0.25rem;
  }

  .plan-card__subtitulo {
    font-size: 0.875rem;
    color: var(--zk-muted, #a1a1aa);
    margin: 0;
  }

  .plan-card__precio {
    text-align: right;
    flex-shrink: 0;
  }

  .plan-card__setup {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--zk-heading, #f5f5fa);
    line-height: 1;
    display: block;
  }

  .plan-card__setup-label {
    font-size: 0.7rem;
    color: var(--zk-muted, #71717a);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .plan-card__body {
    padding: 1.5rem 1.75rem;
  }

  .plan-card__lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .plan-card__lista li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--zk-text, #d4d4d8);
  }

  .plan-card__lista svg {
    color: #22c55e;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .plan-card__footer {
    padding: 1.5rem 1.75rem 1.75rem;
    border-top: 1px solid var(--zk-border, #1f1f2c);
    text-align: center;
  }

  .plan-card__mensual {
    margin-bottom: 1.25rem;
  }

  .plan-card__mensual-precio {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--zk-heading, #f5f5fa);
  }

  .plan-card__mensual-periodo {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--zk-muted, #a1a1aa);
  }

  .plan-card__mensual-label {
    display: block;
    font-size: 0.8125rem;
    color: var(--zk-muted, #71717a);
    margin-top: 0.15rem;
  }

  .plan-card__cta {
    margin-bottom: 0.75rem;
  }

  .plan-card__garantia {
    font-size: 0.8125rem;
    color: #22c55e;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  @media (max-width: 480px) {
    .plan-card__header {
      flex-direction: column;
    }
    .plan-card__precio {
      text-align: left;
    }
  }
</style>
