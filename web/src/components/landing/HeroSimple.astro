---
/**
 * Hero Simple.
 * Un empresario debe entender en 5 segundos qué hacemos, cuánto cuesta y qué gana.
 * Nada de buzzwords. Nada de párrafos largos. Una promesa clara y un botón.
 */
import WhatsAppCTA from '../WhatsAppCTA.astro';
import ParticleField from './ParticleField.astro';

const incluido = [
  { icono: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4', texto: 'Web o Tienda Online' },
  { icono: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2 M23 21v-2a4 4 0 00-3-3.87 M16 3.13a4 4 0 010 7.75', texto: 'CRM inteligente' },
  { icono: 'M12 5a3 3 0 1 0-5.997.125A4 4 0 0 0 3.477 10.896 4 4 0 0 0 4.033 17.484A3 3 0 1 0 12 18Z M12 5a3 3 0 1 1 5.997.125A4 4 0 0 1 20.523 10.896a4 4 0 0 1-.556 6.588A3 3 0 1 1 12 18Z M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4', texto: 'Agente de Ventas IA' },
  { icono: 'M7.9 20A9 9 0 1 0 4 16.1L2 22Z', texto: 'Atención al Cliente 24/7' },
  { icono: 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8', texto: 'Agente de Facturación' },
  { icono: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', texto: 'Agenda Automatizada' },
  { icono: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z', texto: 'Diagnóstico de Marketing' },
];
---

<section class="hero">
  <ParticleField />
  <div class="hero__wrap">
    <div class="hero__badge reveal">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 14a1 1 0 01-.78-1.63l9.9-10.2a.5.5 0 01.86.46l-1.92 6.02A1 1 0 0013 10h7a1 1 0 01.78 1.63l-9.9 10.2a.5.5 0 01-.86-.46l1.92-6.02A1 1 0 0011 14H4z"/></svg>
      <span>Operativo en 7 días</span>
    </div>

    <h1 class="hero__h1 reveal">
      Tu empresa funcionando<br />
      <span class="hero__grad">con inteligencia artificial</span><br />
      sin que tengas que tocar nada.
    </h1>

    <p class="hero__sub reveal">
      Te montamos todo el sistema digital de tu negocio por <strong>500€</strong>.
      Luego <strong>95€ al mes</strong> y lo mantenemos nosotros. Tú solo te preocupas de vender.<br />
      <span class="hero__sectores">Clínicas, restaurantes, ecommerce, inmobiliarias, agencias y más.</span>
    </p>

    <div class="hero__ctas reveal">
      <WhatsAppCTA
        location="hero"
        message="Hola ZENKAI. Quiero el sistema completo para mi empresa."
        label="Quiero mi sistema de IA"
        size="lg"
      />
    </div>

    <div class="hero__secundarios reveal">
      <a href="#plan" class="hero__link-sec">Ver qué incluye el plan &darr;</a>
      <span class="hero__urgencia">Siguiente implantación: <strong>lunes que viene</strong></span>
    </div>

    <div class="hero__incluido reveal-stagger">
      <p class="hero__incluye-label">Incluye:</p>
      <ul class="hero__incluye-list">
        {incluido.map((item) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icono}/></svg>
            <span>{item.texto}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 10vh, 7rem) clamp(2rem, 5vh, 4rem);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(99,102,241,0.08) 0%, transparent 60%),
                radial-gradient(ellipse 40% 30% at 80% 80%, rgba(168,85,247,0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__wrap {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--zk-accent, #6366f1);
    background: rgba(99,102,241,0.1);
    border: 1px solid rgba(99,102,241,0.2);
    padding: 0.35rem 0.9rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
  }

  .hero__h1 {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--zk-heading, #f5f5fa);
    margin-bottom: 1.25rem;
  }

  .hero__grad {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 60%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__sub {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--zk-muted, #a1a1aa);
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .hero__sub strong {
    color: var(--zk-heading, #f5f5fa);
    font-weight: 600;
  }

  .hero__sectores {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--zk-muted, #71717a);
  }

  .hero__ctas { margin-bottom: 1rem; }

  .hero__secundarios {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__link-sec {
    font-size: 0.875rem;
    color: var(--zk-accent, #6366f1);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 1rem;
    transition: color 0.2s;
  }
  .hero__link-sec:hover { color: #818cf8; }

  .hero__urgencia {
    font-size: 0.75rem;
    color: var(--zk-muted, #71717a);
  }
  .hero__urgencia strong {
    color: #f59e0b;
    font-weight: 600;
  }

  .hero__incluye-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--zk-muted, #71717a);
    margin-bottom: 1rem;
  }

  .hero__incluye-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
  }

  .hero__incluye-list li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--zk-text2, #a1a1aa);
  }

  .hero__incluye-list svg {
    color: #22c55e;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .hero__h1 {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }
    .hero__sub {
      font-size: 1rem;
    }
    .hero__incluye-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
    .hero__incluye-list li {
      font-size: 0.75rem;
    }
    .hero__incluye-list svg {
      width: 14px;
      height: 14px;
    }
  }
</style>
