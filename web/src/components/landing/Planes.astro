---
// Planes · 4 tiers desde data/pricing.ts, 3 regiones, compromiso opcional.
// Ni un importe vive en este archivo: todos salen del modelo de precios.
import { TIERS, COMPROMISOS, priceAttrs } from '../../data/pricing';
import { CURRENCIES, DEFAULT_CURRENCY, formatPrice } from '../../lib/currency';

const fmt = (money: Record<string, number>) =>
  formatPrice(money[DEFAULT_CURRENCY], DEFAULT_CURRENCY);

const calcomLink = 'https://cal.com/zenkai-growth-systems/strategy-call';
const pct = (n: number) => `${Math.round(n * 100)}%`;
---
<section id="planes" class="py-24 lg:py-32 border-t border-zk-border/50 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-5 lg:px-8 relative z-10">

    <div class="text-center mb-14 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="text-xs font-mono text-zk-growth uppercase tracking-[0.2em]">Planes</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-5 leading-[1.05]">
        Empiezas chico.<br>
        <span class="text-zk-text2">Escalas cuando los números lo justifiquen.</span>
      </h2>
      <p class="text-lg text-zk-text2 max-w-2xl mx-auto">
        Cada plan incluye todo lo del anterior. Sin permanencia obligatoria: si te comprometes es porque quieres, y entonces pagas menos.
      </p>
      <p class="text-sm text-zk-muted mt-3">
        Mostrando precios para <span class="currency-region font-medium text-zk-text2">{CURRENCIES[DEFAULT_CURRENCY].region}</span>. Cambia la región arriba.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 reveal">
      {TIERS.map((t) => (
        <div class:list={['tier-card', t.destacado && 'tier-card--destacado']}>
          {t.destacado && <div class="tier-flag">Más elegido</div>}

          <h3 class="text-xl font-bold">{t.nombre}</h3>
          <p class="text-sm text-zk-text2 mt-1.5 mb-5 min-h-[2.5rem]">{t.promesa}</p>

          <div class="pb-5 mb-5 border-b border-zk-border">
            <div class="flex items-baseline gap-1.5">
              <span
                class="text-3xl font-bold tracking-tight"
                {...priceAttrs(t.mensual)}
                data-price-suffix=""
              >{fmt(t.mensual)}</span>
              <span class="text-sm font-mono text-zk-muted">
                <span class="currency-code">{DEFAULT_CURRENCY}</span>/mes
              </span>
            </div>
            <div class="text-xs text-zk-text2 mt-2">
              Implantación
              <span
                class="font-mono text-zk-text"
                {...priceAttrs(t.implantacion)}
                data-price-zero="sin coste"
              >{t.implantacion[DEFAULT_CURRENCY] === 0 ? 'sin coste' : fmt(t.implantacion)}</span>
              <span class="text-zk-muted">· una vez, gratis desde 6 meses</span>
            </div>
            <div class="currency-note hidden text-xs text-zk-muted mt-1.5"></div>
          </div>

          <ul class="space-y-2.5 mb-7 text-sm text-zk-text2 flex-1">
            {t.incluye.map((f) => (
              <li class="flex gap-2.5">
                <span class="text-zk-growth font-bold leading-5" aria-hidden="true">+</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href={t.costeUsd >= 205 ? calcomLink : '#hero-demo'}
            {...(t.costeUsd >= 205 ? { target: '_blank', rel: 'noopener' } : {})}
            class:list={['tier-cta', t.destacado && 'tier-cta--primary']}
          >{t.costeUsd >= 205 ? 'Agendar consulta' : 'Ver mi propuesta gratis'}</a>
        </div>
      ))}
    </div>

    {/* Compromiso · opcional, siempre */}
    <div class="mt-12 reveal">
      <div class="rounded-2xl border border-zk-border bg-zk-surface/40 p-7 lg:p-9">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
          <h3 class="text-xl font-bold">Cuanto más tiempo, menos pagas</h3>
          <span class="text-xs font-mono text-zk-muted uppercase tracking-[0.15em]">opcional</span>
        </div>
        <p class="text-sm text-zk-text2 mb-7 max-w-2xl">
          Puedes quedarte mes a mes y marcharte cuando quieras. Comprometerte es una elección, no un candado — y se premia.
        </p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {COMPROMISOS.map((c) => (
            <div class:list={['plazo', c.destacado && 'plazo--destacado']}>
              <div class="flex items-baseline justify-between gap-2">
                <span class="font-semibold text-sm">{c.etiqueta}</span>
                {c.descuento > 0 && (
                  <span class="text-xs font-mono text-zk-growth">−{pct(c.descuento)}</span>
                )}
              </div>
              <p class="text-xs text-zk-text2 mt-2 leading-relaxed">{c.nota}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tier-card {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 26px 22px;
    border-radius: 16px;
    border: 1px solid var(--zk-border, rgba(255, 255, 255, 0.08));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 60%),
      #12121A;
    transition: border-color 0.2s, transform 0.2s;
  }
  .tier-card:hover {
    border-color: rgba(74, 158, 255, 0.4);
    transform: translateY(-2px);
  }
  .tier-card--destacado {
    border-color: rgba(74, 158, 255, 0.45);
    box-shadow: 0 0 0 1px rgba(74, 158, 255, 0.15);
  }
  .tier-flag {
    position: absolute;
    top: -10px;
    left: 22px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--zk-accent-solid);
    color: #fff;
    font-family: 'Geist Mono', 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tier-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 10px;
    border: 1px solid var(--zk-border-hi, rgba(255, 255, 255, 0.16));
    color: #F5F5FA;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .tier-cta:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(74, 158, 255, 0.5);
  }
  .tier-cta--primary {
    background: var(--zk-accent-solid);
    border-color: var(--zk-accent-solid);
  }
  .tier-cta--primary:hover { background: #2A6BF0; border-color: #2A6BF0; }
  .tier-cta:focus-visible { outline: 2px solid #4A9EFF; outline-offset: 2px; }

  .plazo {
    padding: 16px;
    border-radius: 12px;
    border: 1px solid var(--zk-border, rgba(255, 255, 255, 0.08));
    background: rgba(8, 8, 12, 0.5);
  }
  .plazo--destacado { border-color: rgba(74, 158, 255, 0.4); }

  @media (prefers-reduced-motion: reduce) {
    .tier-card:hover { transform: none; }
  }
</style>
