---
/**
 * Barra fija inferior · WhatsApp a ancho completo en móvil.
 *
 * Sustituye a dos cosas a la vez:
 * · El botón circular flotante sin etiqueta (WhatsAppFloat). Un círculo verde
 *   sin texto obliga a adivinar qué hace, y compite por la esquina con el
 *   scroll y con el teclado del móvil.
 * · La barra anterior, que empujaba "50% off · agendar 30 min" a Cal.com.
 *   Agendar una llamada es una barrera mucho más alta que escribir un WhatsApp,
 *   y el descuento gritado ocupaba el sitio del CTA de verdad.
 *
 * Sólo móvil: en escritorio hay CTAs suficientes en el flujo y una barra fija
 * ahí sólo roba altura de viewport.
 */
import WhatsAppCTA from '../WhatsAppCTA.astro';
---
<div id="sticky-wa" class="swa" data-visible="false">
  <WhatsAppCTA
    location="sticky-movil"
    message="Hola ZENKAI. Vengo de la web y quiero contaros mi caso."
    label="Hablar por WhatsApp"
    variant="block"
  />
</div>

<style>
  .swa {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 40;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(180deg, rgba(8, 8, 12, 0), rgba(8, 8, 12, 0.92) 35%);
    transform: translateY(110%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .swa[data-visible='true'] { transform: translateY(0); pointer-events: auto; }

  /* En escritorio no aparece nunca. */
  @media (min-width: 768px) { .swa { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .swa { transition: none; }
  }
</style>

<script>
  // Aparece cuando el hero ya no está a la vista: antes de eso el CTA del hero
  // ya está en pantalla y duplicarlo sólo tapa contenido.
  const bar = document.getElementById('sticky-wa');
  const hero = document.querySelector('.hero');
  if (bar && hero) {
    const io = new IntersectionObserver(
      ([entrada]) => bar.setAttribute('data-visible', String(!entrada.isIntersecting)),
      { rootMargin: '-40% 0px 0px 0px' },
    );
    io.observe(hero);
  }
</script>
