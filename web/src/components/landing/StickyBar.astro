---
// web/src/components/landing/StickyBar.astro
// v3.3 Sprint 2.5 · Sticky bottom CTA bar
// Aparece después de scroll > 60% del primer viewport
// Persiste hasta que el usuario cierra (sessionStorage)
// Va al final del index.astro, antes del Footer
---

<div id="sticky-cta" class="sticky-cta" aria-hidden="true">
  <div class="sticky-cta-icon">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>
  </div>
  <div class="sticky-cta-body">
    <div class="sticky-cta-eyebrow">Oferta limitada</div>
    <div class="sticky-cta-text"><strong>50% off</strong> en tu primer mes · agendá 30 min gratis</div>
  </div>
  <a
    href="https://cal.com/zenkai-growth-systems/strategy-call"
    target="_blank"
    rel="noopener"
    class="sticky-cta-button"
  >
    <span>Agendar</span>
    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
    </svg>
  </a>
  <button id="sticky-cta-close" class="sticky-cta-close" aria-label="Cerrar oferta">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>
</div>

<style>
  .sticky-cta {
    position: fixed;
    bottom: 24px; left: 50%;
    transform: translateX(-50%) translateY(150%);
    z-index: 40;
    padding: 12px 20px;
    background: linear-gradient(135deg, rgba(13,13,23,0.96), rgba(20,20,35,0.96));
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255,165,70,0.35);
    border-radius: 14px;
    box-shadow:
      0 25px 60px -15px rgba(0,0,0,0.7),
      0 0 40px rgba(255,140,50,0.18),
      inset 0 1px 0 rgba(255,255,255,0.06);
    display: flex; align-items: center; gap: 14px;
    max-width: calc(100vw - 32px);
    transition: transform .5s cubic-bezier(.16,1,.3,1), opacity .4s;
    opacity: 0;
    pointer-events: none;
  }
  .sticky-cta.visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .sticky-cta-icon {
    flex-shrink: 0;
    width: 36px; height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #FFB060, #FF8830);
    display: flex; align-items: center; justify-content: center;
    color: white;
    box-shadow: 0 0 20px rgba(255,140,50,0.4);
  }

  .sticky-cta-body { flex: 1; min-width: 0; }
  .sticky-cta-eyebrow {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 10px; color: #FFB060;
    letter-spacing: 0.15em; text-transform: uppercase;
    margin-bottom: 2px;
  }
  .sticky-cta-text {
    color: #F5F5FA; font-size: 14px; font-weight: 500;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sticky-cta-text strong { color: #FFCC8A; font-weight: 700; }

  .sticky-cta-button {
    flex-shrink: 0;
    background: linear-gradient(135deg, #FF8830, #FFB060);
    color: white; font-weight: 600; font-size: 13px;
    padding: 8px 14px; border-radius: 10px;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 6px;
    transition: all .25s;
    box-shadow: 0 4px 12px rgba(255,140,50,0.4);
  }
  .sticky-cta-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(255,140,50,0.6);
  }

  .sticky-cta-close {
    flex-shrink: 0;
    background: transparent; border: none;
    color: #5A5A70; cursor: pointer;
    padding: 4px; border-radius: 6px;
    transition: color .2s;
  }
  .sticky-cta-close:hover { color: #F5F5FA; }

  @media (max-width: 640px) {
    .sticky-cta { gap: 10px; padding: 10px 14px; bottom: 16px; }
    .sticky-cta-icon { width: 32px; height: 32px; }
    .sticky-cta-text { font-size: 13px; }
    .sticky-cta-eyebrow { font-size: 9px; }
    .sticky-cta-button { padding: 7px 12px; font-size: 12px; }
  }
</style>

<script>
  const stickyCTA = document.getElementById('sticky-cta');
  const closeBtn = document.getElementById('sticky-cta-close');

  // Si el usuario ya cerró el banner en esta sesión, no mostrarlo
  let hidden = typeof sessionStorage !== 'undefined' && sessionStorage.getItem('zenkai-cta-closed') === '1';
  let shown = false;

  if (!hidden && stickyCTA) {
    window.addEventListener('scroll', () => {
      if (hidden || shown) return;
      const scrollY = window.scrollY;
      const viewport = window.innerHeight;
      // Aparece cuando el usuario haya scrolleado más del 60% del primer viewport
      if (scrollY > viewport * 0.6) {
        stickyCTA.classList.add('visible');
        stickyCTA.setAttribute('aria-hidden', 'false');
        shown = true;
      }
    }, { passive: true });
  }

  closeBtn?.addEventListener('click', () => {
    stickyCTA?.classList.remove('visible');
    stickyCTA?.setAttribute('aria-hidden', 'true');
    hidden = true;
    try {
      sessionStorage.setItem('zenkai-cta-closed', '1');
    } catch (e) {}
  });
</script>
