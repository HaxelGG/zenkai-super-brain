---
/**
 * NeuralHero — Sistema Neuronal ZENKAI.
 *
 * Canvas interactivo: un nodo central (ZENKAI CORE) rodeado de 12 nodos.
 * Conexiones con pulsos de datos. Hover ilumina el nodo y sus conexiones.
 * Sin partículas genéricas. Sin estrellas. Sin blobs.
 *
 * Performance: 30fps con requestAnimationFrame, throttling en móvil.
 * Sin JS = fallback estático con CSS grid.
 */
import WhatsAppCTA from '../WhatsAppCTA.astro';

const modulos = [
  { id: 'sales', label: 'Sales AI', x: 0.85, y: 0.15, desc: 'Prospecta, califica y cierra' },
  { id: 'marketing', label: 'Marketing AI', x: 0.92, y: 0.35, desc: 'Campañas autónomas' },
  { id: 'commerce', label: 'Commerce AI', x: 0.85, y: 0.55, desc: 'Tienda y pagos integrados' },
  { id: 'creative', label: 'Creative AI', x: 0.72, y: 0.72, desc: 'Diseño y contenido generativo' },
  { id: 'customer', label: 'Customer AI', x: 0.50, y: 0.85, desc: 'Atención 24/7 multicanal' },
  { id: 'knowledge', label: 'Knowledge AI', x: 0.25, y: 0.78, desc: 'Documentos y datos inteligentes' },
  { id: 'operations', label: 'Operations AI', x: 0.08, y: 0.60, desc: 'Workflows automatizados' },
  { id: 'intelligence', label: 'Intelligence AI', x: 0.03, y: 0.38, desc: 'Dashboards y analítica' },
  { id: 'finance', label: 'Finance AI', x: 0.10, y: 0.18, desc: 'Facturación y tesorería' },
  { id: 'hr', label: 'HR AI', x: 0.30, y: 0.05, desc: 'Talento y procesos internos' },
  { id: 'security', label: 'Security AI', x: 0.55, y: 0.02, desc: 'Cumplimiento y protección' },
  { id: 'enterprise', label: 'Enterprise AI', x: 0.75, y: 0.10, desc: 'Infraestructura dedicada' },
];
---

<section class="nh-root">
  <!-- Grid de infraestructura -->
  <div class="nh-grid" aria-hidden="true"></div>
  <!-- Atmosfera -->
  <div class="nh-atmos" aria-hidden="true"></div>
  <canvas class="nh-canvas" id="nh-canvas" aria-hidden="true"></canvas>
  <div class="nh-overlay"></div>

  <div class="nh-content">
    <p class="nh-eyebrow reveal">AI Growth Systems</p>
    <h1 class="nh-h1 reveal">
      Vende más.<br />
      Atiende a todos.<br />
      <span class="nh-grad">Opera con menos fricción.</span>
    </h1>
    <p class="nh-sub reveal">
      Infraestructura de IA que conecta ventas, atención y operaciones sobre las herramientas que ya usas.
      <strong>500€</strong> de implementación · <strong>95€/mes</strong> de mantenimiento.
    </p>
    <div class="nh-ctas reveal">
      <WhatsAppCTA location="hero" message="Hola ZENKAI. Vengo de la web." label="Hablar con ZENKAI" size="lg" />
      <a href="#plan" class="nh-secondary">
        Ver qué incluye
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    </div>
    <div class="nh-trust reveal">
      <span>Sin tarjeta</span>
      <span>Sin permanencia</span>
      <span>14 días de prueba</span>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('nh-canvas') as HTMLCanvasElement;
  if (!canvas) throw new Error('NeuralHero: canvas missing');
  const ctx = canvas.getContext('2d')!;

  const mqReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (mqReduced.matches) { canvas.style.opacity = '0.15'; }

  const isMobile = window.innerWidth < 768;
  const fps = isMobile ? 20 : 35;

  let w = 0, h = 0;
  let cx = 0, cy = 0;
  let mouseX = -1000, mouseY = -1000;
  let targetMX = -1000, targetMY = -1000;
  let hoveredNode = -1;
  let time = 0;
  let animId = 0;

  const moduleNodes = modulos.map(m => ({
    ...m,
    rx: 0, ry: 0, r: 0,
    pulse: Math.random() * Math.PI * 2,
    pulseSpeed: 0.02 + Math.random() * 0.03,
  }));

  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    w = rect.width; h = rect.height;
    canvas.width = w * devicePixelRatio;
    canvas.height = h * devicePixelRatio;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    cx = w * 0.38;
    cy = h * 0.42;
    moduleNodes.forEach(n => {
      n.rx = n.x * w;
      n.ry = n.y * h;
      n.r = isMobile ? 4.5 : 6;
    });
  }

  function drawNode(x: number, y: number, r: number, alpha: number, accent = false) {
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    const baseAlpha = accent ? 0.18 : alpha * 0.08;
    ctx.fillStyle = `rgba(99, 138, 255, ${baseAlpha})`;
    ctx.fill();
    ctx.strokeStyle = `rgba(99, 138, 255, ${accent ? 0.5 : 0.18})`;
    ctx.lineWidth = accent ? 1.5 : 0.8;
    ctx.stroke();
  }

  function draw(timestamp: number) {
    if (mqReduced.matches) { animId = requestAnimationFrame(draw); return; }
    time = timestamp * 0.001;
    animId = requestAnimationFrame(draw);

    mouseX += (targetMX - mouseX) * 0.06;
    mouseY += (targetMY - mouseY) * 0.06;

    ctx.clearRect(0, 0, w, h);

    // Conexiones
    const distToMouse = (nx: number, ny: number) => Math.hypot(mouseX - nx, mouseY - ny);
    hoveredNode = -1;
    let minDist = Infinity;
    moduleNodes.forEach((n, i) => {
      const d = distToMouse(n.rx, n.ry);
      if (d < n.r * 5 && d < minDist) { minDist = d; hoveredNode = i; }
    });

    moduleNodes.forEach((n, i) => {
      const isHovered = i === hoveredNode;
      const alpha = isHovered ? 1 : (hoveredNode >= 0 ? 0.15 : 0.3);
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      const midX = (cx + n.rx) / 2 + Math.sin(time * 0.5 + i) * 4;
      const midY = (cy + n.ry) / 2 + Math.cos(time * 0.4 + i) * 4;
      ctx.quadraticCurveTo(midX, midY, n.rx, n.ry);
      ctx.strokeStyle = `rgba(99, 138, 255, ${alpha * 0.15})`;
      ctx.lineWidth = isHovered ? 1.6 : 0.7;
      ctx.stroke();

      // Pulso de datos
      n.pulse += n.pulseSpeed;
      const pt = (n.pulse % 1);
      const px = cx + (n.rx - cx) * pt;
      const py = cy + (n.ry - cy) * pt;
      ctx.beginPath();
      ctx.arc(px, py, isHovered ? 2.5 : 1.5, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(99, 138, 255, ${isHovered ? 0.7 : 0.25})`;
      ctx.fill();
    });

    // Nodo central
    const coreR = isMobile ? 13 : 18;
    const breathe = 1 + Math.sin(time * 0.8) * 0.08;
    drawNode(cx, cy, coreR * breathe, 1, true);
    // Glow exterior
    ctx.beginPath();
    ctx.arc(cx, cy, coreR * breathe * 3.5, 0, Math.PI * 2);
    const glow = ctx.createRadialGradient(cx, cy, coreR * breathe, cx, cy, coreR * breathe * 3.5);
    glow.addColorStop(0, 'rgba(99, 138, 255, 0.12)');
    glow.addColorStop(1, 'rgba(99, 138, 255, 0)');
    ctx.fillStyle = glow;
    ctx.fill();

    // Nodos perifericos
    moduleNodes.forEach((n, i) => {
      const isHovered = i === hoveredNode;
      const nr = isHovered ? n.r * 1.8 : n.r;
      drawNode(n.rx, n.ry, nr, isHovered ? 1 : 0.5, isHovered);
      if (isHovered) {
        ctx.font = `${isMobile ? 10 : 11}px "Geist Variable", system-ui, sans-serif`;
        ctx.fillStyle = 'rgba(245, 245, 250, 0.9)';
        ctx.fillText(n.label, n.rx + 10, n.ry - 6);
        ctx.font = `${isMobile ? 9 : 10}px "Geist Variable", system-ui, sans-serif`;
        ctx.fillStyle = 'rgba(180, 180, 200, 0.7)';
        ctx.fillText(n.desc, n.rx + 10, n.ry + 10);
      }
    });
  }

  function onMouseMove(e: MouseEvent) {
    const rect = canvas.getBoundingClientRect();
    targetMX = e.clientX - rect.left;
    targetMY = e.clientY - rect.top;
  }

  resize();
  window.addEventListener('resize', resize);
  canvas.addEventListener('mousemove', onMouseMove, { passive: true });
  animId = requestAnimationFrame(draw);

  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(animId);
    window.removeEventListener('resize', resize);
    canvas.removeEventListener('mousemove', onMouseMove);
  });
</script>

<style>
  .nh-root {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #06060A;
  }

  .nh-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(99, 138, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 138, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 40% 45%, black 30%, transparent 70%);
  }

  .nh-atmos {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 40% at 38% 42%, rgba(99, 138, 255, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 30% 25% at 70% 30%, rgba(139, 92, 246, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse 20% 20% at 20% 80%, rgba(99, 138, 255, 0.03) 0%, transparent 50%);
  }

  .nh-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: auto;
  }

  .nh-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(ellipse 50% 50% at 38% 42%, transparent 50%, rgba(8,8,12,0.4) 100%);
  }

  .nh-content {
    position: relative;
    z-index: 3;
    max-width: 48rem;
    margin-left: 8%;
    padding: 2rem 1.5rem;
    pointer-events: none;
  }
  .nh-content > * { pointer-events: auto; }

  .nh-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(99, 138, 255, 0.7);
    margin-bottom: 1.25rem;
  }

  .nh-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--zk-heading, #f5f5fa);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .nh-grad {
    background: linear-gradient(135deg, #638AFF 0%, #8B5CF6 60%, #A78BFA 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nh-sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--zk-text2, #a1a1aa);
    max-width: 34rem;
    margin-bottom: 2rem;
  }
  .nh-sub strong {
    color: var(--zk-heading, #f5f5fa);
    font-weight: 600;
  }

  .nh-ctas {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .nh-secondary {
    font-size: 0.875rem;
    color: var(--zk-muted, #a1a1aa);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s;
  }
  .nh-secondary:hover { color: var(--zk-heading, #f5f5fa); }

  .nh-trust {
    display: flex;
    gap: 1.25rem;
    font-size: 0.75rem;
    color: var(--zk-muted, #71717a);
  }

  @media (max-width: 768px) {
    .nh-content {
      margin-left: 0;
      text-align: center;
      padding: 4rem 1.25rem;
    }
    .nh-h1 { font-size: clamp(2rem, 8vw, 3rem); }
    .nh-sub { max-width: 100%; }
    .nh-ctas { justify-content: center; flex-direction: column; }
    .nh-trust { justify-content: center; }
  }
</style>
