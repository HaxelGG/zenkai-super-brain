---
/**
 * TrustStrip — Cinta de confianza bajo el hero.
 * Integraciones + tecnologia + seguridad. Sin logos falsos.
 */
---

<section class="band-ts" aria-label="Tecnologia y confianza">
  <div class="wrap">
    <div class="ts-row reveal">
      <span class="ts-item">Integrado con WhatsApp</span>
      <span class="ts-dot">·</span>
      <span class="ts-item">Compatible con tu CRM</span>
      <span class="ts-dot">·</span>
      <span class="ts-item">Agentes de IA 24/7</span>
      <span class="ts-dot">·</span>
      <span class="ts-item">RGPD y AI Act</span>
      <span class="ts-dot">·</span>
      <span class="ts-item">Despliegue en 7 dias</span>
    </div>
  </div>
</section>

<style>
  .band-ts {
    padding-block: 1.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    background: rgba(255,255,255,0.008);
  }
  .wrap { max-width: 48rem; margin-inline: auto; padding-inline: 1.5rem; }
  .ts-row {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 0.6rem 1rem;
  }
  .ts-item {
    font-size: 0.8125rem; color: var(--zk-muted, #71717a);
  }
  .ts-dot { color: rgba(99,138,255,0.4); font-size: 0.75rem; }
</style>
