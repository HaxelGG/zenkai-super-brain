---
import Brand from './Brand.astro';
import { CURRENCY_CODES, DEFAULT_CURRENCY } from '../../lib/currency';
---
<header class="fixed top-0 left-0 right-0 z-50 nav-blur border-b border-zk-border/50">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 h-16 flex items-center justify-between">

    <a href="/" class="brand-link">
      <Brand variant="default" showTagline={true} />
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-sm text-zk-text2">
      <a href="#proyeccion" class="hover:text-zk-text transition">Resultados</a>
      <a href="#como-funciona" class="hover:text-zk-text transition">Cómo funciona</a>
      <a href="#diferente" class="hover:text-zk-text transition">Comparativa</a>
      <a href="#planes" class="hover:text-zk-text transition">Planes</a>
      <a href="#faq" class="hover:text-zk-text transition">FAQ</a>
    </nav>

    <div class="flex items-center gap-3">
      {/* Visible también en móvil: quien compara precios lo hace sobre todo desde el
          teléfono, y ocultarlo con `hidden md:flex` dejaba a ese usuario sin la
          única pista de en qué moneda va a pagar. */}
      <div
        class="currency-switch flex items-center text-xs font-mono bg-zk-surface border border-zk-border rounded-lg overflow-hidden"
        role="group"
        aria-label="Moneda de los precios"
      >
        {CURRENCY_CODES.map((code) => (
          <button
            class:list={['currency-btn', code === DEFAULT_CURRENCY ? 'is-active' : '']}
            data-currency={code}
            aria-pressed={code === DEFAULT_CURRENCY ? 'true' : 'false'}
          >{code}</button>
        ))}
      </div>
      <a href="#hero-demo" class="hidden sm:inline-flex text-sm font-semibold bg-white text-zk-bg px-4 py-2 rounded-lg hover:bg-zk-text2 transition">
        Probar gratis
      </a>
      <button
        id="mobile-menu-toggle"
        class="lg:hidden mobile-burger"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Mobile overlay menu · solo visible <lg cuando #mobile-menu-toggle dispara */}
<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-backdrop" data-mobile-close></div>
  <nav class="mobile-menu-panel" role="dialog" aria-label="Navegación móvil">
    <div class="mobile-menu-header">
      <Brand variant="default" showTagline={true} />
      <button class="mobile-close" aria-label="Cerrar menú" data-mobile-close>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <ul class="mobile-menu-links">
      <li><a href="#proyeccion" data-mobile-close>Resultados</a></li>
      <li><a href="#como-funciona" data-mobile-close>Cómo funciona</a></li>
      <li><a href="#diferente" data-mobile-close>Comparativa</a></li>
      <li><a href="#planes" data-mobile-close>Planes</a></li>
      <li><a href="#sectores" data-mobile-close>Sectores</a></li>
      <li><a href="#faq" data-mobile-close>FAQ</a></li>
      <li><a href="/privacy" data-mobile-close>Privacidad</a></li>
    </ul>
    <a href="#hero-demo" class="mobile-cta" data-mobile-close>Probar gratis</a>
  </nav>
</div>

<script>
  // === Conmutador de moneda ===
  // No hay conversión: cada elemento de precio trae su importe ya fijado en cada
  // moneda (data-price-usd, data-price-eur, ...) desde data/pricing.ts. Este script
  // sólo elige cuál de esos importes mostrar y cómo formatearlo.
  import { CURRENCIES, DEFAULT_CURRENCY, formatPrice, isCurrencyCode } from '../../lib/currency';
  import type { CurrencyCode } from '../../lib/currency';

  const applyCurrency = (cur: CurrencyCode) => {
    document.querySelectorAll<HTMLButtonElement>('.currency-btn').forEach((b) => {
      const isActive = b.dataset.currency === cur;
      b.classList.toggle('is-active', isActive);
      b.setAttribute('aria-pressed', String(isActive));
    });

    document.querySelectorAll<HTMLElement>('.price, .price-monthly').forEach((el) => {
      const raw = el.dataset[`price${cur.charAt(0)}${cur.slice(1).toLowerCase()}`];
      const amount = Number(raw);
      if (!raw || Number.isNaN(amount)) return;
      const formatted = formatPrice(amount, cur);
      el.textContent = el.classList.contains('price-monthly') ? `${formatted}/mes` : formatted;
    });

    document.querySelectorAll<HTMLElement>('.currency-code').forEach((el) => {
      el.textContent = cur;
    });

    // Aviso fiscal (p. ej. "IVA no incluido" en EUR).
    const note = CURRENCIES[cur].note;
    document.querySelectorAll<HTMLElement>('.currency-note').forEach((el) => {
      el.textContent = note ?? '';
      el.classList.toggle('hidden', !note);
    });

    try { localStorage.setItem('zk-currency', cur); } catch {}
  };

  document.querySelectorAll<HTMLButtonElement>('.currency-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cur = btn.dataset.currency;
      if (isCurrencyCode(cur)) applyCurrency(cur);
    });
  });

  try {
    const saved = localStorage.getItem('zk-currency');
    // Sólo preferencia de UI · si la guardada ya no existe (COP/MXN de la versión
    // anterior) se limpia y volvemos al default en vez de dejar el estado colgado.
    if (saved && isCurrencyCode(saved)) applyCurrency(saved);
    else if (saved) {
      localStorage.removeItem('zk-currency');
      applyCurrency(DEFAULT_CURRENCY);
    }
  } catch {}

  // === Mobile hamburger menu ===
  const burger = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const open = () => {
    if (!menu || !burger) return;
    menu.classList.add('open');
    menu.setAttribute('aria-hidden', 'false');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    if (!menu || !burger) return;
    menu.classList.remove('open');
    menu.setAttribute('aria-hidden', 'true');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };
  burger?.addEventListener('click', open);
  document.querySelectorAll('[data-mobile-close]').forEach((el) => {
    el.addEventListener('click', close);
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) close();
  });
</script>

<style>
  .brand-link {
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .brand-link:hover { opacity: 0.85; }

  /* Conmutador de moneda · 48x48 mínimo por botón (WCAG 2.1 AA, objetivo táctil).
     Los 34px de alto anteriores fallaban el criterio y en móvil ni se renderizaba. */
  .currency-switch { flex-shrink: 0; }
  .currency-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 0 10px;
    background: transparent;
    border: 0;
    color: #9999AE;
    font: inherit;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .currency-btn:hover { color: #F5F5FA; }
  .currency-btn.is-active {
    color: #FFFFFF;
    background: #1E6FFF;
  }
  .currency-btn:focus-visible {
    outline: 2px solid #4A9EFF;
    outline-offset: -2px;
  }

  .mobile-burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #F5F5FA;
    background: transparent;
    border: 1px solid #2A2A3A;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .mobile-burger:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(74, 158, 255, 0.4);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: none;
  }
  .mobile-menu.open { display: block; }
  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 3, 5, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fadeIn 0.2s ease;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .mobile-menu-panel {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 100%;
    max-width: 320px;
    background: linear-gradient(180deg, #0D0D17, #080810);
    border-left: 1px solid #1F1F2C;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.6);
    padding: 20px;
    display: flex;
    flex-direction: column;
    animation: slideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid #1F1F2C;
    margin-bottom: 20px;
  }
  .mobile-close {
    background: transparent;
    border: none;
    color: #9999AE;
    cursor: pointer;
    padding: 6px;
    border-radius: 6px;
    transition: color 0.2s;
  }
  .mobile-close:hover { color: #F5F5FA; }
  .mobile-menu-links {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-menu-links a {
    display: block;
    padding: 12px 14px;
    color: #C5C5D6;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    border-radius: 8px;
    transition: background 0.2s, color 0.2s;
  }
  .mobile-menu-links a:hover {
    background: rgba(74, 158, 255, 0.08);
    color: #F5F5FA;
  }
  .mobile-cta {
    display: block;
    text-align: center;
    background: white;
    color: #030305;
    font-weight: 600;
    padding: 14px 20px;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .mobile-cta:hover { transform: translateY(-1px); }
</style>
