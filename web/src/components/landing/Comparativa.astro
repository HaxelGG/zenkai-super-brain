---
// Comparativa ZENKAI vs agencia tradicional · tabla estática
import { Image } from 'astro:assets';
import logoSquare from '../../assets/brand/zenkai-logo-square.png';

interface Row {
  label: string;
  tradicional: string;
  zenkai: string;
}
/**
 * Tres filas decían cosas que no son ciertas, y las tres en la sección cuyo
 * único trabajo es generar confianza:
 *
 * · "Rango USD desde el minuto 1" — hablaba de dólares con el conmutador en
 *   euros. El precio se fija en cada moneda, no hay rango y no hay USD por
 *   defecto en Europa.
 * · "Desde 5 días (plan Lite)" — el plan Lite no existe. Los planes son
 *   Starter, Silver, Gold y Enterprise. Citar un plan inventado en la tabla
 *   comparativa es lo que un comprador comprueba primero.
 * · "Mes a mes desde $90 USD" — el plan más barato son 500 USD / 269 €.
 *   Anunciar 90 no es un precio de entrada: es una cifra que ya no existe.
 *
 * Ahora ninguna fila afirma un importe. El precio tiene su propia sección y
 * su propio conmutador de moneda; repetirlo aquí sólo crea una segunda copia
 * que se queda vieja. La comparativa compara CÓMO se trabaja.
 */
const rows: Row[] = [
  { label: 'Primer contacto', tradicional: 'Form → "te contactamos en 48h"', zenkai: 'Propuesta en 30 segundos' },
  { label: 'Discovery call', tradicional: '60 min para "entender"', zenkai: 'Tu mensaje basta como brief' },
  { label: 'Propuesta', tradicional: 'PDF de 40 páginas con jerga', zenkai: 'Una página con stack y precio' },
  { label: 'Precio', tradicional: '"Depende de muchos factores"', zenkai: 'Publicado, en tu moneda' },
  { label: 'Stack técnico', tradicional: '"Secreto industrial"', zenkai: 'Público en cada propuesta' },
  { label: 'Primer entregable', tradicional: '4-8 semanas', zenkai: 'Puesta en marcha en 5 días' },
  { label: 'Compromiso mínimo', tradicional: 'Contrato anual', zenkai: 'Mes a mes, sin permanencia' },
];
---
<section id="diferente" class="py-20 lg:py-24 border-t border-zk-border/50 relative">
  <div class="relative max-w-5xl mx-auto px-5 lg:px-8">

    <div class="text-center mb-12 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="t-eyebrow">La diferencia</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      {/* "a las otras 200 agencias" fuera: nadie ha contado 200 agencias, y una
          cifra inventada en la sección que trata de la confianza es el peor
          sitio posible para ponerla. */}
      <h2 class="comp__h2">Lo que hacemos distinto de una agencia tradicional</h2>
    </div>

    <div class="reveal bg-gradient-to-br from-zk-surface to-zk-surface2 border border-zk-border2 rounded-2xl overflow-hidden shadow-2xl shadow-black/40">
      <div class="grid grid-cols-3 text-xs font-mono text-zk-muted uppercase tracking-wider border-b border-zk-border bg-zk-bg2">
        <div class="px-4 sm:px-6 py-4"></div>
        <div class="px-4 sm:px-6 py-4 text-center">Agencia tradicional</div>
        <div class="px-4 sm:px-6 py-4 text-center text-zk-growth font-bold flex items-center justify-center gap-2">
          <Image
            src={logoSquare}
            alt=""
            width={16}
            height={16}
            format="webp"
            class="w-4 h-4 rounded object-cover"
          />
          ZENKAI
        </div>
      </div>

      {rows.map((row) => (
        <div class="compare-row grid grid-cols-3 items-center border-b border-zk-border transition">
          <div class="comp__label">{row.label}</div>
          <div class="comp__celda comp__celda--no">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            <span>{row.tradicional}</span>
          </div>
          <div class="comp__celda comp__celda--si">
            <svg class="w-4 h-4 text-zk-success flex-shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>{row.zenkai}</span>
          </div>
        </div>
      ))}

    </div>
  </div>
</section>

<style>
  .comp__h2 {
    font-size: var(--t-h2); font-weight: 700; line-height: 1.08;
    letter-spacing: -0.025em; margin: 0 auto; max-width: 20ch;
  }
  .comp__label {
    padding: 1.25rem 1rem;
    font-size: var(--t-card); font-weight: 550; color: var(--zk-text-2);
  }
  /* Las celdas estaban a 12px por debajo de 640px. Es la tabla que un
     comprador compara línea a línea, no un pie de foto. */
  .comp__celda {
    display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 1.25rem 1rem; text-align: center;
    font-size: var(--t-micro); line-height: 1.4;
  }
  .comp__celda--no { color: var(--zk-muted); }
  .comp__celda--si { color: var(--zk-text); font-weight: 550; }
  @media (min-width: 640px) {
    .comp__label, .comp__celda { padding-inline: 1.5rem; }
    .comp__label { font-size: 1rem; }
    .comp__celda { font-size: var(--t-card); }
  }
</style>
