---
// Comparativa ZENKAI vs agencia tradicional · tabla estática
import { Image } from 'astro:assets';
import logoSquare from '../../assets/brand/zenkai-logo-square.png';

interface Row {
  label: string;
  tradicional: string;
  zenkai: string;
}
const rows: Row[] = [
  { label: 'Primer contacto', tradicional: 'Form → "te contactamos en 48h"', zenkai: 'Propuesta en 30 segundos' },
  { label: 'Discovery call', tradicional: '60 min para "entender"', zenkai: 'Tu mensaje basta como brief' },
  { label: 'Propuesta', tradicional: 'PDF de 40 páginas con jerga', zenkai: 'Una página con stack y precio' },
  { label: 'Precio', tradicional: '"Depende de muchos factores"', zenkai: 'Rango USD desde el minuto 1' },
  { label: 'Stack técnico', tradicional: '"Secreto industrial"', zenkai: 'Público en cada propuesta' },
  { label: 'Primer entregable', tradicional: '4-8 semanas', zenkai: 'Desde 5 días (plan Lite)' },
  { label: 'Compromiso mínimo', tradicional: 'Contrato anual', zenkai: 'Mes a mes desde $90 USD' },
];
---
<section id="diferente" class="py-24 lg:py-32 border-t border-zk-border/50 relative">
  <div class="relative max-w-5xl mx-auto px-5 lg:px-8">

    <div class="text-center mb-12 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="text-xs font-mono text-zk-accent uppercase tracking-[0.2em]">La diferencia</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      {/* "a las otras 200 agencias" fuera: nadie ha contado 200 agencias, y una
          cifra inventada en la sección que trata de la confianza es el peor
          sitio posible para ponerla. */}
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-5 leading-[1.05]">
        Lo que hacemos distinto<br>
        <span class="text-zk-text2">de una agencia tradicional.</span>
      </h2>
    </div>

    <div class="reveal bg-gradient-to-br from-zk-surface to-zk-surface2 border border-zk-border2 rounded-2xl overflow-hidden shadow-2xl shadow-black/40">
      <div class="grid grid-cols-3 text-xs font-mono text-zk-muted uppercase tracking-wider border-b border-zk-border bg-zk-bg2">
        <div class="px-4 sm:px-6 py-4"></div>
        <div class="px-4 sm:px-6 py-4 text-center">Agencia tradicional</div>
        <div class="px-4 sm:px-6 py-4 text-center text-zk-accent font-bold flex items-center justify-center gap-2">
          <Image
            src={logoSquare}
            alt=""
            width={16}
            height={16}
            format="webp"
            class="w-4 h-4 rounded object-cover"
          />
          ZENKAI
        </div>
      </div>

      {rows.map((row) => (
        <div class="compare-row grid grid-cols-3 items-center border-b border-zk-border transition">
          <div class="px-4 sm:px-6 py-5 text-zk-text2 font-medium text-sm sm:text-base">{row.label}</div>
          <div class="px-4 sm:px-6 py-5 text-center text-zk-muted text-xs sm:text-sm flex items-center justify-center gap-2">
            <svg class="w-4 h-4 text-zk-muted flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            <span>{row.tradicional}</span>
          </div>
          <div class="px-4 sm:px-6 py-5 text-center text-zk-text font-medium text-xs sm:text-sm flex items-center justify-center gap-2">
            <svg class="w-4 h-4 text-zk-success flex-shrink-0" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>{row.zenkai}</span>
          </div>
        </div>
      ))}

    </div>
  </div>
</section>
