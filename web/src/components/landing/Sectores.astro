---
// 8 sector cards · estático · estructurado como data para evitar 800 líneas de HTML duplicado
interface Sector {
  title: string;
  subtitle: string;
  iconSvg: string;
  variant?: 'default' | 'outline';
  /** Template de pre-llenado del textarea del demo. Si vacío, no pre-llena. */
  template?: string;
}
const sectores: Sector[] = [
  {
    title: 'E-commerce',
    subtitle: 'Carritos abandonados · ROAS bajo · sin atribución',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>',
    template: 'Vendo [producto] por Instagram + Shopify, facturo aprox $X USD/mes. El problema: muchos carritos abandonados y no entiendo qué ads me funcionan. Quiero recuperar ventas y entender atribución.',
  },
  {
    title: 'Servicios profesionales',
    subtitle: 'Boca a boca no escala · propuestas a mano',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
    template: 'Soy [profesión] independiente con [X] años de experiencia. Paso más tiempo redactando propuestas y haciendo seguimiento que cerrando casos. Quiero automatizar primer contacto + calificación.',
  },
  {
    title: 'Clínicas & Salud',
    subtitle: 'No-shows del 30% · agenda caótica',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>',
    template: 'Tengo una clínica con [X] profesionales en [ciudad]. Atendemos [Y] pacientes/día y perdemos turnos por no contestar WhatsApp a tiempo. Quiero capturar más leads sin contratar otra recepcionista.',
  },
  {
    title: 'Restaurantes',
    subtitle: 'La app de reparto se queda tu margen',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h18v18H3zM3 9h18M9 21V9"/>',
    template: 'Tengo un restaurante de [X] mesas. La mayoría de pedidos entra por una app de reparto que se lleva comisión. Quiero pedidos y reservas directos por WhatsApp, y que no se me caigan las reservas.',
  },
  {
    title: 'Inmobiliaria',
    subtitle: 'Leads se enfrían · sin pipeline',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1"/>',
    template: 'Soy agente inmobiliario con [X] años de experiencia. Mis leads se enfrían porque no tengo pipeline ni seguimiento automático. Quiero calificar prospectos y agendar visitas sin perder oportunidades.',
  },
  {
    title: 'Educación online',
    subtitle: 'Abandono al segundo módulo',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>',
    template: 'Tengo un curso online con [X] estudiantes activos. El [60%] abandona en el segundo módulo. Quiero engagement automático + seguimiento personalizado para subir el completion rate.',
  },
  {
    title: 'Manufactura B2B',
    subtitle: 'Conocimiento solo en cabezas',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>',
    template: 'Tengo una fábrica B2B en [ciudad] con [X] empleados. El conocimiento operativo solo está en cabeza de 3 personas senior. Quiero documentar procesos y automatizar consultas internas.',
  },
  {
    title: 'Tu sector no está',
    subtitle: 'Prueba la demo · te decimos si encaja',
    iconSvg: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>',
    variant: 'outline',
    // Sin template · queda en blanco para que escriba libre
  },
];
---
<section id="sectores" class="py-24 lg:py-32 border-t border-zk-border/50 relative">

  <div class="max-w-6xl mx-auto px-5 lg:px-8">

    <div class="text-center mb-14 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="text-xs font-mono text-zk-growth uppercase tracking-[0.2em]">Para quién funciona</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-5 leading-[1.05]">
        Trabajamos con negocios<br>
        <span class="text-zk-text2">que ya facturan.</span>
      </h2>
      <p class="text-lg text-zk-text2 max-w-2xl mx-auto">
        Si tu sector está aquí, tenemos módulos pre-construidos. Si no, prueba la demo y el sistema te dice.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 reveal">
      {sectores.map((s) => {
        const isOutline = s.variant === 'outline';
        const cardClass = isOutline
          ? 'card-3d group sector-card bg-gradient-to-br from-zk-surface2 to-zk-surface3 border border-dashed border-zk-border2 rounded-2xl p-5 hover:border-zk-accent/50 transition'
          : 'card-3d group sector-card bg-gradient-to-br from-zk-surface to-zk-surface2 border border-zk-border2 rounded-2xl p-5 hover:border-zk-accent/50 transition';
        const iconBoxClass = isOutline
          ? 'w-11 h-11 rounded-xl bg-zk-surface flex items-center justify-center mb-4'
          : 'w-11 h-11 rounded-xl bg-zk-accent/10 border border-zk-accent/30 flex items-center justify-center mb-4 group-hover:bg-zk-accent/20 group-hover:scale-105 transition';
        const iconClass = isOutline ? 'w-5 h-5 text-zk-muted' : 'w-5 h-5 text-zk-growth';
        const titleClass = isOutline ? 'font-semibold mb-1.5 text-zk-text2' : 'font-semibold mb-1.5';
        return (
          <a href="#hero-demo" class={cardClass} data-sector-template={s.template ?? ''}>
            <div class={iconBoxClass}>
              <svg class={iconClass} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={s.iconSvg}></svg>
            </div>
            <div class={titleClass}>{s.title}</div>
            <div class="text-xs text-zk-muted leading-relaxed">{s.subtitle}</div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Pre-llena el textarea del demo (#demo-textarea) con un template del sector clickeado.
  // Dispara 'input' event para que el char counter + glow del DemoSection se actualicen.
  document.querySelectorAll<HTMLAnchorElement>('.sector-card').forEach((card) => {
    card.addEventListener('click', () => {
      const template = card.dataset.sectorTemplate;
      if (!template) return;
      const textarea = document.getElementById('demo-textarea') as HTMLTextAreaElement | null;
      if (!textarea) return;
      // Solo pre-fill si está vacío · respetamos texto que el user ya escribió
      if (textarea.value.trim() === '') {
        textarea.value = template;
        textarea.dispatchEvent(new Event('input', { bubbles: true }));
      }
      // Después del scroll, focus para que vea el cursor en el textarea
      setTimeout(() => textarea.focus({ preventScroll: true }), 600);
    });
  });
</script>
