---
// Stats reales validadas · 6 cards en grid 3x2 · NO inventar números
interface Stat {
  numero: string;
  label: string;
  bodyHtml: string;
  fuente: string;
}
const stats: Stat[] = [
  {
    numero: '+40%',
    label: 'aumento en ventas',
    bodyHtml: 'Empresas que conectaron WhatsApp Business AI a su operación reportan crecimiento medible en facturación durante los primeros 90 días.',
    fuente: 'Fuente · WhatsApp Business AI · Casos India 2026',
  },
  {
    numero: '80%',
    label: 'de leads convertidos 24/7',
    bodyHtml: 'Negocios que perdían leads de noche o fin de semana ahora cierran 8 de cada 10 consultas que llegan fuera de horario laboral.',
    fuente: 'Fuente · Caso Soil Concept · 2026',
  },
  {
    numero: '-35%',
    label: 'en costos de servicio',
    bodyHtml: 'Mientras un agente humano cuesta entre $8-15 USD por consulta resuelta, un agente IA cuesta entre $0.15-2 USD por la misma tarea.',
    fuente: 'Fuente · ChatSpark · 2025-2026',
  },
  {
    numero: '+30%',
    label: 'de productividad operativa',
    bodyHtml: 'Equipos con WhatsApp automatizado integrado a CRM y agendas procesan 30% más interacciones sin contratar personal adicional.',
    fuente: 'Fuente · Gallabox · 2026',
  },
  {
    numero: '+45%',
    label: 'tasa de conversión e-commerce',
    bodyHtml: 'Conversaciones iniciadas con agentes IA conversacionales en e-commerce convierten al 45% — comparado con 2-3% de un sitio web tradicional.',
    fuente: 'Fuente · Rhino Agents · 2026',
  },
  {
    numero: '$4.4T',
    label: 'de impacto económico global',
    bodyHtml: 'McKinsey proyecta el impacto anual de IA generativa en empresas — y solo el 6% de empresas lo está capturando hoy. <strong class="text-zk-text">Esa es tu ventana.</strong>',
    fuente: 'Fuente · McKinsey State of AI · 2025',
  },
];
---
<section class="relative py-24 lg:py-32 border-t border-zk-border/50 overflow-hidden">
  <div class="absolute inset-0 spotlight pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-5 lg:px-8">

    <div class="text-center mb-14 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="text-xs font-mono text-zk-accent uppercase tracking-[0.2em]">Resultados que respaldan esto</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-5 leading-[1.05]">
        Esto ya está pasando<br>
        <span class="gradient-text">en cientos de empresas.</span>
      </h2>
      <p class="text-lg text-zk-text2 max-w-2xl mx-auto leading-relaxed">
        Datos reales medidos en empresas que ya implementaron IA empresarial. Tu negocio puede estar acá en menos de 3 meses.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 reveal mb-12">
      {stats.map((s) => (
        <div class="stat-card bg-gradient-to-br from-zk-surface to-zk-surface2 border border-zk-border2 rounded-2xl p-7 hover:border-zk-accent/40 transition">
          <div class="flex items-baseline gap-2 mb-3">
            <span class="text-5xl font-extrabold gradient-text counter-num">{s.numero}</span>
          </div>
          <div class="text-zk-text font-semibold mb-2">{s.label}</div>
          <div class="text-sm text-zk-text2 leading-relaxed mb-4" set:html={s.bodyHtml}></div>
          <div class="text-xs font-mono text-zk-muted">{s.fuente}</div>
        </div>
      ))}
    </div>

    <div class="text-center reveal max-w-2xl mx-auto">
      <p class="text-xs text-zk-muted leading-relaxed">
        Los resultados varían según sector, tamaño de operación y nivel de adopción. Estos son rangos medibles en pilotos reales de IA empresarial, no garantías. <strong class="text-zk-text">Nuestra propuesta gratuita estima el potencial específico de tu caso.</strong>
      </p>
    </div>
  </div>
</section>
