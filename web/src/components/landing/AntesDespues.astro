---
const filas = [
  { antes: 'Web desactualizada o sin presencia online', despues: 'Web profesional o tienda online optimizada' },
  { antes: 'Clientes en Excel, WhatsApp o la cabeza', despues: 'CRM que organiza y hace seguimiento automático' },
  { antes: 'Tú o un empleado contestando lo mismo 50 veces al día', despues: 'Agente IA que responde 24/7 en segundos' },
  { antes: 'Facturas en Word, cobros que se pierden', despues: 'Agente que factura, envía y persigue el cobro solo' },
  { antes: 'Citas que se olvidan, doble reserva', despues: 'Agenda inteligente que organiza y recuerda sola' },
  { antes: 'No sabes qué hacer para vender más', despues: 'Diagnóstico de marketing con plan de acción concreto' },
];
---

<section class="band" aria-labelledby="antes-titulo">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Tu empresa antes y después</p>
      <h2 id="antes-titulo" class="h2">
        Esto es lo que cambia<br />
        <span class="text-gradient">cuando pones IA a trabajar.</span>
      </h2>
    </div>

    <div class="tabla reveal">
      <div class="tabla__header">
        <div class="tabla__col tabla__col--antes">Sin Zenkai</div>
        <div class="tabla__col tabla__col--flecha"></div>
        <div class="tabla__col tabla__col--despues">Con Zenkai</div>
      </div>
      {filas.map((f) => (
        <div class="tabla__row">
          <div class="tabla__col tabla__col--antes">
            <span>{f.antes}</span>
          </div>
          <div class="tabla__col tabla__col--flecha">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="tabla__col tabla__col--despues">
            <span>{f.despues}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: 5rem;
    border-top: 1px solid var(--zk-border, #1f1f2c);
  }

  .wrap {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--zk-accent, #6366f1);
    margin-bottom: 0.75rem;
    text-align: center;
  }

  .h2 {
    font-family: 'Sora Variable', 'Sora', system-ui, sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--zk-heading, #f5f5fa);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .text-gradient {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tabla {
    border: 1px solid var(--zk-border, #1f1f2c);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .tabla__header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    background: rgba(99,102,241,0.08);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tabla__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    border-top: 1px solid var(--zk-border, #1f1f2c);
  }

  .tabla__col {
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
  }

  .tabla__col--antes {
    color: var(--zk-muted, #a1a1aa);
    font-size: 0.875rem;
  }

  .tabla__col--despues {
    color: var(--zk-heading, #f5f5fa);
    font-size: 0.875rem;
  }

  .tabla__col--flecha {
    justify-content: center;
    color: var(--zk-accent, #6366f1);
    padding: 0.9rem 0.25rem;
    flex-shrink: 0;
  }

  .tabla__header .tabla__col--antes {
    color: #ef4444;
  }

  .tabla__header .tabla__col--despues {
    color: #22c55e;
  }

  @media (max-width: 480px) {
    .tabla__header { display: none; }
    .tabla__row {
      display: flex;
      flex-direction: column;
      padding: 1rem;
      gap: 0.5rem;
    }
    .tabla__col--antes {
      color: #ef4444;
      font-size: 0.8125rem;
      padding: 0;
    }
    .tabla__col--despues {
      color: #22c55e;
      font-size: 0.8125rem;
      padding: 0;
    }
    .tabla__col--flecha {
      padding: 0.25rem 0;
      transform: rotate(90deg);
    }
    .tabla__col--flecha svg {
      width: 16px;
      height: 16px;
    }
  }
</style>
