---
/**
 * Hero.
 *
 * Qué salió y por qué:
 * · "+40% ventas · −35% costos · +30% productividad" — tres cifras sin ninguna
 *   fuente enlazable. En un sitio sin casos publicados, una cifra que no se
 *   puede comprobar no suma confianza: la resta, porque el comprador que sabe
 *   ya ha visto ese mismo +40% en otras diez landings.
 * · "12 agentes IA · Producción real" — afirmación sin respaldo y además habla
 *   de nuestra arquitectura, no de lo que compra el cliente.
 * · "Desde $90 USD/mes" — ya no es el precio de nada.
 *
 * Qué entró: el CTA primario es WhatsApp y es el elemento más grande del fold.
 * Es el único canal donde contesta una persona, y es lo que queremos que pase.
 * La demo pasa a segundo lugar: sigue siendo la mejor prueba de producto, pero
 * dejó de ser el objetivo.
 */
import WhatsAppCTA from '../WhatsAppCTA.astro';
import ShaderField from '../ShaderField.astro';
import Constelacion from '../Constelacion.astro';

const confianza = [
  'Sin tarjeta ni email para ver tu propuesta',
  'Contesta una persona, no un bot',
  'Sin permanencia obligatoria',
  'Precio fijado en tu moneda',
];
---
<section class="hero" data-hero>
  {/* Dos capas: la atmósfera (shader) da color y movimiento difuso; la
      constelación pone la estructura 3D con profundidad real encima. */}
  <ShaderField class="hero__bg" />
  <Constelacion class="hero__cons" />

  <div class="hero__wrap">
    <h1 class="hero__h1" data-zona="texto">
      <span class="hero__linea">Vende más.</span>
      <span class="hero__linea">Atiende a todos.</span>
      <span class="hero__linea hero__linea--acc">Opera con menos fricción.</span>
    </h1>

    <p class="hero__sub">
      Construimos los sistemas de IA que hacen esas tres cosas por ti: sobre las
      herramientas que ya usas, funcionando en días y no en trimestres.
    </p>

    <div class="hero__ctas">
      <span class="hero__ctaZona" data-zona="cta" data-luz>
      <WhatsAppCTA
        location="hero"
        message="Hola ZENKAI. Vengo de la web. Esto es lo que me está costando dinero ahora mismo:"
        label="Cuéntanos qué te cuesta dinero"
        size="lg"
      />
      </span>
      <a href="#hero-demo" class="hero__secundario">
        <span>O mira tu propuesta en 30 segundos</span>
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <ul class="hero__trust">
      {confianza.map((c) => (
        <li>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>{c}</span>
        </li>
      ))}
    </ul>

    <a href="#diagnostico" class="hero__scroll">
      <span>Empieza por tu problema</span>
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </a>
  </div>
</section>

<style>
  /* Tipadas a propósito. Sin @property el navegador las trata como texto:
     no interpolan, y un valor basura silencia la declaración entera en vez
     de caer al inicial. Registradas, el fallo es imposible y el motor puede
     animarlas en el hilo de composición. */
  @property --px  { syntax: '<number>'; initial-value: 0; inherits: true; }
  @property --py  { syntax: '<number>'; initial-value: 0; inherits: true; }
  @property --pxq { syntax: '<number>'; initial-value: 0; inherits: true; }

  .hero { position: relative; padding-block: 7rem 4.5rem; overflow: hidden; }
  @media (min-width: 1024px) { .hero { padding-block: 9rem 5.5rem; } }

  /* La atmósfera y la estructura 3D se colocan y se apilan a sí mismas: son
     estilos con ámbito de sus propios componentes y no de éste. Aquí sólo
     queda garantizar que el texto va por encima de las dos. */

  .hero__wrap {
    position: relative; z-index: 2;
    max-width: 60rem; margin: 0 auto; padding-inline: 1.25rem;
  }
  @media (min-width: 1024px) { .hero__wrap { padding-inline: 2rem; } }

  /* Entrada escalonada al cargar · CSS puro, sin esperar a JavaScript.
     Una sola orquestación al abrir la página crea más efecto que veinte
     microinteracciones sueltas, y no cuesta ni un byte de script. */
  /* Aquí sí se usa opacidad: es la carga inicial, dura 750 ms y termina sola
     sin depender de que el usuario haga nada. No deja contenido invisible
     esperando un scroll que quizá no llegue. */
  @keyframes entra {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: none; }
  }
  /* El titular NO se desvanece: sólo sube. La opacidad en el elemento LCP
     retrasa la métrica hasta que la animación termina — el navegador no
     cuenta como "pintado" un texto que está a opacidad 0. Sube y ya. */
  @keyframes sube {
    from { transform: translateY(20px); }
    to   { transform: none; }
  }
  .hero__h1 > * {
    animation: sube 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .hero__sub,
  .hero__ctas,
  .hero__trust,
  .hero__scroll {
    animation: entra 0.75s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  /* Cadena corta a propósito: termina entera en ~0,85 s. Con retardos más
     largos el CTA tardaba más de medio segundo en aparecer, y hacer esperar
     al elemento por el que existe la página es exactamente lo que no se debe
     hacer con una animación de entrada. */
  .hero__h1 > *:nth-child(1) { animation-delay: 0.03s; }
  .hero__h1 > *:nth-child(2) { animation-delay: 0.09s; }
  .hero__h1 > *:nth-child(3) { animation-delay: 0.15s; }
  .hero__sub    { animation-delay: 0.20s; }
  .hero__ctas   { animation-delay: 0.25s; }
  .hero__trust  { animation-delay: 0.30s; }
  .hero__scroll { animation-delay: 0.34s; }

  /* Sin movimiento: aparece y punto. Nada de esperas ni deslizamientos. */
  @media (prefers-reduced-motion: reduce) {
    .hero__h1 > *,
    .hero__sub,
    .hero__ctas,
    .hero__trust,
    .hero__scroll { animation: none; opacity: 1; }
  }

  .hero__h1 {
    font-size: clamp(2.5rem, 7.5vw, 4.75rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0 0 1.75rem;
  }
  .hero__linea { display: block; }

  /* Un solo acento en el fold.
     Antes el degradado iba de azul a violeta. Dos tintas de familias
     distintas en la línea más grande de la página compiten entre ellas y
     ninguna gana: el ojo lee "colorido", no "marca". Ahora es UNA tinta —
     el azul de ZENKAI — abriéndose a blanco frío, que es lo que hace la luz
     al incidir sobre una superficie. Y el brillo se desplaza con el puntero,
     de modo que la fuente de luz de la frase y la cámara de la constelación
     apuntan al mismo sitio. */
  .hero__linea--acc {
    background: linear-gradient(
      100deg,
      #2E7BE8 0%,
      #4A9EFF 28%,
      #EAF3FF 52%,
      #4A9EFF 76%,
      #2E7BE8 100%
    );
    background-size: 260% 100%;
    background-position: calc(50% + var(--pxq, 0) * 26%) 0;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    transition: background-position 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__linea--acc { transition: none; }
  }

  .hero__sub {
    font-size: clamp(1.0625rem, 2.1vw, 1.3125rem);
    line-height: 1.55;
    color: var(--zk-text-2);
    max-width: 46ch;
    margin: 0 0 2.5rem;
    text-wrap: pretty;
  }

  .hero__ctas {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.875rem 1.5rem; margin-bottom: 2.5rem;
  }
  /* ── El CTA es la fuente de luz ────────────────────────────────────────
     No un botón con sombra: un objeto que EMITE. El halo se desplaza con el
     puntero igual que el brillo del titular y que la cámara de la escena, y
     al cargar da un único pulso — una sola vez, a los 620 ms, cuando el
     resto del fold ya se ha posado. Un latido perpetuo se lee como banner
     publicitario; uno solo se lee como algo que acaba de encenderse. */
  .hero__ctaZona {
    position: relative;
    display: inline-flex;
    isolation: isolate;
  }
  .hero__ctaZona::before {
    content: '';
    position: absolute;
    inset: -70% -40%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      50% 50% at calc(50% + var(--px, 0) * 22%) calc(50% + var(--py, 0) * 30%),
      rgba(37, 211, 102, 0.34) 0%,
      rgba(37, 211, 102, 0.12) 42%,
      transparent 72%
    );
    opacity: 0;
    animation: enciende 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.62s forwards;
  }
  @keyframes enciende {
    0%   { opacity: 0;    transform: scale(0.82); }
    45%  { opacity: 1;    transform: scale(1.06); }
    100% { opacity: 0.72; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__ctaZona::before { animation: none; opacity: 0.72; }
  }

  .hero__secundario {
    display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 48px;
    color: var(--zk-text-2);
    font-size: 0.9375rem; font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .hero__secundario:hover { color: var(--zk-text); border-color: var(--zk-border-hi); }
  .hero__secundario:focus-visible { outline: 2px solid var(--zk-growth); outline-offset: 4px; }

  .hero__trust {
    list-style: none; margin: 0 0 3rem; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.625rem 1.5rem;
  }
  .hero__trust li {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.8125rem; color: var(--zk-muted);
  }
  .hero__trust svg { color: var(--zk-whatsapp); flex-shrink: 0; }

  .hero__scroll {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.75rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--zk-muted); text-decoration: none;
    transition: color 0.2s;
  }
  .hero__scroll:hover { color: var(--zk-text-2); }
  .hero__scroll svg { animation: flota 2.4s ease-in-out infinite; }
  @keyframes flota {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll svg { animation: none; }
  }

</style>

<script>
  import { iniciarCampo } from '../../lib/campo';

  // Una sola llamada arranca el campo para las cuatro capas: shader,
  // constelación, degradado del titular y halo del botón. Antes cada una
  // tenía su propio listener y su propia física.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) iniciarCampo(hero);
</script>
