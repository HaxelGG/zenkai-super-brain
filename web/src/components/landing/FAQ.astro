---
// FAQ acordeón · usa <details>/<summary> nativo · sin JS
interface QA {
  q: string;
  a: string;
}
const faqs: QA[] = [
  {
    q: '¿De verdad es gratis? ¿Después me van a llamar a vender?',
    a: 'Es gratis y no te llamamos. La propuesta se genera automáticamente, queda en tu pantalla, puedes descargarla o pedirla por WhatsApp. Si quieres hablar, <strong class="text-zk-text">tú agendas</strong>. Si no, te quedas con la propuesta. No hay sales pipeline persiguiéndote.',
  },
  {
    q: 'No vendo por internet todavía. ¿Esto es para mí?',
    a: 'Sí. El <strong class="text-zk-text">plan Starter</strong> está pensado justo para eso: asistente de IA por WhatsApp, panel propio, recordatorios y agenda de citas. Es la primera presencia digital que atiende sola, sin pedirte que antes inviertas en publicidad.',
  },
  {
    q: '¿Mis datos se quedan guardados? ¿Los venden?',
    a: 'Tu texto se procesa con Claude (Anthropic) para generar la propuesta. Si solo pruebas la demo sin dejar contacto, <strong class="text-zk-text">no queda nada nuestro</strong>. Si nos das email/WhatsApp para enviar el PDF, se guarda <em>solo</em> para mandarte ESA propuesta. No vendemos data. Nunca.',
  },
  {
    /* Decía "Facturamos en USD" y a continuación explicaba que el precio en
       euros es un precio de lista fijado. Las dos cosas no pueden ser
       ciertas a la vez, y la contradicción estaba en la respuesta que un
       comprador europeo lee antes de decidir. */
    q: '¿En qué países operan? ¿En qué moneda se paga?',
    a: 'Equipo remoto entre <strong class="text-zk-text">Pereira (Colombia)</strong>, <strong class="text-zk-text">Barcelona</strong> y <strong class="text-zk-text">Murcia (España)</strong>. Servimos clientes en LATAM, España y EE.UU. <strong class="text-zk-text">Cada precio está fijado en su moneda</strong> y se factura en ella: el importe en euros que ves arriba es el que vas a pagar en euros, no una conversión del día que después no cuadra con la factura. Los importes en EUR y COP van sin IVA.',
  },
  {
    q: '¿Puedo implementar la propuesta con otra agencia?',
    a: 'Sí. La propuesta es tuya. Te decimos exactamente qué herramientas usar, qué configurar, qué automatizar. Si encuentras otra agencia que lo haga más barato o mejor, adelante. <strong class="text-zk-text">Si decides que prefieres trabajar con quienes diseñaron la arquitectura, hablamos.</strong>',
  },
  {
    q: '¿Y si mi cliente no habla español? ¿La IA atiende en otros idiomas?',
    a: 'Sí. Nuestros agentes IA conversacionales operan en <strong class="text-zk-text">español, inglés y portugués</strong> nativamente. Tu cliente puede tener clientes en cualquier idioma — la IA los atiende sin que tengas que pensarlo. Un solo sistema, múltiples idiomas según quien escribe.',
  },
];
---
<section id="faq" class="py-20 lg:py-24 border-t border-zk-border/50 relative">

  <div class="max-w-3xl mx-auto px-5 lg:px-8">

    <div class="text-center mb-12 reveal">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="w-8 h-px bg-zk-accent"></div>
        <span class="t-eyebrow">Preguntas frecuentes</span>
        <div class="w-8 h-px bg-zk-accent"></div>
      </div>
      <h2 class="t-h2 mb-5">Lo que todos preguntan antes de probar</h2>
    </div>

    <div class="space-y-3 reveal">
      {faqs.map((f) => (
        <details class="group bg-gradient-to-br from-zk-surface to-zk-surface2 border border-zk-border2 rounded-xl overflow-hidden hover:border-zk-accent/40 transition">
          <summary class="faq__q">
            <span>{f.q}</span>
            <svg class="w-5 h-5 shrink-0 text-zk-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="faq__a" set:html={f.a}></div>
        </details>
      ))}
    </div>

    {/* Las tres preguntas que faltan aquí —descuentos, permanencia y por qué
        publicamos precios— estaban repetidas palabra por palabra en el FAQ de
        /precios. Repetir una respuesta no la hace más creíble; sólo alarga la
        página y obliga a mantener dos copias que acaban divergiendo. */}
    <p class="faq__pie reveal">
      Las dudas sobre precio, permanencia y facturación están respondidas en
      <a href="/precios/">la página de precios</a>.
    </p>
  </div>
</section>

<style>
  /* El enunciado iba en --zk-text-2 y la respuesta también: pregunta y
     respuesta con el mismo peso y el mismo color hacen que el acordeón se lea
     como un muro. El enunciado es lo que se escanea. */
  .faq__q {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.25rem 1.5rem; cursor: pointer;
    font-size: var(--t-card); font-weight: 600; color: var(--zk-text);
    min-height: 44px;
  }
  .faq__a {
    padding: 0 1.5rem 1.25rem;
    font-size: var(--t-micro); line-height: 1.65; color: var(--zk-text-2);
    max-width: 68ch;
  }
  .faq__pie {
    margin: 1.75rem 0 0; text-align: center;
    font-size: var(--t-micro); color: var(--zk-muted);
  }
  .faq__pie a { color: var(--zk-growth); text-decoration: none; font-weight: 550; }
  .faq__pie a:hover { text-decoration: underline; }
</style>
