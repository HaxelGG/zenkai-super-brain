---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'ZENKAI · AI Growth Systems',
  description = 'Digitalizamos tu empresa con IA. Más ventas, menos costos, procesos automatizados.',
  ogImage = '/brand/og-image.png',
  canonical = Astro.url.href,
  noindex = false,
} = Astro.props;

// og:image y twitter:image DEBEN ser absolutas: los scrapers (WhatsApp, Slack,
// Twitter, LinkedIn) no resuelven rutas relativas y descartan la preview entera.
const site = Astro.site ?? new URL('https://zenkai.systems');
const absolute = (path: string) => new URL(path, site).href;
const ogImageUrl = absolute(ogImage);

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ZENKAI',
  alternateName: 'ZENKAI AI Agency',
  url: 'https://zenkai.systems',
  logo: absolute('/brand/zenkai-logo-horizontal.png'),
  email: 'hola@zenkai.systems',
  areaServed: ['CO', 'ES', 'MX', 'AR', 'CL', 'PE', 'US'],
  description:
    'Agencia de inteligencia artificial con 5 productos integrados: motor comercial, atencion al cliente, facturacion, redes sociales y stack de agentes IA.',
  foundingDate: '2025',
  knowsAbout: [
    'Inteligencia Artificial',
    'Automatizacion Comercial',
    'Agentes de IA',
    'Chatbots',
    'RAG',
    'Automatizacion de Redes Sociales',
    'Facturacion Electronica',
  ],
  sameAs: [
    'https://zenkai.systems',
  ],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#08080C" />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="ZENKAI · AI Growth Systems" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="ZENKAI Growth Systems" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content="ZENKAI · AI Growth Systems" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
