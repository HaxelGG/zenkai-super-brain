---
/**
 * Constelación 3D · estructura neuronal con profundidad real.
 *
 * ── Por qué esto y no más shader ──────────────────────────────────────────
 * El campo de ruido daba atmósfera pero no leía como 3D: era una textura
 * plana que se movía. Esto es geometría de verdad — nodos en un espacio
 * tridimensional, proyectados con perspectiva, rotando sobre dos ejes y
 * reaccionando al puntero como si la cámara se inclinara.
 *
 * ── La escala es la idea ──────────────────────────────────────────────────
 * Antes la nube tenía un radio fijo de 310 px. En un monitor de 1440 eso es
 * un adorno del tamaño de un logotipo flotando en medio del texto: se lee
 * como un widget pegado, no como un espacio. Ahora el radio se deriva del
 * hero, así que la estructura OCUPA la pantalla y el titular está DENTRO de
 * ella, no delante. Que el texto abra un hueco en la red — la oclusión de
 * más abajo — sólo significa algo si hay red alrededor del texto.
 *
 * ── Por qué Canvas 2D y no WebGL ──────────────────────────────────────────
 * La escena son un par de centenares de puntos y unas cuantas centenas de
 * líneas. En WebGL eso obliga a regenerar buffers cada fotograma o a montar
 * instancing para algo que Canvas 2D dibuja sin despeinarse. Y ahorra la
 * compilación del shader, que era el pico de bloqueo medido en la carga.
 *
 * Se sabe que el objetivo puede ser una gráfica integrada (medido en una
 * Intel UHD 620), así que todo está dimensionado para eso:
 * · La proyección es aritmética plana, sin matrices ni librerías.
 * · Las líneas se calculan sobre una rejilla espacial, no comparando todos
 *   los pares: con 200 nodos serían 19.900 comparaciones por fotograma.
 * · 30 fps, resolución limitada y parada total fuera de pantalla.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class:list={['cons', className]} data-constelacion aria-hidden="true"></div>

<style>
  /* La capa se coloca a sí misma. Los estilos del hero llegan aquí como
     estilos con ámbito del PADRE y no alcanzan la raíz de este componente:
     dejar aquí la posición, la opacidad y el orden de apilado es lo único
     que garantiza que la escena esté donde tiene que estar. */
  .cons {
    position: absolute; inset: 0; z-index: 1;
    overflow: hidden; pointer-events: none;
    opacity: 0.92;
  }
  /* En móvil el texto ocupa todo el ancho y competir con él sería quitarle
     legibilidad, no añadir atmósfera. */
  @media (max-width: 899px) { .cons { opacity: 0.42; } }
  .cons :global(canvas) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .cons :global(canvas.listo) { opacity: 1; }
</style>

<script>
  import { objetivo, zonas, LERP } from '../lib/campo';

  interface Nodo {
    /** Coordenadas en la ESFERA UNIDAD · el radio en píxeles se aplica al
     *  proyectar, para que la escena escale con el hero sin regenerar nada. */
    x: number; y: number; z: number;
    /** Deriva propia · sin esto la nube gira rígida y se nota que es un truco. */
    vx: number; vy: number; vz: number;
    r: number;
    pulso: number;
    /** 0-1 · sube de golpe cuando le llega una señal y decae solo. */
    carga: number;
  }

  /**
   * Señal viajando por la red.
   *
   * Es lo que convierte "una nube de puntos bonita" en algo que parece estar
   * PENSANDO. Una constelación que sólo rota es decorado; una por la que
   * circulan impulsos de un nodo a otro se lee como una red que procesa —
   * que es literalmente lo que vende la empresa.
   */
  interface Senal {
    desde: number;
    hasta: number;
    /** 0 → 1 recorrido de la arista. */
    t: number;
    vel: number;
  }

  const montar = (host: HTMLElement) => {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;
    host.appendChild(canvas);

    const quieto = matchMedia('(prefers-reduced-motion: reduce)');
    const angosto = window.innerWidth < 900;

    // Menos nodos en pantallas pequeñas: el móvil tiene menos sitio y menos GPU.
    const N = angosto ? 80 : 200;

    const nodos: Nodo[] = Array.from({ length: N }, () => {
      // Distribución en el VOLUMEN de la esfera. Usar ángulos al azar sin la
      // raíz cúbica amontona los puntos en el centro y se ve como una bola.
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      const r = Math.cbrt(Math.random());
      return {
        x: r * Math.sin(phi) * Math.cos(theta),
        y: r * Math.sin(phi) * Math.sin(theta) * 0.78,
        z: r * Math.cos(phi),
        vx: (Math.random() - 0.5) * 0.0006,
        vy: (Math.random() - 0.5) * 0.0006,
        vz: (Math.random() - 0.5) * 0.0006,
        r: 0.9 + Math.random() * 1.9,
        pulso: Math.random() * Math.PI * 2,
        carga: 0,
      };
    });

    // Las aristas activas de este fotograma · las rellena el bucle de dibujo y
    // las consumen las señales para saber por dónde pueden viajar.
    let aristas: Array<[number, number]> = [];
    const senales: Senal[] = [];
    const MAX_SENALES = angosto ? 6 : 16;

    let w = 0, h = 0, dpr = 1;
    let RADIO = 320, FOCAL = 640, DIST_ENLACE = 120;
    let cxCentro = 0, cyCentro = 0;
    // Desplazamiento del canvas dentro del hero. Si algún día la escena deja
    // de cubrirlo entero, sus píxeles no serían los del hero y la máscara del
    // titular caería en el sitio equivocado.
    let offX = 0, offY = 0;
    const hero = host.closest<HTMLElement>('[data-hero]');

    const medir = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const cw = host.clientWidth, ch = host.clientHeight;
      if (cw === w && ch === h) return;
      w = cw; h = ch;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // La escena se dimensiona con el hero, no al revés.
      RADIO = Math.max(300, Math.min(w * 0.44, h * 0.68));
      FOCAL = RADIO * 2.1;
      DIST_ENLACE = RADIO * 0.30;
      // Desplazada a la derecha en escritorio: la columna de texto vive a la
      // izquierda y así el núcleo denso queda libre, pero la periferia sigue
      // envolviendo al titular. En móvil, centrada.
      cxCentro = w * (angosto ? 0.5 : 0.63);
      cyCentro = h * 0.47;

      if (hero) {
        const a = host.getBoundingClientRect(), b = hero.getBoundingClientRect();
        offX = a.left - b.left;
        offY = a.top - b.top;
      }
    };
    medir();

    // La cámara la mueve el campo compartido · sin listener propio y sin
    // medir el DOM dentro de un evento de puntero, que era un reflow
    // síncrono por cada movimiento del ratón.
    let camX = 0, camY = 0;

    const proy = new Float32Array(N * 4); // x, y, escala, profundidad 0-1

    /**
     * Ensamblaje.
     *
     * Antes el canvas se limitaba a hacer un fundido de opacidad. Ahora la
     * estructura SE CONSTRUYE: los nodos salen del centro escalonados por su
     * distancia — núcleo primero, periferia después — y las aristas no existen
     * hasta que hay algo que conectar.
     *
     * No es un adorno: es lo único del fold que significa literalmente lo que
     * vende la empresa. Y de paso, durante el primer medio segundo no se
     * construye la rejilla ni se traza una línea, justo cuando el hilo
     * principal está más ocupado.
     */
    const ARRANQUE = 1250;
    const REPARTO = 0.45;
    // Anclado al PRIMER FOTOGRAMA REAL, no al montaje: el bucle vive dentro de
    // un requestIdleCallback y en una gráfica integrada puede entrar más de un
    // segundo tarde. Así el ensamblaje se ve siempre.
    let t0 = 0;
    const aten = new Float32Array(N);
    const onda = new Float32Array(N);

    const dibujar = (t: number) => {
      medir();
      if (!t0) t0 = t;
      const bruto = (t - t0) / ARRANQUE;
      const b = Math.min(1, bruto);
      const ga = Math.max(0, (b - REPARTO) / (1 - REPARTO));
      const gAristas = ga * ga * (3 - 2 * ga);

      // ── Barrido ────────────────────────────────────────────────────────
      // Cuando la estructura ya está montada, una única onda de luz la
      // recorre de izquierda a derecha encendiendo lo que toca. Es el
      // momento en que la red deja de construirse y arranca — y ocurre UNA
      // vez, al cargar. Un barrido en bucle sería un banner; uno solo es un
      // encendido.
      const ONDA_ANCHO = RADIO * 0.5;
      let ondaX = -1e9, ondaFuerza = 0;
      if (bruto > 0.5 && bruto < 1.75) {
        const u = (bruto - 0.5) / 1.25;
        ondaX = -ONDA_ANCHO + u * (w + ONDA_ANCHO * 2);
        // Entra rápido y se apaga despacio, para que no corte en seco.
        ondaFuerza = Math.min(1, u * 5) * (1 - u) * 1.35;
      }

      const o = objetivo();
      camX += (o.x * 0.9 - camX) * LERP;
      camY += (o.y * 0.6 - camY) * LERP;
      const zs = zonas();

      const rotY = t * 0.000085 + camX;
      const rotX = Math.sin(t * 0.00006) * 0.16 + camY;
      const cy = Math.cos(rotY), sy = Math.sin(rotY);
      const cx = Math.cos(rotX), sx = Math.sin(rotX);

      ctx.clearRect(0, 0, w, h);

      for (let i = 0; i < N; i++) {
        const n = nodos[i];
        // Deriva propia, contenida dentro de la esfera unidad.
        n.x += n.vx; n.y += n.vy; n.z += n.vz;
        if (n.x * n.x + n.y * n.y + n.z * n.z > 1) { n.vx *= -1; n.vy *= -1; n.vz *= -1; }

        // Sale del centro. La fase es proporcional al radio, no aleatoria: así
        // lee como crecimiento desde un núcleo y no como ruido que se posa.
        const fase = Math.hypot(n.x, n.y, n.z) * REPARTO;
        const p = Math.min(1, Math.max(0, (b - fase) / (1 - REPARTO)));
        const e = 1 - (1 - p) * (1 - p) * (1 - p); // llega y se asienta
        const k = RADIO * e;
        const nx = n.x * k, ny = n.y * k, nz = n.z * k;

        // Rotación en Y y luego en X · a mano, sin matrices.
        const x1 = nx * cy - nz * sy;
        const z1 = nx * sy + nz * cy;
        const y2 = ny * cx - z1 * sx;
        const z2 = ny * sx + z1 * cx;

        // Perspectiva: lo cercano se agranda, lo lejano se encoge.
        const esc = FOCAL / (FOCAL + z2 + RADIO);
        const px = cxCentro + x1 * esc;
        const py = cyCentro + y2 * esc;
        proy[i * 4] = px;
        proy[i * 4 + 1] = py;
        proy[i * 4 + 2] = esc * (0.3 + 0.7 * e);
        proy[i * 4 + 3] = Math.max(0, Math.min(1, (z2 + RADIO) / (RADIO * 2)));

        // ── Oclusión · el titular y el botón TIENEN presencia en la escena ──
        // Las estrellas se apagan donde hay una palabra y se vuelven a
        // encender al lado. Es la señal de profundidad más fuerte que existe
        // y, a la vez, la garantía de contraste que ninguna herramienta
        // automática puede medir sobre un canvas.
        let f = 1;
        const hx = px + offX, hy = py + offY; // píxeles del canvas → del hero
        for (let z = 0; z < zs.length; z++) {
          const c = zs[z];
          const dx = hx < c.x0 ? c.x0 - hx : hx > c.x1 ? hx - c.x1 : 0;
          const dy = hy < c.y0 ? c.y0 - hy : hy > c.y1 ? hy - c.y1 : 0;
          if (dx > c.halo || dy > c.halo) continue; // salida rápida
          const s = Math.min(1, Math.hypot(dx, dy) / c.halo);
          const sm = s * s * (3 - 2 * s);
          if (sm < f) f = sm;
        }
        aten[i] = f;

        // Intensidad del barrido en este nodo · se calcula aquí, con la
        // proyección fresca, para que las aristas también puedan encenderse
        // al paso de la onda. Si sólo se encendieran los puntos, la red se
        // vería parpadear en lugar de conducir.
        let on = 0;
        if (ondaFuerza > 0) {
          const d = Math.abs(px - ondaX);
          if (d < ONDA_ANCHO) {
            const u = 1 - d / ONDA_ANCHO;
            on = u * u * ondaFuerza;
          }
        }
        onda[i] = on;
      }

      // ── Aristas ────────────────────────────────────────────────────────
      // Rejilla espacial: cada nodo sólo se compara con los de su celda y las
      // vecinas. Comparar todos contra todos serían 19.900 pares por fotograma
      // en una gráfica integrada, y se nota.
      const celda = DIST_ENLACE;
      const rejilla = new Map<number, number[]>();
      for (let i = 0; i < N; i++) {
        const gx = Math.floor(proy[i * 4] / celda);
        const gy = Math.floor(proy[i * 4 + 1] / celda);
        const k = gx * 73856093 + gy * 19349663;
        const l = rejilla.get(k);
        if (l) l.push(i); else rejilla.set(k, [i]);
      }

      aristas = [];
      ctx.lineWidth = 0.7;
      for (let i = 0; i < N; i++) {
        const xi = proy[i * 4], yi = proy[i * 4 + 1];
        const gx = Math.floor(xi / celda), gy = Math.floor(yi / celda);
        for (let ox = -1; ox <= 1; ox++) {
          for (let oy = -1; oy <= 1; oy++) {
            const vec = rejilla.get((gx + ox) * 73856093 + (gy + oy) * 19349663);
            if (!vec) continue;
            for (const j of vec) {
              if (j <= i) continue;
              const dx = xi - proy[j * 4], dy = yi - proy[j * 4 + 1];
              const d = Math.hypot(dx, dy);
              if (d > DIST_ENLACE) continue;
              aristas.push([i, j]);
              // La opacidad cae con la distancia Y con la profundidad: así el
              // fondo se difumina y el ojo lee volumen.
              const prof = (proy[i * 4 + 3] + proy[j * 4 + 3]) * 0.5;
              // La onda multiplica el trazo hasta 3,5× a su paso: es lo que
              // hace que se lea como corriente recorriendo la red y no como
              // un puñado de puntos que se iluminan por su cuenta.
              const luz = 1 + (onda[i] + onda[j]) * 1.25;
              const a = Math.min(0.85, (1 - d / DIST_ENLACE) * 0.32 * (0.25 + prof * 0.75)
                      * gAristas * Math.min(aten[i], aten[j]) * luz);
              if (a < 0.012) continue;
              const t2 = Math.min(1, (onda[i] + onda[j]) * 0.5);
              ctx.strokeStyle = `rgba(${(90 + t2 * 110) | 0},${(150 + t2 * 70) | 0},255,${a.toFixed(3)})`;
              ctx.beginPath();
              ctx.moveTo(xi, yi);
              ctx.lineTo(proy[j * 4], proy[j * 4 + 1]);
              ctx.stroke();
            }
          }
        }
      }

      // ── Señales viajando por la red ────────────────────────────────────
      // Nacen en una arista al azar, la recorren, y al llegar cargan el nodo
      // de destino y saltan a una arista contigua. El efecto es el de una red
      // que conduce, no una que decora.
      while (senales.length < MAX_SENALES && aristas.length > 0) {
        const [a, b2] = aristas[(Math.random() * aristas.length) | 0];
        senales.push({ desde: a, hasta: b2, t: 0, vel: 0.006 + Math.random() * 0.012 });
      }

      for (let s = senales.length - 1; s >= 0; s--) {
        const sn = senales[s];
        sn.t += sn.vel;
        if (sn.t >= 1) {
          nodos[sn.hasta].carga = 1;
          // Saltar a una arista que salga del nodo alcanzado · si no hay
          // ninguna (la red cambia cada fotograma), la señal muere.
          const salidas = aristas.filter((e) => e[0] === sn.hasta || e[1] === sn.hasta);
          if (salidas.length === 0) { senales.splice(s, 1); continue; }
          const e = salidas[(Math.random() * salidas.length) | 0];
          sn.desde = sn.hasta;
          sn.hasta = e[0] === sn.desde ? e[1] : e[0];
          sn.t = 0;
          continue;
        }
        // Una señal no puede brillar sobre una palabra: la oclusión manda
        // también aquí, o el impulso más luminoso de la escena sería
        // justamente el que cruza el titular.
        const vis = Math.min(aten[sn.desde], aten[sn.hasta]) * gAristas;
        if (vis < 0.04) continue;

        const ax = proy[sn.desde * 4], ay = proy[sn.desde * 4 + 1];
        const bx = proy[sn.hasta * 4], by = proy[sn.hasta * 4 + 1];
        const px = ax + (bx - ax) * sn.t;
        const py = ay + (by - ay) * sn.t;

        // Estela: un tramo corto por detrás de la cabeza, no un punto suelto.
        const tr = Math.max(0, sn.t - 0.28);
        ctx.strokeStyle = `rgba(140,200,255,${(0.5 * vis).toFixed(3)})`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(ax + (bx - ax) * tr, ay + (by - ay) * tr);
        ctx.lineTo(px, py);
        ctx.stroke();
        ctx.lineWidth = 0.7;

        ctx.fillStyle = `rgba(200,230,255,${(0.95 * vis).toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(px, py, 1.9, 0, 6.283185);
        ctx.fill();
      }

      // ── Nodos ──────────────────────────────────────────────────────────
      for (let i = 0; i < N; i++) {
        const n = nodos[i];
        const esc = proy[i * 4 + 2];
        const prof = proy[i * 4 + 3];
        const late = 0.75 + Math.sin(t * 0.0013 + n.pulso) * 0.25;

        // La carga decae sola tras recibir una señal · el nodo "se enciende"
        // al paso del impulso y vuelve a su estado en poco menos de un segundo.
        n.carga *= 0.94;
        // El barrido se suma a la carga sin escribirla: si la escribiera,
        // los 200 nodos quedarían encendidos al mismo tiempo y la decadencia
        // posterior se leería como un parpadeo global.
        const brillo = Math.min(1, n.carga + onda[i]) * aten[i];

        const radio = n.r * esc * late * (1 + brillo * 2.4);
        // Los cercanos tiran a blanco frío, los lejanos a azul profundo: separa
        // los planos sin desenfoque, que en Canvas 2D sería caro. Una sola
        // familia de tinta — el azul de marca — como en el titular.
        const rojo = Math.round(74 + prof * 96 + brillo * 85);
        const verde = Math.round(158 + prof * 42 + brillo * 60);
        const alfa = Math.min(1, ((0.2 + prof * 0.75) * 0.9 + brillo * 0.6) * aten[i]);
        if (alfa < 0.01) continue;

        // Halo sólo en los nodos encendidos: dibujarlo en los 200 sería caro
        // y visualmente sucio.
        if (brillo > 0.06) {
          const g = ctx.createRadialGradient(
            proy[i * 4], proy[i * 4 + 1], 0,
            proy[i * 4], proy[i * 4 + 1], radio * 7,
          );
          g.addColorStop(0, `rgba(150,205,255,${(brillo * 0.42).toFixed(3)})`);
          g.addColorStop(1, 'rgba(150,205,255,0)');
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(proy[i * 4], proy[i * 4 + 1], radio * 7, 0, 6.283185);
          ctx.fill();
        }

        ctx.fillStyle = `rgba(${rojo},${Math.min(255, verde)},255,${alfa.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(proy[i * 4], proy[i * 4 + 1], Math.max(0.35, radio), 0, 6.283185);
        ctx.fill();
      }

      canvas.classList.add('listo');
    };

    const INTERVALO = 1000 / 30;
    let ultimo = 0, raf = 0, corriendo = false;
    const bucle = (t: number) => {
      raf = requestAnimationFrame(bucle);
      if (t - ultimo < INTERVALO) return;
      ultimo = t;
      dibujar(t);
    };
    const arrancar = () => { if (corriendo || quieto.matches) return; corriendo = true; raf = requestAnimationFrame(bucle); };
    const parar = () => { corriendo = false; cancelAnimationFrame(raf); };

    if (quieto.matches) {
      // Anclar t0 a mano ANTES de pintar: si se deja que lo fije el propio
      // fotograma, b sale 0 y la escena se dibuja colapsada en el centro —
      // que es exactamente lo contrario de lo que necesita quien no quiere
      // movimiento: la estructura ya montada, quieta.
      t0 = 1;
      dibujar(1 + ARRANQUE);
    } else {
      arrancar();
    }

    document.addEventListener('visibilitychange', () => (document.hidden ? parar() : arrancar()));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => (e.isIntersecting ? arrancar() : parar()), { threshold: 0 }).observe(host);
    }
  };

  const iniciar = () => document.querySelectorAll<HTMLElement>('[data-constelacion]').forEach(montar);
  if ('requestIdleCallback' in window) {
    (window as Window & typeof globalThis).requestIdleCallback(iniciar, { timeout: 2000 });
  } else {
    setTimeout(iniciar, 700);
  }
</script>
