---
export const prerender = true;

import WebLayout from '../layouts/WebLayout.astro';
import PlanZenkai from '../components/landing/PlanZenkai.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import FAQ from '../components/landing/FAQ.astro';

const preguntasFrecuentes = [
  {
    q: '¿Hay algún coste oculto?',
    a: 'No. 500€ de implementación + 95€/mes de mantenimiento. Esos son los únicos dos números que vas a ver en tu factura. No cobramos por módulo, por usuario ni por volumen de uso.',
  },
  {
    q: '¿Puedo contratar solo una parte del plan?',
    a: 'El Plan Zenkai es un sistema integrado. Cada componente depende de los demás: el CRM alimenta al agente de ventas, la facturación se conecta con el CRM, la agenda se sincroniza con la atención al cliente. Separarlos sería como venderte un coche sin ruedas.',
  },
  {
    q: '¿Cómo funciona la garantía de 14 días?',
    a: 'Si en las dos primeras semanas no ves resultados, nos escribes y te devolvemos los 500€ de implementación. Sin preguntas, sin letra pequeña. No hemos tenido que hacer ninguna devolución todavía.',
  },
  {
    q: '¿Qué pasa si necesito algo más adelante que no está en el plan?',
    a: 'Lo construimos. El ecosistema Zenkai tiene 5 productos y si necesitas algo específico para tu sector, lo desarrollamos sobre la misma infraestructura. El coste de personalizaciones se presupuesta aparte.',
  },
  {
    q: '¿Puedo cancelar el mantenimiento cuando quiera?',
    a: 'Sí. El mantenimiento de 95€/mes se paga mes a mes, sin permanencia. Si cancelas, el sistema sigue funcionando pero sin actualizaciones ni soporte.',
  },
];
---

<WebLayout
  title="Precios · Plan Zenkai · 500€ + 95€/mes · ZENKAI"
  description="Un solo plan. Un solo precio. Todo incluido. 500€ de implementación + 95€/mes de mantenimiento. Sin costes ocultos, sin permanencia. Garantía de devolución de 14 días."
  canonical="https://zenkai.systems/precios/"
>
  <section class="pt-12 pb-4">
    <div class="max-w-3xl mx-auto px-5 text-center reveal">
      <p class="text-xs font-mono text-zk-muted uppercase tracking-widest mb-4">Precios</p>
      <h1 class="text-4xl md:text-5xl font-bold font-display tracking-tight mb-4">
        Un plan.<br />
        <span class="bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">Un precio.</span>
      </h1>
      <p class="text-lg text-zk-text2 max-w-xl mx-auto">
        No vendemos módulos sueltos. No hay planes Basic, Pro ni Enterprise. Hay un sistema completo que incluye todo lo que tu empresa necesita para funcionar con IA.
      </p>
    </div>
  </section>

  <PlanZenkai />

  <section class="py-16 border-t border-zk-border">
    <div class="max-w-2xl mx-auto px-5">
      <h2 class="text-2xl font-bold font-display text-center mb-10">Preguntas frecuentes sobre el precio</h2>
      <div class="space-y-3">
        {preguntasFrecuentes.map((item, i) => (
          <details class="border border-zk-border rounded-lg overflow-hidden faq-anim" open={i === 0}>
            <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer text-sm font-medium text-zk-text hover:text-white transition-colors list-none">
              {item.q}
              <svg class="w-4 h-4 flex-shrink-0 text-zk-muted" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="faq-content"><div class="px-4 pb-4 text-sm text-zk-text2 leading-relaxed">{item.a}</div></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-zk-border text-center">
    <div class="max-w-xl mx-auto px-5">
      <h2 class="text-xl font-bold font-display mb-3">¿Listo para empezar?</h2>
      <p class="text-zk-text2 mb-6">Sin letra pequeña. Sin sorpresas.</p>
      <WhatsAppCTA
        location="precios-cierre"
        message="Hola ZENKAI. He visto los precios y quiero empezar con el Plan Zenkai."
        label="Hablar por WhatsApp"
        size="lg"
      />
    </div>
  </section>
</WebLayout>
