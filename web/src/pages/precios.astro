---
export const prerender = true;

import WebLayout from '../layouts/WebLayout.astro';
import PricingTiers from '../components/landing/PricingTiers.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

const preguntasFrecuentes = [
  {
    q: '¿Hay algún coste oculto?',
    a: 'No. Pagas la implementacion una vez y el plan mensual que elijas. No cobramos por usuario, por modulo ni por volumen de uso. Lo que ves es lo que pagas.',
  },
  {
    q: '¿Puedo cambiar de plan?',
    a: 'Si. Puedes subir de Starter a Growth o bajar cuando quieras. Solo pagas la diferencia del mes en curso.',
  },
  {
    q: '¿Como funciona la garantia de 14 dias?',
    a: 'Si en las dos primeras semanas no ves resultados, nos escribes y te devolvemos la implementacion. Sin preguntas, sin letra pequena.',
  },
  {
    q: '¿Que incluyen las campanas publicitarias del plan Growth?',
    a: 'Dos campanas al mes en Meta o Google Ads. El coste de la publicidad esta incluido en tu cuota. Nosotros disenamos, lanzamos y optimizamos.',
  },
  {
    q: '¿Puedo cancelar cuando quiera?',
    a: 'Si. Todos los planes se pagan mes a mes, sin permanencia.',
  },
];
---

<WebLayout
  title="Precios · Planes de IA para empresas · ZENKAI"
  description="Starter 95€/mes, Growth 440€/mes con campanas publicitarias incluidas, Enterprise custom. Garantia de devolucion de 14 dias. Sin permanencia."
  canonical="https://zenkai.systems/precios/"
>
  <section class="pt-12 pb-4">
    <div class="max-w-3xl mx-auto px-5 text-center reveal">
      <p class="text-xs font-mono text-zk-muted uppercase tracking-widest mb-4">Precios</p>
      <h1 class="text-4xl md:text-5xl font-bold font-display tracking-tight mb-4">
        Planes que escalan<br />
        <span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">con tu negocio.</span>
      </h1>
      <p class="text-lg text-zk-text2 max-w-xl mx-auto">
        Desde automatizacion basica hasta infraestructura de IA completa.
        Una sola plataforma. Paga por la capacidad que necesitas.
      </p>
    </div>
  </section>

  <PricingTiers />

  <section class="py-16 border-t border-zk-border">
    <div class="max-w-2xl mx-auto px-5">
      <h2 class="text-2xl font-bold font-display text-center mb-10">Preguntas frecuentes sobre precios</h2>
      <div class="space-y-3">
        {preguntasFrecuentes.map((item, i) => (
          <details class="border border-zk-border rounded-lg overflow-hidden faq-anim" open={i === 0}>
            <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer text-sm font-medium text-zk-text hover:text-white transition-colors list-none">
              {item.q}
              <svg class="w-4 h-4 flex-shrink-0 text-zk-muted" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="faq-content"><div class="px-4 pb-4 text-sm text-zk-text2 leading-relaxed">{item.a}</div></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-zk-border text-center">
    <div class="max-w-xl mx-auto px-5">
      <h2 class="text-xl font-bold font-display mb-3">¿Listo para empezar?</h2>
      <p class="text-zk-text2 mb-6">Sin letra pequeña. Sin sorpresas.</p>
      <WhatsAppCTA
        location="precios-cierre"
        message="Hola ZENKAI. He visto los precios y quiero empezar."
        label="Hablar por WhatsApp"
        size="lg"
      />
    </div>
  </section>
</WebLayout>
