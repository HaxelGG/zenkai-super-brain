---
export const prerender = true;

import WebLayout from '../layouts/WebLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import ComoFunciona from '../components/landing/ComoFunciona.astro';

const site = Astro.site ?? new URL('https://zenkai.systems');
const url = new URL('/como-trabajamos/', site).href;

const detalleProceso = [
  {
    paso: '01',
    titulo: 'Te escuchamos',
    detalle: 'En una videollamada de 15 minutos nos cuentas tu negocio: qué haces, qué te duele, qué quieres conseguir. Sin PowerPoint. Sin compromiso. Al terminar ya sabes si Zenkai encaja contigo.',
  },
  {
    paso: '02',
    titulo: 'Montamos tu sistema',
    detalle: 'En 7 días laborables configuramos todo: tu web o tienda online, el CRM con tu pipeline de ventas, los agentes de IA entrenados con los datos de tu negocio, la facturación con tus productos y precios, y la agenda conectada a tu calendario. Tú solo nos das acceso a lo básico.',
  },
  {
    paso: '03',
    titulo: 'Empiezas a vender',
    detalle: 'El sistema queda funcionando. Tus clientes escriben y el agente responde. Tus leads entran al CRM. Tus facturas se emiten solas. Tu agenda se organiza. Y nosotros lo mantenemos, mejoramos y actualizamos por 95€ al mes.',
  },
];

const tecnologia = [
  {
    titulo: 'Modelos de lenguaje (LLM)',
    desc: 'Usamos DeepSeek, OpenAI y Anthropic como motores de IA. Tus datos no se usan para entrenar modelos de terceros. Todo bajo RGPD.',
  },
  {
    titulo: 'Automatizaciones (n8n)',
    desc: 'Conectamos tu web, CRM, email, WhatsApp y las herramientas que ya usas mediante workflows automatizados. Si cambias de herramienta, reconfiguramos sin empezar de cero.',
  },
  {
    titulo: 'Infraestructura propia',
    desc: 'Tus agentes corren en servidores dedicados. No compartimos recursos entre clientes. Cada negocio tiene su entorno aislado con sus propios datos, prompts y configuraciones.',
  },
  {
    titulo: 'Mejora continua',
    desc: 'Cada mes revisamos métricas, ajustamos prompts, añadimos capacidades nuevas y optimizamos lo que no funciona. El sistema aprende de cada interacción real con tus clientes.',
  },
];
---

<WebLayout
  title="Como trabajamos · Proceso de 7 dias · ZENKAI"
  description="Te escuchamos 15 minutos, montamos todo en 7 dias y empiezas a vender. Asi de simple. Sin letra pequeña ni proyectos de meses."
  canonical={url}
>
  <PageHero
    migas={[{ label: 'Inicio', href: '/' }, { label: 'Como trabajamos' }]}
    eyebrow="Proceso"
    title="Tu empresa funcionando con IA en 7 dias"
    lede="Sin proyectos de 6 meses. Sin consultoras de 100 paginas. Sin letra pequena.
    Una llamada, una semana, y tu negocio operando con inteligencia artificial."
  />

  <!-- Pasos detallados -->
  <section class="py-20 border-t border-zk-border">
    <div class="max-w-3xl mx-auto px-5">
      <div class="space-y-8">
        {detalleProceso.map((p, i) => (
          <div class="reveal flex gap-6 items-start">
            <div class="w-14 h-14 rounded-xl bg-indigo-500/10 flex items-center justify-center flex-shrink-0">
              <span class="font-mono text-sm font-bold text-indigo-400">{p.paso}</span>
            </div>
            <div>
              <h3 class="text-xl font-bold font-display mb-2">{p.titulo}</h3>
              <p class="text-zk-text2 leading-relaxed">{p.detalle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Los 3 pasos visuales (reutilizado de la home) -->
  <ComoFunciona />

  <!-- Tecnologia -->
  <section class="py-20 border-t border-zk-border">
    <div class="max-w-4xl mx-auto px-5">
      <div class="text-center reveal mb-12">
        <p class="text-xs font-mono text-zk-muted uppercase tracking-widest mb-3">Tecnologia</p>
        <h2 class="text-2xl md:text-3xl font-bold font-display mb-4">Que hay debajo del capo</h2>
        <p class="text-zk-text2 max-w-xl mx-auto">
          No es magia. Es una combinacion de modelos de lenguaje, automatizaciones e infraestructura propia. Asi funciona.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 reveal-stagger">
        {tecnologia.map((t) => (
          <div class="border border-zk-border rounded-xl p-6 bg-zk-card">
            <h3 class="font-bold font-display text-lg mb-2">{t.titulo}</h3>
            <p class="text-sm text-zk-text2 leading-relaxed">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cierre -->
  <section class="py-16 border-t border-zk-border text-center">
    <div class="max-w-xl mx-auto px-5">
      <h2 class="text-xl font-bold font-display mb-3">La primera llamada no cuesta nada</h2>
      <p class="text-zk-text2 mb-6">15 minutos. Sin compromiso. Saldras sabiendo si Zenkai es para ti.</p>
      <WhatsAppCTA
        location="como-trabajamos-cierre"
        message="Hola ZENKAI. Quiero saber mas sobre como trabajais."
        label="Hablar por WhatsApp"
        size="lg"
      />
    </div>
  </section>
</WebLayout>
