---
export const prerender = true;

import WebLayout from '../layouts/WebLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import DiagramaNeural from '../components/landing/DiagramaNeural.astro';

/**
 * /como-trabajamos
 *
 * Aquí vive el sistema multi-agente. Estaba en la home ocupando el tercer
 * bloque, y ahí hacía daño: explica NUESTRA arquitectura a alguien que todavía
 * no sabe qué le vendemos. Es material de confianza para quien ya está
 * evaluando, no de comprensión para quien acaba de llegar.
 */
const site = Astro.site ?? new URL('https://zenkai.systems');
const url = new URL('/como-trabajamos/', site).href;

/**
 * Los tres pasos.
 *
 * Antes cada uno era un párrafo de 40 palabras con el mismo tamaño, color y
 * peso que los otros dos: tres bloques de texto idénticos donde el ojo no
 * tiene dónde agarrarse y acaba sin leer ninguno. Ahora cada tarjeta tiene
 * una descripción de dos líneas y un RESULTADO destacado aparte — el dato
 * concreto que responde "¿y qué me llevo?" sin obligar a leer el párrafo.
 */
const pasos = [
  {
    n: '01',
    titulo: 'Nos cuentas qué te cuesta dinero',
    texto:
      'Por WhatsApp, en tus palabras. Sin formulario de quince campos ni llamada de descubrimiento.',
    resultado: 'Con dos frases sabemos si podemos ayudarte, y te lo decimos.',
    duracion: 'El mismo día',
  },
  {
    n: '02',
    titulo: 'Te enseñamos qué construiríamos',
    texto:
      'Arquitectura concreta: qué agentes, sobre qué herramientas, en qué orden y qué se mide.',
    resultado: 'Si decides hacerlo por tu cuenta, el plan es tuyo igual.',
    duracion: 'En días, no semanas',
  },
  {
    n: '03',
    titulo: 'Lo montamos y lo mantenemos',
    texto:
      'Clonamos la plantilla del módulo sobre tu operación y la ajustamos a tu caso.',
    resultado: 'La mensualidad es que siga funcionando, no el acceso.',
    duracion: 'Puesta en marcha: 5 días',
  },
];

const principios = [
  {
    titulo: 'Construimos sobre lo que ya usas',
    texto:
      'Shopify, HubSpot, Microsoft 365, tu ERP. Migrar de herramienta es un proyecto en sí mismo y casi nunca es lo que necesitas.',
  },
  {
    titulo: 'Infraestructura propia, no reventa de licencias',
    texto:
      'El motor de automatización, la bandeja omnicanal y la base de datos corren en nuestra infraestructura y se amortizan entre todos los clientes. Por eso el precio mensual es el que es.',
  },
  {
    titulo: 'Siempre hay una persona detrás',
    texto:
      'El agente atiende el volumen; las decisiones y lo delicado llegan a un humano con el contexto ya cargado. Vender lo contrario sería vender otra cosa.',
  },
  {
    titulo: 'Sin permanencia obligatoria',
    texto:
      'Puedes irte cuando quieras. Comprometerte más tiempo baja el precio, pero es una elección tuya y no una condición para empezar.',
  },
];
---
<WebLayout
  title="Cómo trabajamos · ZENKAI"
  description="Tres pasos, sin llamadas comerciales. Sistema multi-agente sobre las herramientas que ya usas, con infraestructura propia y una persona siempre detrás."
  canonical={url}
>
  <PageHero
    migas={[{ label: 'Inicio', href: '/' }, { label: 'Cómo trabajamos' }]}
    eyebrow="Cómo trabajamos"
    titulo="Sin llamadas comerciales, sin propuestas de cuarenta páginas"
    lede="Tres pasos. Empiezas escribiendo, no agendando. Y si en el segundo paso decides no seguir, te quedas con el plan igual."
  >
    <WhatsAppCTA
      location="como-trabajamos-hero"
      message="Hola ZENKAI. He visto cómo trabajáis y quiero contaros mi caso."
      size="lg"
    />
  </PageHero>

  <section class="wrap band">
    <h2 class="h2">El proceso</h2>
    <ol class="pasos reveal reveal-stagger">
      {pasos.map((p) => (
        <li class="paso">
          <span class="paso__n">{p.n}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
          <p class="paso__res">{p.resultado}</p>
          <span class="paso__dur">{p.duracion}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap band">
    <h2 class="h2">Cómo lo construimos por dentro</h2>
    <p class="nota">
      Esto es nuestra arquitectura, no un producto que compras. Lo publicamos
      porque a quien está evaluando le importa saber que hay un sistema detrás
      y no una carpeta de automatizaciones sueltas.
    </p>
  </section>

  <DiagramaNeural />

  <section class="wrap band">
    <h2 class="h2">Cuatro cosas que no negociamos</h2>
    <ul class="princ reveal reveal-stagger">
      {principios.map((p) => (
        <li>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap band">
    <div class="cierre">
      <h2>¿Lo probamos con tu caso?</h2>
      <p>Escríbenos qué te está costando dinero. Contesta una persona.</p>
      <WhatsAppCTA
        location="como-trabajamos-cierre"
        message="Hola ZENKAI. Quiero que veamos mi caso concreto."
        size="lg"
      />
    </div>
  </section>
</WebLayout>

<style>
  .wrap { max-width: 68rem; margin: 0 auto; padding-inline: 1.25rem; }
  @media (min-width: 1024px) { .wrap { padding-inline: 2rem; } }
  .band { padding-block: 3.5rem; }
  .band + .band { border-top: 1px solid var(--zk-border); }

  .h2 {
    font-size: var(--t-h2); font-weight: 700; line-height: 1.08;
    letter-spacing: -0.025em; margin: 0 0 1.5rem; max-width: 22ch;
  }
  .nota { font-size: var(--t-card); line-height: 1.6; color: var(--zk-text-2); margin: 0; max-width: 60ch; }

  /* Tarjeta de paso · el orden es fijo en todo el sitio:
     número → título → descripción (2 líneas) → resultado → plazo.
     El número deja de ir en una columna lateral: robaba 2,5 rem de ancho a
     una tarjeta de tres columnas y empujaba la descripción a cinco líneas. */
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 900px) { .pasos { grid-template-columns: repeat(3, 1fr); } }
  .paso {
    display: flex; flex-direction: column;
    padding: 1.75rem;
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 60%),
      var(--zk-surface);
  }
  .paso__n {
    font-family: var(--font-mono); font-size: var(--t-eyebrow);
    letter-spacing: 0.12em; color: var(--zk-growth);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.875rem;
  }
  .paso h3 {
    font-size: 1.0625rem; font-weight: 650; line-height: 1.3;
    letter-spacing: -0.012em; margin: 0 0 0.75rem;
  }
  .paso p { font-size: var(--t-card); line-height: 1.55; color: var(--zk-text-2); margin: 0; }
  /* El resultado se separa del párrafo con una regla, no con negrita: la
     negrita dentro de un bloque de texto se lee como énfasis; una línea
     encima se lee como "esto es otra cosa". */
  .paso__res {
    margin-top: 0.875rem !important;
    padding-top: 0.875rem;
    border-top: 1px solid var(--zk-border);
    color: var(--zk-text) !important;
    font-weight: 550;
  }
  .paso__dur {
    margin-top: auto; padding-top: 1rem;
    font-family: var(--font-mono); font-size: var(--t-eyebrow);
    letter-spacing: 0.08em; color: var(--zk-muted);
    font-variant-numeric: tabular-nums;
  }

  .princ { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 760px) { .princ { grid-template-columns: repeat(2, 1fr); } }
  .princ li {
    padding: 1.75rem;
    border: 1px solid var(--zk-border);
    border-left: 2px solid var(--zk-growth);
    border-radius: var(--zk-r-md);
    background: var(--zk-surface);
  }
  .princ h3 { font-size: 1.0625rem; font-weight: 650; line-height: 1.3; letter-spacing: -0.012em; margin: 0 0 0.625rem; }
  .princ p { font-size: var(--t-card); line-height: 1.55; color: var(--zk-text-2); margin: 0; }

  .cierre { text-align: center; display: grid; justify-items: center; gap: 0.75rem; }
  .cierre h2 {
    font-size: var(--t-h2); font-weight: 700; line-height: 1.08;
    letter-spacing: -0.025em; margin: 0; max-width: 18ch;
  }
  .cierre p { color: var(--zk-text-2); margin: 0 0 0.75rem; font-size: var(--t-body-lg); }
</style>
