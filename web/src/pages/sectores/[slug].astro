---
export const prerender = true;

import WebLayout from '../../layouts/WebLayout.astro';
import PageHero from '../../components/PageHero.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import DomainArt from '../../components/DomainArt.astro';
import { getSectores, getModulosDeSector } from '../../lib/catalogo';

export async function getStaticPaths() {
  const sectores = await getSectores();
  return Promise.all(
    sectores.map(async (s) => ({
      params: { slug: s.data.slug },
      props: { sector: s, modulos: await getModulosDeSector(s) },
    })),
  );
}

const { sector, modulos } = Astro.props;
const d = sector.data;
const site = Astro.site ?? new URL('https://zenkai.systems');
const url = new URL(`/sectores/${d.slug}/`, site).href;

// copy_largo viene con \n\n como separador de párrafo desde el frontmatter.
const parrafos = d.copy_largo.split('\n\n').filter(Boolean);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Sectores', item: new URL('/sectores/', site).href },
    { '@type': 'ListItem', position: 3, name: d.nombre, item: url },
  ],
};
---
<WebLayout title={d.seo.title} description={d.seo.description} canonical={url}>
  <div data-dominio="growth">
    <PageHero
      migas={[
        { label: 'Inicio', href: '/' },
        { label: 'Sectores', href: '/sectores/' },
        { label: d.nombre },
      ]}
      eyebrow={d.nombre}
      titulo={d.titular}
      lede={d.copy_corto}
    >
      <WhatsAppCTA
        location={`sector-${d.slug}`}
        context={d.nombre}
        message={d.ctaWhatsapp}
        size="lg"
      />
      <DomainArt slot="aside" variant={d.prioridad + 3} />
    </PageHero>

    <section class="wrap band">
      <h2 class="h2">Si esto te suena, es esto</h2>
      <ul class="sintomas reveal reveal-stagger">
        {d.sintomas.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <section class="wrap band">
      <h2 class="h2">Qué montamos</h2>
      <div class="prosa">
        {parrafos.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="wrap band">
      <h2 class="h2">Los módulos que más se usan aquí</h2>
      <ul class="grid reveal reveal-stagger">
        {modulos.map((m) => (
          <li>
            <a href={`/modulos/${m.id}/`} class="card" data-dominio={m.data.dominio}>
              <div class="card__art"><DomainArt variant={m.data.orden} /></div>
              <h3>{m.data.nombre}</h3>
              <p>{m.data.titular}</p>
              <span class="card__mas">Ver módulo →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap band">
      <div class="cierre">
        <h2>¿Se parece a tu caso?</h2>
        <p>Cuéntanoslo en dos frases. Contesta una persona, y si no encaja te lo decimos.</p>
        <WhatsAppCTA
          location={`sector-${d.slug}-cierre`}
          context={d.nombre}
          message={d.ctaWhatsapp}
          size="lg"
        />
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</WebLayout>

<style>
  .wrap { max-width: 68rem; margin: 0 auto; padding-inline: 1.25rem; }
  @media (min-width: 1024px) { .wrap { padding-inline: 2rem; } }
  .band { padding-block: 3.5rem; }
  .band + .band { border-top: 1px solid var(--zk-border); }

  .h2 {
    font-size: var(--t-h2); font-weight: 700; line-height: 1.08;
    letter-spacing: -0.025em; margin: 0 0 1.5rem; max-width: 22ch;
  }

  .sintomas { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  @media (min-width: 760px) { .sintomas { grid-template-columns: repeat(2, 1fr); } }
  .sintomas li {
    position: relative;
    padding: 1rem 1.125rem 1rem 2.25rem;
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-md);
    background: var(--zk-surface);
    font-size: var(--t-card); line-height: 1.5; color: var(--zk-text-2);
  }
  .sintomas li::before {
    content: '';
    position: absolute; left: 1rem; top: 1.35rem;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--zk-accent);
  }

  .prosa { max-width: 64ch; }
  .prosa p {
    font-size: 1rem; line-height: 1.7; color: var(--zk-text-2);
    margin: 0 0 1.125rem; text-wrap: pretty;
  }
  .prosa p:first-child { color: var(--zk-text); font-size: 1.0625rem; }
  .prosa p:last-child { margin-bottom: 0; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(4, 1fr); } }

  .card {
    display: flex; flex-direction: column; height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 60%),
      var(--zk-surface);
    text-decoration: none; color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--zk-accent) 45%, transparent);
    transform: translateY(-2px);
  }
  .card:focus-visible { outline: 2px solid var(--zk-accent); outline-offset: 3px; }
  .card__art { width: 44px; height: 44px; margin-bottom: 1rem; }
  .card h3 { font-size: var(--t-card); font-weight: 650; letter-spacing: -0.01em; margin: 0 0 0.5rem; color: var(--zk-accent); }
  .card p { font-size: var(--t-micro); line-height: 1.5; color: var(--zk-text-2); margin: 0 0 1.25rem; flex: 1; }
  .card__mas { font-size: var(--t-micro); font-weight: 550; color: var(--zk-accent); }
  .card:hover .card__mas { text-decoration: underline; }

  .cierre { text-align: center; display: grid; justify-items: center; gap: 0.75rem; }
  .cierre h2 {
    font-size: var(--t-h2); font-weight: 700; line-height: 1.08;
    letter-spacing: -0.025em; margin: 0; max-width: 18ch;
  }
  .cierre p { color: var(--zk-text-2); margin: 0 0 0.75rem; max-width: 48ch; }

  @media (prefers-reduced-motion: reduce) { .card:hover { transform: none; } }
</style>
