---
export const prerender = true;
import WebLayout from '../layouts/WebLayout.astro';
import NeuralHero from '../components/landing/NeuralHero.astro';
import ProblemSelector from '../components/landing/ProblemSelector.astro';
import TrustStack from '../components/landing/TrustStack.astro';
import ComoFunciona from '../components/landing/ComoFunciona.astro';
import PlanZenkai from '../components/landing/PlanZenkai.astro';
import LeadCapture from '../components/landing/LeadCapture.astro';
import SalesSimulator from '../components/landing/SalesSimulator.astro';
import ROICalculator from '../components/landing/ROICalculator.astro';
import Confianza from '../components/landing/Confianza.astro';
import Ecosistema from '../components/landing/Ecosistema.astro';
import FAQ from '../components/landing/FAQ.astro';
import CTAFinal from '../components/landing/CTAFinal.astro';
import StickyBar from '../components/landing/StickyBar.astro';
import ChatWidget from '../components/landing/ChatWidget.astro';
import CursorSpotlight from '../components/landing/CursorSpotlight.astro';

/**
 * ZENKAI — AI Growth Systems
 *
 * Estructura enterprise:
 *  1 NeuralHero      — Sistema neuronal vivo. Identidad visual de la marca.
 *  2 ProblemSelector — Diagnostico interactivo: "Que frena tu crecimiento?"
 *  3 TrustStack      — Arquitectura del sistema: no son herramientas, es infraestructura.
 *  4 Como funciona   — 3 pasos, elimina friccion.
 *  5 Plan Zenkai     — El plan unico con precio transparente.
 *  6 LeadCapture     — Captura leads que no estan listos para comprar.
 *  7 SalesSimulator  — Demo interactiva del agente de ventas.
 *  8 ROI Calculator  — Cuanto pierdes sin automatizar.
 *  9 Confianza       — Testimonios + garantias reales.
 * 10 Ecosistema      — Los 5 productos integrados.
 * 11 FAQ             — Ultimas objeciones.
 * 12 CTA Final       — WhatsApp + email.
 *
 * Capa flotante: ChatWidget (asistente IA), CursorSpotlight (luz ambiental).
 */
---

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '¿Cuánto cuesta ZENKAI?', acceptedAnswer: { '@type': 'Answer', text: '500€ de implementación única + 95€ al mes de mantenimiento. Sin costes ocultos. Sin permanencia.' } },
    { '@type': 'Question', name: '¿Qué incluye?', acceptedAnswer: { '@type': 'Answer', text: 'Web profesional, CRM, agente de ventas IA, atención al cliente 24/7, facturación, agenda automatizada, diagnóstico de marketing y diagnóstico empresarial.' } },
    { '@type': 'Question', name: '¿Cuánto tarda en estar funcionando?', acceptedAnswer: { '@type': 'Answer', text: '7 días laborables desde que nos das acceso a los datos de tu negocio.' } },
    { '@type': 'Question', name: '¿Hay garantía?', acceptedAnswer: { '@type': 'Answer', text: '14 días de prueba. Si no ves resultados, te devolvemos los 500€ de implementación.' } },
    { '@type': 'Question', name: '¿Qué tipo de empresas pueden usarlo?', acceptedAnswer: { '@type': 'Answer', text: 'Clínicas, restaurantes, ecommerce, inmobiliarias, agencias, servicios profesionales. Cualquier empresa que venda, atienda clientes y tenga operaciones.' } },
  ],
})} />

<WebLayout
  title="ZENKAI · AI Growth Systems · Infraestructura de IA empresarial"
  description="ZENKAI es infraestructura de inteligencia artificial para empresas. Conecta ventas, atencion y operaciones. 500€ implementacion + 95€/mes."
>
  <CursorSpotlight />
  <NeuralHero />
  <ProblemSelector />
  <TrustStack />
  <ComoFunciona />
  <PlanZenkai />
  <LeadCapture />
  <SalesSimulator />
  <ROICalculator />
  <Confianza />
  <Ecosistema />
  <FAQ />
  <CTAFinal />
  <StickyBar />
  <ChatWidget />
</WebLayout>
