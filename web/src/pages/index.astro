---
export const prerender = true;
import WebLayout from '../layouts/WebLayout.astro';
import CoreHero from '../components/landing/CoreHero.astro';
import AIActivityFeed from '../components/landing/AIActivityFeed.astro';
import ProblemSelector from '../components/landing/ProblemSelector.astro';
import TrustStack from '../components/landing/TrustStack.astro';
import WorkflowViz from '../components/landing/WorkflowViz.astro';
import SalesSimulator from '../components/landing/SalesSimulator.astro';
import ROICalculator from '../components/landing/ROICalculator.astro';
import PricingTiers from '../components/landing/PricingTiers.astro';
import LeadCapture from '../components/landing/LeadCapture.astro';
import IndustryGrid from '../components/landing/IndustryGrid.astro';
import IntegrationCloud from '../components/landing/IntegrationCloud.astro';
import Confianza from '../components/landing/Confianza.astro';
import FAQ from '../components/landing/FAQ.astro';
import StickyBar from '../components/landing/StickyBar.astro';
import ChatWidget from '../components/landing/ChatWidget.astro';
import CursorSpotlight from '../components/landing/CursorSpotlight.astro';
import FinalCTA from '../components/landing/FinalCTA.astro';
import SolutionExplorer from '../components/landing/SolutionExplorer.astro';
import ScrollProgress from '../components/landing/ScrollProgress.astro';

/**
 * ZENKAI — AI Business Infrastructure
 *
 *  1 CoreHero          — "Your business, powered by AI."
 *  2 AIActivityFeed    — Consola de actividad de agentes.
 *  3 ProblemSelector   — "What's slowing your business down?"
 *  4 TrustStack        — Arquitectura del sistema.
 *  5 WorkflowViz       — Visualizaciones de pipelines.
 *  6 SalesSimulator    — Experience ZENKAI demo.
 *  7 ROI Calculator    — Business impact.
 *  8 PricingTiers      — Starter/Growth/Scale/Enterprise.
 *  9 LeadCapture       — AI Opportunity Report.
 * 10 IndustryGrid      — Sector-specific solutions.
 * 11 IntegrationCloud  — Connected ecosystem.
 * 12 Confianza         — Case studies + trust.
 * 13 FAQ + CTA Final
 */
---

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ZENKAI',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://zenkai.systems',
  description: 'Infraestructura de IA empresarial que conecta ventas, atencion al cliente y operaciones en un solo sistema inteligente.',
  offers: [
    { '@type': 'Offer', name: 'Starter', price: '95', priceCurrency: 'EUR', description: 'Para pequenas empresas listas para automatizar' },
    { '@type': 'Offer', name: 'Growth', price: '440', priceCurrency: 'EUR', description: '4 agentes de IA, 2 campanas publicitarias al mes incluidas, 12 piezas de contenido premium para redes sociales' },
  ],
  featureList: ['Agentes de IA', 'Automatizacion', 'Integracion CRM', 'Integracion WhatsApp', 'Analitica', 'Automatizacion de Workflows', 'Atencion al Cliente con IA', 'Ventas con IA'],
})} />

<WebLayout
  title="ZENKAI · Infraestructura de IA Empresarial · Tu empresa, impulsada por IA"
  description="ZENKAI conecta ventas, atencion al cliente y operaciones en un solo sistema inteligente. Agentes de IA, Automatizacion, Integraciones, Analitica. Para empresas modernas."
>
  <ScrollProgress />
  <CursorSpotlight />
  <CoreHero />
  <AIActivityFeed />
  <ProblemSelector />
  <TrustStack />
  <SolutionExplorer />
  <WorkflowViz />
  <SalesSimulator />
  <ROICalculator />
  <PricingTiers />
  <LeadCapture />
  <IndustryGrid />
  <IntegrationCloud />
  <Confianza />
  <FAQ />
  <FinalCTA />
  <StickyBar />
  <ChatWidget />
</WebLayout>
