>
  <HeroDemo />
  <Proyeccion90Dias />
  <StatsReales />
  <ComoFunciona />
  <DiagramaNeural />
  <Comparativa />
  <Sectores />
  <Planes />
  <VentajasTecnicas />
  <FAQ />
  <CTAFinal />
  {/* Footer + WhatsAppFloat vienen del WebLayout */}
</WebLayout>
