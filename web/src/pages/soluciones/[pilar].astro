---
export const prerender = true;

import WebLayout from '../../layouts/WebLayout.astro';
import PageHero from '../../components/PageHero.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import DomainArt from '../../components/DomainArt.astro';
import { PILARES, getModulosPorPilar, getModuloMedida } from '../../lib/catalogo';

export async function getStaticPaths() {
  return Promise.all(
    PILARES.map(async (p) => ({
      params: { pilar: p.id },
      props: {
        pilar: p,
        modulos: await getModulosPorPilar(p.id),
        medida: await getModuloMedida(),
      },
    })),
  );
}

const { pilar, modulos, medida } = Astro.props;
const site = Astro.site ?? new URL('https://zenkai.systems');
const url = new URL(`/soluciones/${pilar.id}/`, site).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.href },
    { '@type': 'ListItem', position: 2, name: pilar.nombre, item: url },
  ],
};
---
<WebLayout
  title={`${pilar.titular} · ZENKAI`}
  description={pilar.promesa}
  canonical={url}
>
  <div data-dominio={pilar.dominio}>
    <PageHero
      migas={[{ label: 'Inicio', href: '/' }, { label: pilar.nombre }]}
      eyebrow={pilar.nombre}
      titulo={pilar.titular}
      lede={pilar.promesa}
    >
      <WhatsAppCTA
        location={`pilar-${pilar.id}`}
        context={pilar.nombre}
        message={`Hola ZENKAI. Me interesa lo de ${pilar.nombre.toLowerCase()} y quiero contaros mi caso.`}
        size="lg"
      />
    </PageHero>

    <section class="wrap band">
      <h2 class="h2">{modulos.length} {modulos.length === 1 ? 'módulo' : 'módulos'} en este pilar</h2>
      <ul class="grid reveal reveal-stagger">
        {modulos.map((m) => (
          <li>
            <a href={`/modulos/${m.id}/`} class="card" data-dominio={m.data.dominio}>
              <div class="card__art"><DomainArt variant={m.data.orden} /></div>
              <h3>{m.data.nombre}</h3>
              <p class="card__titular">{m.data.titular}</p>
              <p class="card__promesa">{m.data.promesa}</p>
              <span class="card__mas">Ver módulo →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {medida && (
      <section class="wrap band">
        <a href={`/modulos/${medida.id}/`} class="medida" data-dominio={medida.data.dominio}>
          <div>
            <p class="eyebrow">A medida</p>
            <h2>{medida.data.nombre}</h2>
            <p>{medida.data.promesa}</p>
          </div>
          <span class="card__mas">Ver módulo →</span>
        </a>
      </section>
    )}

    <section class="wrap band">
      <div class="cierre">
        <h2>¿No sabes cuál te toca?</h2>
        <p>Escríbenos en una frase qué te está costando dinero. Te decimos por dónde se empieza.</p>
        <WhatsAppCTA
          location={`pilar-${pilar.id}-cierre`}
          context={pilar.nombre}
          message="Hola ZENKAI. No tengo claro qué módulo necesito, os cuento mi caso."
          size="lg"
        />
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</WebLayout>

<style>
  .wrap { max-width: 68rem; margin: 0 auto; padding-inline: 1.25rem; }
  @media (min-width: 1024px) { .wrap { padding-inline: 2rem; } }
  .band { padding-block: 3.5rem; }
  .band + .band { border-top: 1px solid var(--zk-border); }

  /* La cabecera vive en PageHero.astro · aquí ya no hay migas, eyebrow ni H1
     que mantener sincronizados con las otras cinco rutas internas. */
  .eyebrow {
    font-family: var(--font-mono); font-size: var(--t-eyebrow);
    font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--zk-accent); margin: 0 0 1rem;
  }
  .h2 {
    font-size: var(--t-h2); font-weight: 700; line-height: 1.08;
    letter-spacing: -0.025em; margin: 0 0 1.75rem; max-width: 22ch;
  }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .card {
    display: flex; flex-direction: column; height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 60%),
      var(--zk-surface);
    text-decoration: none; color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--zk-accent) 45%, transparent);
    transform: translateY(-2px);
  }
  .card:focus-visible { outline: 2px solid var(--zk-accent); outline-offset: 3px; }
  .card__art { width: 56px; height: 56px; margin-bottom: 1.125rem; }
  .card h3 { font-size: 1.0625rem; font-weight: 650; letter-spacing: -0.012em; margin: 0 0 0.5rem; }
  .card__titular { font-size: var(--t-card); line-height: 1.45; color: var(--zk-text); margin: 0 0 0.625rem; }
  /* Subida de 13 a 14px: es la descripción que decide el clic, no un adorno.
     El suelo de 14px vale para todo lo que haya que leer. */
  .card__promesa { font-size: var(--t-micro); line-height: 1.5; color: var(--zk-text-2); margin: 0 0 1.5rem; flex: 1; }
  /* "Ver módulo" deja de ser mono. Es una frase, no un dato: en monoespaciada
     a 12px se lee peor y encima compite con los eyebrows, que sí son datos. */
  .card__mas {
    font-size: var(--t-micro); font-weight: 550;
    color: var(--zk-accent);
  }
  .card:hover .card__mas { text-decoration: underline; }

  .medida {
    display: flex; flex-wrap: wrap; gap: 1.5rem;
    align-items: end; justify-content: space-between;
    padding: 2rem;
    border: 1px solid color-mix(in srgb, var(--zk-accent) 35%, transparent);
    border-radius: var(--zk-r-lg);
    background: linear-gradient(135deg, color-mix(in srgb, var(--zk-accent) 12%, transparent), transparent 70%);
    text-decoration: none; color: inherit;
    transition: border-color 0.2s;
  }
  .medida:hover { border-color: var(--zk-accent); }
  .medida h2 { font-size: var(--t-h3); font-weight: 700; margin: 0 0 0.5rem; }
  .medida p { color: var(--zk-text-2); margin: 0; max-width: 48ch; font-size: var(--t-card); }

  .cierre { text-align: center; display: grid; justify-items: center; gap: 0.75rem; }
  .cierre h2 {
    font-size: var(--t-h2); font-weight: 700; line-height: 1.08;
    letter-spacing: -0.025em; margin: 0; max-width: 18ch;
  }
  .cierre p { color: var(--zk-text-2); margin: 0 0 0.75rem; max-width: 46ch; font-size: var(--t-body-lg); }

  @media (prefers-reduced-motion: reduce) { .card:hover { transform: none; } }
</style>
