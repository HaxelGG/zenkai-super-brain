---
export const prerender = true;

import WebLayout from '../../layouts/WebLayout.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import DomainArt from '../../components/DomainArt.astro';
import { PILARES, getModulosPorPilar, getModuloMedida } from '../../lib/catalogo';

export async function getStaticPaths() {
  return Promise.all(
    PILARES.map(async (p) => ({
      params: { pilar: p.id },
      props: {
        pilar: p,
        modulos: await getModulosPorPilar(p.id),
        medida: await getModuloMedida(),
      },
    })),
  );
}

const { pilar, modulos, medida } = Astro.props;
const site = Astro.site ?? new URL('https://zenkai.systems');
const url = new URL(`/soluciones/${pilar.id}/`, site).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.href },
    { '@type': 'ListItem', position: 2, name: pilar.nombre, item: url },
  ],
};
---
<WebLayout
  title={`${pilar.titular} · ZENKAI`}
  description={pilar.promesa}
  canonical={url}
>
  <div data-dominio={pilar.dominio}>
    <header class="wrap hero">
      <nav class="crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="crumbs__actual">{pilar.nombre}</span>
      </nav>
      <p class="eyebrow">{pilar.nombre}</p>
      <h1>{pilar.titular}</h1>
      <p class="lede">{pilar.promesa}</p>
      <div class="hero__cta">
        <WhatsAppCTA
          location={`pilar-${pilar.id}`}
          context={pilar.nombre}
          message={`Hola ZENKAI. Me interesa lo de ${pilar.nombre.toLowerCase()} y quiero contaros mi caso.`}
          size="lg"
        />
      </div>
    </header>

    <section class="wrap band">
      <h2 class="h2">{modulos.length} {modulos.length === 1 ? 'módulo' : 'módulos'} en este pilar</h2>
      <ul class="grid">
        {modulos.map((m) => (
          <li>
            <a href={`/modulos/${m.id}/`} class="card" data-dominio={m.data.dominio}>
              <div class="card__art"><DomainArt variant={m.data.orden} /></div>
              <h3>{m.data.nombre}</h3>
              <p class="card__titular">{m.data.titular}</p>
              <p class="card__promesa">{m.data.promesa}</p>
              <span class="card__mas">Ver módulo →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {medida && (
      <section class="wrap band">
        <a href={`/modulos/${medida.id}/`} class="medida" data-dominio={medida.data.dominio}>
          <div>
            <p class="eyebrow">A medida</p>
            <h2>{medida.data.nombre}</h2>
            <p>{medida.data.promesa}</p>
          </div>
          <span class="card__mas">Ver módulo →</span>
        </a>
      </section>
    )}

    <section class="wrap band">
      <div class="cierre">
        <h2>¿No sabes cuál te toca?</h2>
        <p>Escríbenos en una frase qué te está costando dinero. Te decimos por dónde se empieza.</p>
        <WhatsAppCTA
          location={`pilar-${pilar.id}-cierre`}
          context={pilar.nombre}
          message="Hola ZENKAI. No tengo claro qué módulo necesito, os cuento mi caso."
          size="lg"
        />
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</WebLayout>

<style>
  .wrap { max-width: 68rem; margin: 0 auto; padding-inline: 1.25rem; }
  @media (min-width: 1024px) { .wrap { padding-inline: 2rem; } }
  .band { padding-block: 3.5rem; }
  .band + .band { border-top: 1px solid var(--zk-border); }
  .hero { padding-block: 5rem 2rem; }

  .crumbs {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--zk-muted); margin-bottom: 2rem;
  }
  .crumbs a { color: var(--zk-text-2); text-decoration: none; }
  .crumbs a:hover { color: var(--zk-text); }
  .crumbs__actual { color: var(--zk-accent); }

  .eyebrow {
    font-family: var(--font-mono); font-size: 0.6875rem;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--zk-accent); margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    line-height: 1.05; letter-spacing: -0.02em; font-weight: 700;
    margin: 0 0 1.25rem; max-width: 18ch; text-wrap: balance;
  }
  .lede { font-size: 1.1875rem; color: var(--zk-text-2); margin: 0; max-width: 52ch; }
  .hero__cta { margin-top: 2rem; }

  .h2 { font-size: 1.5rem; font-weight: 700; margin: 0 0 1.75rem; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .card {
    display: flex; flex-direction: column; height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--zk-border);
    border-radius: var(--zk-r-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 60%),
      var(--zk-surface);
    text-decoration: none; color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--zk-accent) 45%, transparent);
    transform: translateY(-2px);
  }
  .card:focus-visible { outline: 2px solid var(--zk-accent); outline-offset: 3px; }
  .card__art { width: 56px; height: 56px; margin-bottom: 1rem; }
  .card h3 { font-size: 1.0625rem; font-weight: 700; margin: 0 0 0.375rem; }
  .card__titular { font-size: 0.9375rem; color: var(--zk-text); margin: 0 0 0.5rem; }
  .card__promesa { font-size: 0.8125rem; line-height: 1.5; color: var(--zk-text-2); margin: 0 0 1.25rem; flex: 1; }
  .card__mas {
    font-family: var(--font-mono); font-size: 0.75rem;
    letter-spacing: 0.08em; color: var(--zk-accent);
  }

  .medida {
    display: flex; flex-wrap: wrap; gap: 1.5rem;
    align-items: end; justify-content: space-between;
    padding: 2rem;
    border: 1px solid color-mix(in srgb, var(--zk-accent) 35%, transparent);
    border-radius: var(--zk-r-lg);
    background: linear-gradient(135deg, color-mix(in srgb, var(--zk-accent) 12%, transparent), transparent 70%);
    text-decoration: none; color: inherit;
    transition: border-color 0.2s;
  }
  .medida:hover { border-color: var(--zk-accent); }
  .medida h2 { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.5rem; }
  .medida p { color: var(--zk-text-2); margin: 0; max-width: 48ch; }

  .cierre { text-align: center; display: grid; justify-items: center; gap: 0.75rem; }
  .cierre h2 { font-size: 1.75rem; font-weight: 700; margin: 0; }
  .cierre p { color: var(--zk-text-2); margin: 0 0 0.75rem; max-width: 46ch; }

  @media (prefers-reduced-motion: reduce) { .card:hover { transform: none; } }
</style>
